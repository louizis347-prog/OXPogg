 band","faixa de nota"],["selection board","selection board"],["competency question","competency question"],["thank-you email","thank-you email"],["passage question","passage question"],["candidate rapport","candidate rapport"],["interview anxiety","interview anxiety"],["recruiter feedback","recruiter feedback"],["hiring decision","hiring decision"],["interview debrief","interview debrief"],["skills example","skills example"]]}]},{"tag":"Leitura","title":"Reading · A job interview","blocks":[{"type":"iv","intro":"A hiring manager talks about interviews.","qa":[["Interviewer: What do you look for in a candidate?","**Even though** skills matter, attitude matters more. I look for people **who** learn quickly and **who** admit mistakes."],["Interviewer: Any advice for nervous candidates?","Prepare examples **that** show results. **Remember to** listen carefully, and **remember to** ask a question at the end."]],"gloss":[["attitude","atitude"],["admit","admitir"],["nervous","nervoso"],["result","resultado"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The manager says skills matter more than attitude.","ans":"F","why":"attitude matters more."},{"q":"Candidates should prepare examples.","ans":"T","why":"examples that show results."},{"q":"Candidates should avoid asking questions.","ans":"F","why":"ask a question."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“admit” = ?","opts":["admitir","admirar","adaptar"],"ans":0,"why":"admit mistakes."},{"q":"“nervous” = ?","opts":["nervoso","nervura","nobre"],"ans":0,"why":"nervous."}]}]},{"tag":"Gramática","title":"Perguntas de detalhe e intenção","blocks":[{"type":"table","head":["Tipo","Estratégia"],"rows":[["detalhe","Ache a **palavra-chave** da pergunta no texto"],["intenção","Pergunte: **por que** o autor disse isso?"],["verdadeiro/falso/não informado","Compare com o texto **sem usar opinião própria**"],["paráfrase","A resposta usa **sinônimos**, não as mesmas palavras"]],"cap":"Perguntas de detalhe e intenção"},{"type":"box","kind":"look","t":"Regra","body":"Em IELTS Reading, as alternativas erradas costumam usar **as mesmas palavras do texto** com sentido diferente."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Look for the ___ in the question. (keyword)","a":"keyword","why":"estratégia."},{"s":"Answers use ___ , not the same words. (synonyms)","a":"synonyms","why":"paráfrase."},{"s":"Prepare examples that show ___ . (results)","a":"results","why":"texto."},{"s":"Remember ___ ask a question. (to)","a":"to","why":"remember to."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["hiring manager","gerente de contratação"],["job interview","entrevista de emprego"],["candidate profile","perfil do candidato"],["strong attitude","atitude forte"],["quick learner","quem aprende rápido"]]},{"type":"order","title":"Put the words in order","items":[{"words":["the","manager","look","for","What","does"],"ans":"What does the manager look for","pt":"O que o gerente procura?"},{"words":["the","text","Where","is","the","proof","in"],"ans":"Where is the proof in the text","pt":"Onde está a prova no texto?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"strong attitude","pos":"word","pt":"atitude forte","ex":"Strong attitude.","expt":"Atitude forte."},{"w":"quick learner","pos":"word","pt":"quem aprende rápido","ex":"Quick learner.","expt":"Quem aprende rápido."},{"w":"admit a mistake","pos":"word","pt":"admitir um erro","ex":"Admit a mistake.","expt":"Admitir um erro."},{"w":"prepared example","pos":"word","pt":"exemplo preparado","ex":"Prepared example.","expt":"Exemplo preparado."},{"w":"closing question","pos":"word","pt":"pergunta final","ex":"Closing question.","expt":"Pergunta final."},{"w":"reference check","pos":"word","pt":"checagem de referências","ex":"Reference check."