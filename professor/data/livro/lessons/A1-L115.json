k chat","lines":[["Leo","Do you like walking?","Gosta de caminhar?"],["Ana","Yes, but I don’t like running.","Sim, mas não gosto de correr."],["Leo","Why?","Por quê?"],["Ana","Because it makes me tired.","Porque me cansa."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"ship/sheep","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"bed/bad","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"think/this","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"/h/ de house","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"r americano","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say what you like and hate doing.","pt":"Diga.","model":"I like walking, but I hate running."},{"q":"Say what you want to do.","pt":"Diga.","model":"I want to go to the lake."},{"q":"Explain with because.","pt":"Diga.","model":"I stay home because it rains."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences about your weekend.","model":"I like walking, but I don’t like running. I want to go to the lake because it is quiet. I need to bring a flashlight. Do you want to come? Turn left at the bank.","checklist":["Usei **like + -ing**","Usei **want to**","Usei **conjunções**"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Spaced practice · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “stage” mean?","opts":["palco","doce","ótimo"],"ans":0,"why":"**stage** = palco."},{"q":"What does “sweet” mean?","opts":["nadar","doce","esquerda"],"ans":1,"why":"**sweet** = doce."},{"q":"What does “swim” mean?","opts":["ótimo","palco","nadar"],"ans":2,"why":"**swim** = nadar."},{"q":"What does “great” mean?","opts":["ótimo","esquerda","doce"],"ans":0,"why":"**great** = ótimo."},{"q":"What does “left” mean?","opts":["palco","esquerda","nadar"],"ans":1,"why":"**left** = esquerda."}]},{"type":"box","kind":"exam","t":"Plano de revisão espaçada","body":["**Hoje:** refaça os quadros 6 e 7.","**Em 3 dias:** diga as frases do quadro 10 sem olhar.","**Em 7 dias:** escreva de memória o texto do quadro 11."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Faça uma revisão em estações.","Anote os erros mais comuns.","Use como diagnóstico."]}]}]}