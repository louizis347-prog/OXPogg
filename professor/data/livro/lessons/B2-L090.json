e","blocks":[{"type":"dialog","title":"Practice","lines":[["Ana","What can we infer about officials?","O que podemos inferir sobre as autoridades?"],["Leo","They didn’t like her work.","Não gostavam do trabalho dela."],["Ana","How do we know?","Como sabemos?"],["Leo","They objected to it.","Elas se opuseram a ele."]]},{"type":"pron","title":"Pronúncia: Flap T americano","items":[{"label":"Flap T americano","note":"Pratique em voz alta.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Make an inference.","pt":"Infira.","model":"The text suggests she was determined."},{"q":"Give evidence.","pt":"Dê prova.","model":"She insisted on continuing."},{"q":"Explain purpose.","pt":"Explique.","model":"The author wants to inspire."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 3 inference answers with evidence.","model":"1. Officials disliked her work: “objected to her work”. 2. She was determined: “insisted on continuing”. 3. The movement helped the environment and women: “plant trees to fight erosion and poverty”.","checklist":["Dei **inferência + evidência**","3 respostas"],"words":"3 respostas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “kenyan activist” mean?","opts":["ativista queniana","cinturão verde","erosão do solo"],"ans":0,"why":"**kenyan activist** = ativista queniana."},{"q":"What does “green belt” mean?","opts":["plantio de árvores","cinturão verde","pobreza rural"],"ans":1,"why":"**green belt** = cinturão verde."},{"q":"What does “tree planting” mean?","opts":["erosão do solo","grupo de mulheres","plantio de árvores"],"ans":2,"why":"**tree planting** = plantio de árvores."},{"q":"What does “soil erosion” mean?","opts":["erosão do solo","pobreza rural","prêmio da paz"],"ans":0,"why":"**soil erosion** = erosão do solo."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["TOEFL/IELTS: perguntas de inferência pedem uma conclusão apoiada pelo texto.","Procure palavras de atitude (objected, insisted).","Elimine alternativas que contradizem o texto."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}