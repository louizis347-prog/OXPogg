eralmente."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"An inference is ___ by the text but not stated. (supported)","a":"supported","why":"estratégia."},{"s":"She encouraged women to ___ trees. (plant)","a":"plant","why":"verbo."},{"s":"She insisted ___ continuing. (on)","a":"on","why":"insist on."},{"s":"She might have ___ discouraged. (be, part.)","a":"been","why":"might have."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["kenyan activist","ativista queniana"],["green belt","cinturão verde"],["tree planting","plantio de árvores"],["soil erosion","erosão do solo"],["rural poverty","pobreza rural"]]},{"type":"order","title":"Put the words in order","items":[{"words":["do","we","know","How"],"ans":"How do we know","pt":"Como sabemos?"},{"words":["to","it","They","objected"],"ans":"They objected to it","pt":"Elas se opuseram a ele."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"kenyan activist","pos":"word","pt":"ativista queniana","ex":"Kenyan activist.","expt":"Ativista queniana."},{"w":"green belt","pos":"word","pt":"cinturão verde","ex":"Green belt.","expt":"Cinturão verde."},{"w":"tree planting","pos":"word","pt":"plantio de árvores","ex":"Tree planting.","expt":"Plantio de árvores."},{"w":"soil erosion","pos":"word","pt":"erosão do solo","ex":"Soil erosion.","expt":"Erosão do solo."},{"w":"rural poverty","pos":"word","pt":"pobreza rural","ex":"Rural poverty.","expt":"Pobreza rural."},{"w":"women’s group","pos":"word","pt":"grupo de mulheres","ex":"Women’s group.","expt":"Grupo de mulheres."},{"w":"forest loss","pos":"word","pt":"perda florestal","ex":"Forest loss.","expt":"Perda florestal."},{"w":"reforestation","pos":"word","pt":"reflorestamento","ex":"Reforestation.","expt":"Reflorestamento."},{"w":"grassroots effort","pos":"word","pt":"esforço de base","ex":"Grassroots effort.","expt":"Esforço de base."},