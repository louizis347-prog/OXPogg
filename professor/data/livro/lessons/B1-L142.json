ture city","cidade do futuro"],["map of the city","mapa da cidade"]]}]},{"tag":"Leitura","title":"Reading · A lecture transcript","blocks":[{"type":"text","title":"Lecture: How Cities Were Built","paras":["Good morning. Ancient cities **were planned** around rivers. Streets **were built** in straight lines, and markets **were located** near gates. Today, new districts **are being explored** by planners.","Cities **have been changed** by trains and cars. In the future, they **will be designed** for people on foot."],"kicker":"LECTURE","by":"Prof. Moura","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Ancient cities were planned around rivers.","ans":"T","why":"around rivers."},{"q":"Markets were located far from gates.","ans":"F","why":"near gates."},{"q":"Cities will be designed for pedestrians.","ans":"T","why":"people on foot."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“gate” = ?","opts":["portão","garra","jarra"],"ans":0,"why":"gate."},{"q":"“pedestrian” = ?","opts":["pedestre","pedestal","peixe"],"ans":0,"why":"pedestrian."}]}]},{"tag":"Gramática","title":"Passiva em vários tempos","blocks":[{"type":"table","head":["Tempo","Estrutura","Exemplo"],"rows":[["presente","am/is/are + part.","**Streets are built.**"],["passado","was/were + part.","**Cities were planned.**"],["perfeito","has/have been + part.","**Cities have been changed.**"],["futuro","will be + part.","**They will be designed.**"]],"cap":"Passiva em vários tempos"},{"type":"box","kind":"look","t":"Regra","body":"A passiva usa **be + particípio**; só o verbo **be** muda de tempo."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Ancient cities ___ planned around rivers. (be, past)","a":"were","why":"passado."},{"s":"Cities have ___ changed. (be, part.)","a":"been","why":"perfeito."},{"s":"They will ___ designed for people. (be)","a":"be","why":"futuro."},{"s":"Streets are ___ in lines. (build, part.)","a":"built","why":"particípio."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["ancient city","cidade antiga"],["river bank","margem do rio"],["city gate","portão da cidade"],["straight street","rua reta"],["market square","praça do mercado"]]},{"type":"order","title":"Put the words in order","items":[{"words":["in","the","future","And"],"ans":"And in the future","pt":"E no futuro?"},{"words":["planned","How","were","ancient","cities"],"ans":"How were ancient cities planned","pt":"Como eram planejadas as cidades antigas?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"ancient city","pos":"word","pt":"cidade antiga","ex":"Ancient city.","expt":"Cidade antiga."},{"w":"city gate","pos":"word","pt":"portão da cidade","ex":"City gate.","expt":"Portão da cidade."},{"w":"straight street","pos":"word","pt":"rua reta","ex":"Straight street.","expt":"Rua reta."},{"w":"urban planner","pos":"word","pt":"urbanista","ex":"Urban planner.","expt":"Urbanista."},{"w":"city district","pos":"word","pt":"bairro da cidade","ex":"City district.","expt":"Bairro da cidade."},{"w":"pedestrian zone","pos":"word","pt":"zona de pedestres","ex":"Pedestrian zone.","expt":"Zona de pedestres."},{"w":"city wall","pos":"word","pt":"muralha da cidade","ex":"City wall.","expt":"Muralha da cidade."},{"w":"stone road","pos":"word","pt":"estrada de pedra","ex":"Stone road.","expt":"Estrada de pedra."},{"w":"town plan","pos":"word","pt":"plano urbano","ex":"Town plan.","expt":"Plano urbano."},{"w":"public square","pos":"word","pt":"praça pública","ex":"Public square.","expt":"Praça pública."},{"w":"old harbor","pos":"word","pt":"porto antigo","ex":"Old harbor.","expt":"Porto antigo."},{"w":"city growth","pos":"word","pt":"crescimento da cidade","ex":"City growth.","expt":"Crescimento da cidade."},{"w":"green park","pos":"word","pt":"parque verde","ex":"Green park.","expt":