ap","blocks":[{"type":"table","head":["Verifique"],"rows":[["Eu uso **be + substantivo / lugar**?"],["Eu uso **have / has** certo?"],["Eu sei **like / need**?"],["Eu faço **perguntas Wh-**?"],["Eu sei os **dias e meses**?"]],"cap":"Lista de verificação do nível Pré-A1"}]},{"tag":"Prática","title":"Practice · Mixed review","blocks":[{"type":"gap","title":"Complete the sentences (from the unit)","bank":null,"items":[{"s":"I ___ English at school.","a":"study","why":"study = estudar.","say":"I study English"},{"s":"Is this a school? — No, it ___.","a":"isn’t","why":"Resposta negativa curta."},{"s":"I am ___ home.","a":"at","why":"at home."},{"s":"Water is ___ the kitchen.","a":"in","why":"in = dentro."},{"s":"I ___ a phone.","a":"have","why":"I → have."},{"s":"___ you have a pen?","a":"Do","why":"you → Do."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["library","biblioteca"],["office","escritório"],["restaurant","restaurante"],["store","loja"],["work","trabalho"],["home","casa, lar"]]}]},{"tag":"Vocabulário","title":"Unit word bank","blocks":[{"type":"words","items":[["home","casa, lar"],["work","trabalho"],["store","loja"],["restaurant","restaurante"],["office","escritório"],["library","biblioteca"],["hospital","hospital"],["bank","banco"],["park","parque"],["market","mercado"],["street","rua"],["avenue","avenida"],["bridge","ponte"],["corner","esquina"],["square","praça"],["station","estação"],["airport","aeroporto"],["hotel","hotel"],["museum","museu"],["church","igreja"],["kitchen","cozinha"],["room","quarto, sala"],["bus","ônibus"],["mean","significar"],["meaning","significado"],["translate","traduzir"],["dictionary","dicionário"],["question","pergunta"],["answer","resposta"],["guess","adivinhar"],["water","água"],["food","comida"],["help","ajuda"],["money","dinheiro"],["need","precisar"],["shelter","abrigo"],["medicine","remédio"],["air","ar"],["sleep","sono"],["clothes","roupas"],["news","notícias"],["bike","bicicleta"],["car","carro"],["