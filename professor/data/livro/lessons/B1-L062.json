."},{"s":"Please accept my warm ___ . (wishes)","a":"wishes","why":"votos."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["wedding invitation","convite de casamento"],["wedding day","dia do casamento"],["warm wishes","votos calorosos"],["old friend","velho amigo"],["reply card","cartão de resposta"]]},{"type":"order","title":"Put the words in order","items":[{"words":["gladly","accept","I"],"ans":"I gladly accept","pt":"Aceito com prazer!"},{"words":["you","come","to","my","wedding","Will"],"ans":"Will you come to my wedding","pt":"Você virá ao meu casamento?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"wedding invitation","pos":"word","pt":"convite de casamento","ex":"Wedding invitation.","expt":"Convite de casamento."},{"w":"wedding day","pos":"word","pt":"dia do casamento","ex":"Wedding day.","expt":"Dia do casamento."},{"w":"warm wishes","pos":"word","pt":"votos calorosos","ex":"Warm wishes.","expt":"Votos calorosos."},{"w":"reply card","pos":"word","pt":"cartão de resposta","ex":"Reply card.","expt":"Cartão de resposta."},{"w":"wedding gift","pos":"word","pt":"presente de casamento","ex":"Wedding gift.","expt":"Presente de casamento."},{"w":"formal reply","pos":"word","pt":"resposta formal","ex":"Formal reply.","expt":"Resposta formal."},{"w":"dress code","pos":"word","pt":"código de vestimenta","ex":"Dress code.","expt":"Código de vestimenta."},{"w":"church ceremony","pos":"word","pt":"cerimônia na igreja","ex":"Church ceremony.","expt":"Cerimônia na igreja."},{"w":"reception hall","pos":"word","pt":"salão de recepção","ex":"Reception hall.","expt":"Salão de recepção."},{"w":"wedding cake","pos":"word","pt":"bolo de casamento","ex":"Wedding cake.","expt":"Bolo de casamento."},{"w":"bride and groom","pos":"word","pt":"noivos","ex":"Bride and groom.","expt":"Noivos."},{"w":"best man","pos":"word","pt":"padrinho","ex":"Best man.","expt":"Padrinho."},{"w":"bridesmaid","pos":"word","pt":"