,["political culture","cultura política"],["media coverage","cobertura da mídia"],["public trust","confiança pública"],["shared space","espaço compartilhado"],["respectful debate","debate respeitoso"],["common good","bem comum"],["citizen forum","fórum de cidadãos"]]}]},{"tag":"Leitura","title":"Reading · An editorial","blocks":[{"type":"text","title":"Why We Should Insist on Listening","paras":["Citizens **insist on speaking** but rarely **concentrate on listening**. Politicians **apologise for making** mistakes yet **rely on avoiding** debate. **In my view**, democracy **depends on hearing** every side. We must **succeed in building** a culture of dialogue, and I **look forward to seeing** it."],"kicker":"OPINION","by":"Democracy Today","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Citizens insist on speaking.","ans":"T","why":"insist on speaking."},{"q":"Politicians always welcome debate.","ans":"F","why":"avoiding debate."},{"q":"Democracy depends on hearing every side.","ans":"T","why":"depends on hearing."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“insist on” = ?","opts":["insistir em","insistir de","insistir para"],"ans":0,"why":"insist on."},{"q":"“depend on” = ?","opts":["depender de","depender em","despender"],"ans":0,"why":"depend on."}]}]},{"tag":"Gramática","title":"Verbo + preposição + -ing","blocks":[{"type":"table","head":["Verbo","Exemplo"],"rows":[["insist on","**insist on speaking**"],["concentrate on","**concentrate on listening**"],["apologise for","**apologise for making**"],["succeed in","**succeed in building**"],["look forward to","**look forward to seeing**"]],"cap":"Verbo + preposição + -ing"},{"type":"box","kind":"look","t":"Regra","body":"Após preposição, sempre **-ing**. Cada verbo tem sua preposição: aprenda **em bloco**."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"T