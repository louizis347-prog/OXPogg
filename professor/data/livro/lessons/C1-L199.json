vo/-ing","blocks":[{"type":"table","head":["Estrutura","Exemplo"],"rows":[["be subject to + noun","Prices **are subject to** change."],["modal + be subject to","Plans **may be subject to** approval."],["being subject to","**Being subject to** review improves quality."],["subject to (condição)","**Subject to** your approval, we will start."]],"cap":"be subject to + substantivo/-ing"},{"type":"box","kind":"look","t":"Regra","body":"**be subject to** = estar sujeito a (revisão, taxas, mudanças). Depois de *to* vem **substantivo ou -ing**, nunca verbo no infinitivo."},{"type":"box","kind":"warn","t":"Cuidado","body":"*Be subject to change* ✓; *subject to change something* ✗."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Prices are subject ___ change. (to)","a":"to","why":"preposição."},{"s":"Results may be ___ to verification. (subject)","a":"subject","why":"be subject to."},{"s":"___ to approval, we will begin. (subject)","a":"Subject","why":"condição."},{"s":"Being subject to ___ improves quality. (review)","a":"review","why":"objeto: substantivo."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["subject to change","sujeito a alteração"],["subject to approval","sujeito a aprovação"],["subject to availability","sujeito à disponibilidade"],["peer review","revisão por pares"],["right of appeal","direito de recurso"]]},{"type":"order","title":"Put the words in order","items":[{"words":["experts","And","famous"],"ans":"And famous experts","pt":"E especialistas famosos?"},{"words":["scientists","subject","to","review","Are"],"ans":"Are scientists subject to review","pt":"Cientistas estão sujeitos a revisão?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"subject to change","pos":"word","pt":"sujeito a alteração","ex":"Subject to change.","expt":"Sujeito a alteração."},{"w":"subject to approval","pos":"word","pt":"sujeito a ap