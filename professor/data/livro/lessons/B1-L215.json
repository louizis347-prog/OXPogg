t","mensagem de desculpas"],["friendship rule","regra de amizade"],["weekend rest","descanso do fim de semana"],["missed date","missed date"]]}]},{"tag":"Leitura","title":"Reading · An e-mail","blocks":[{"type":"mail","from":"ana@mail.com","to":"leo@mail.com","subject":"Sorry I missed it","paras":["Hi Leo,","I’m **so** sorry I didn’t **show up**. It was **such** a long day, and I was **so** tired that I fell asleep. It **depends** on the week, but I’m **such** a heavy sleeper!","Can we try again on Friday? Ana"],"gloss":[["sleeper","dorminhoco"],["heavy","pesado"],["fell asleep","adormeci"],["try again","tentar de novo"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Ana did not show up.","ans":"T","why":"didn’t show up."},{"q":"Ana had a short day.","ans":"F","why":"such a long day."},{"q":"Ana wants to try again on Friday.","ans":"T","why":"Friday."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“show up” = ?","opts":["aparecer","mostrar para cima","subir"],"ans":0,"why":"show up."},{"q":"“depend” = ?","opts":["depender","depositar","depor"],"ans":0,"why":"depend."}]}]},{"tag":"Gramática","title":"so × such","blocks":[{"type":"table","head":["Estrutura","Exemplo"],"rows":[["so + adjetivo/advérbio","**so tired, so quickly**"],["such + (a) + adj. + subst.","**such a long day**"],["such + subst. plural","**such good friends**"],["so… that","**so tired that I slept**"]],"cap":"so × such"},{"type":"box","kind":"look","t":"Regra","body":"**so** + adjetivo; **such** + substantivo. *depend on* (✗ *depend of*)."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"I was ___ tired. (so)","a":"so","why":"so + adj."},{"s":"It was ___ a long day. (such)","a":"such","why":"such + a + subst."},{"s":"It ___ on the week. (depend, 3ª)","a":"depends","why":"depend on."},{"s":"I didn’t ___ up. (show)","a":"show","why":"show up."}]},{"type":