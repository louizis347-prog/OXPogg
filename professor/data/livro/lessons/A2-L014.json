ing cheaper"}]},{"type":"match","title":"Match the word to its meaning","pairs":[["invoice","fatura"],["tracking number","código de rastreio"],["shipping","envio"],["due date","data limite"],["dispute","contestação"]]},{"type":"order","title":"Put the words in order","items":[{"words":["a","green","one","Yes"],"ans":"Yes a green one","pt":"Sim, um verde."},{"words":["didn't","arrive","My","order"],"ans":"My order didn't arrive","pt":"Meu pedido não chegou."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"tracking number","pos":"word","pt":"código de rastreio","ex":"Send the tracking number.","expt":"Envie o código de rastreio."},{"w":"shipping","pos":"word","pt":"envio","ex":"Free shipping.","expt":"Envio grátis."},{"w":"due date","pos":"word","pt":"data limite","ex":"The due date.","expt":"A data limite."},{"w":"dispute","pos":"word","pt":"contestação","ex":"A billing dispute.","expt":"Uma contestação."},{"w":"express","pos":"word","pt":"expresso","ex":"Express delivery.","expt":"Entrega expressa."},{"w":"delivery","pos":"word","pt":"entrega","ex":"A late delivery.","expt":"Uma entrega atrasada."},{"w":"parcel","pos":"word","pt":"encomenda","ex":"A small parcel.","expt":"Uma encomenda pequena."},{"w":"cheaper","pos":"word","pt":"mais barato","ex":"A cheaper one.","expt":"Um mais barato."},{"w":"dispatch","pos":"word","pt":"dispatch","ex":"despacho","expt":"Dispatch is late."},{"w":"late delivery","pos":"word","pt":"late delivery","ex":"entrega atrasada","expt":"A late delivery."},{"w":"missing item","pos":"word","pt":"missing item","ex":"item faltando","expt":"A missing item."},{"w":"damaged","pos":"word","pt":"damaged","ex":"danificado","expt":"A damaged box."},{"w":"replacement","pos":"word","pt":"replacement","ex":"substituição","expt":"Send a replacement."},{"w":"apology","pos":"word","pt":"apology","ex":"pedido de desculpas","expt":"A polite apology."},{"w":"compensation","pos":"word","pt":"compensation","ex":