ing","a","bike","I'm"],"ans":"I'm riding a bike","pt":"Estou indo de bike."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"commute","pos":"noun","pt":"trajeto diário","ex":"My commute is long.","expt":"Meu trajeto é longo."},{"w":"worker","pos":"noun","pt":"trabalhador","ex":"A good worker.","expt":"Um bom trabalhador."},{"w":"lane","pos":"noun","pt":"faixa","ex":"A bike lane.","expt":"Uma ciclovia."},{"w":"popular","pos":"adj","pt":"popular","ex":"A popular idea.","expt":"Uma ideia popular."},{"w":"however","pos":"adv","pt":"porém","ex":"However, it is late.","expt":"Porém, está tarde."},{"w":"travel","pos":"verb","pt":"viajar","ex":"We travel by train.","expt":"Viajamos de trem."},{"w":"build","pos":"verb","pt":"construir","ex":"They build a bridge.","expt":"Eles constroem uma ponte."},{"w":"ice cream","pos":"word","pt":"sorvete","ex":"Vanilla ice cream.","expt":"Sorvete de baunilha."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**How do you travel to work?** — Como você vai ao trabalho?","**I usually take the bus.** — Geralmente pego ônibus.","**And this month?** — E este mês?"]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"travel","pt":"viajar","forms":[["I travel","I travel by bus."],["you travel","You travel a lot."],["he / she / it travels","She travels to work."],["we / they travel","We travel together."]],"note":"**travel** = viajar/ deslocar-se."}]}]},{"tag":"Escuta e diálogo","title":"Commuting","blocks":[{"type":"dialog","title":"Commuting","lines":[["Ana","How do you travel to work?","Como você vai ao trabalho?"],["Leo","I usually take the bus.","Geralmente pego ônibus."],["Ana","And this month?","E este mês?"],["Leo","I’m riding a bike.","Estou indo de bike."],["Ana","Why?","Por quê?"],["Leo","The buses are running late.","Os ônibus estão atrasados."]]},{"type":"pron","title":"Pronúncia: ship/sheep","items":[{"label":"ship/sheep","note":"Terminação -ing em palavras de 3 sílabas: travelLING, becomING.","words":["traveling","becoming","building","riding"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say how you travel usually and this month.","pt":"Diga.","model":"I usually take the bus. This month I’m riding a bike."},{"q":"Ask: How do you travel?","pt":"Pergunte.","model":"How do you travel to work?"},{"q":"Say something that is changing.","pt":"Diga.","model":"Cities are building more bike lanes."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-line summary about how people travel.","model":"Most people take the bus. This month many ride bikes. Buses run late. Cycling is becoming popular. Cities build lanes. I think it is good.","checklist":["Usei **Simple** e **Continuous**","Usei **however**","Usei **study**"],"words":"6 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “commute” mean?","opts":["trabalhador","popular","trajeto diário"],"ans":2,"why":"**commute** = trajeto diário."},{"q":"What does “worker” mean?","opts":["trabalhador","faixa","porém"],"ans":0,"why":"**worker** = trabalhador."},{"q":"What does “lane” mean?","opts":["popular","faixa","viajar"],"ans":1,"why":"**lane** = faixa."},{"q":"What does “popular” mean?","opts":["porém","construir","popular"],"ans":2,"why":"**popular** = popular."},{"q":"“These days I ___ a bike.”","opts":["am riding","ride always","rides"],"ans":0,"why":"These days → Continuous."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["No **TOEFL Reading**, resumos acadêmicos usam *however* para contrastar.","No **Writing**, escolha o tempo pela pista."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Faça um **quadro de pistas**.","Peça que o aluno diga o mesmo fato em Simple e Continuous.","Erro típico: *“I am knowing.”* → *I know.*"]}]}]}