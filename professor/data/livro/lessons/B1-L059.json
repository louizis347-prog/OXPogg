amous author","autora famosa"],["sensory loss","perda sensorial"],["touch alphabet","alfabeto tátil"],["college degree","diploma universitário"],["public speech","discurso público"],["world tour","turnê mundial"]]}]},{"tag":"Leitura","title":"Reading · A short biography","blocks":[{"type":"bio","name":"Helen Keller and Anne Sullivan","paras":["Helen Keller **lost** her sight and hearing as a baby. Her teacher, Anne Sullivan, **used to spell** words into her hand. At first Helen **refused** to learn, but one day she **understood** the word “water.”","They **stayed** friends for almost fifty years. “**I have no idea** what I would have done without her,” Helen **said**."],"years":"1880–1968","facts":[["Famous for","escritora e ativista"],["Teacher","Anne Sullivan"],["Friendship","50 anos"]],"gloss":[["sight","visão"],["hearing","audição"],["spell","soletrar"],["understand","entender"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Helen Keller lost her sight and hearing as a baby.","ans":"T","why":"as a baby."},{"q":"Anne Sullivan was her mother.","ans":"F","why":"teacher."},{"q":"They stayed friends for fifty years.","ans":"T","why":"almost fifty years."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“spell” = ?","opts":["soletrar","cheirar","falar"],"ans":0,"why":"spell."},{"q":"“sight” = ?","opts":["visão","lado","sinal"],"ans":0,"why":"sight."}]}]},{"tag":"Gramática","title":"Telling a friendship story","blocks":[{"type":"table","head":["Para…","Exemplo"],"rows":[["hábito","**She used to spell words.**"],["fato","**Helen understood “water.”**"],["recusa","**At first she refused.**"],["gratidão","**I have no idea what I would do without her.**"]],"cap":"Telling a friendship story"},{"type":"box","kind":"look","t":"Regra","body":"**I have no idea** = não faço ideia. **I have no idea what I would have done** = expressa dependência."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"ga