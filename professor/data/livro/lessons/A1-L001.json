ubbles":[["Lara","Are you late?"],["Sam","No, I’m not. I wake up early."]],"cap":"Panel 2"},{"scene":"😴","bubbles":[["Sam","Say it again: I wake up at six."],["Lara","At six? You are crazy!"]],"cap":"Panel 3"},{"scene":"😂","bubbles":[["Sam","Ha! I am a teacher."],["Lara","Of course you are."]],"cap":"Panel 4"}],"gloss":[["early","cedo"],["late","atrasado"],["crazy","maluco"],["teacher","professor"]],"say":""}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Sam wakes up early.","ans":"T","why":"“I wake up early.”"},{"q":"Sam is late.","ans":"F","why":"“No, I’m not.”"},{"q":"Lara is a teacher.","ans":"F","why":"Sam é o professor."},{"q":"Lara is Sam’s sister.","ans":"NG","why":"Não diz."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“wake up” means…","opts":["acordar","dormir","correr"],"ans":0,"why":"wake up = acordar."},{"q":"“crazy” means…","opts":["maluco","calmo","alto"],"ans":0,"why":"crazy = maluco."}]}]},{"tag":"Gramática","title":"To be: all forms","blocks":[{"type":"table","head":["Sujeito","Afirmativa","Negativa","Pergunta"],"rows":[["I","**am**","**am not**","**Am I…?**"],["you / we / they","**are**","**aren’t**","**Are you…?**"],["he / she / it","**is**","**isn’t**","**Is she…?**"]],"cap":"To be"},{"type":"box","kind":"look","t":"Uso","body":"Usamos **be** para dizer **nome, idade, origem, profissão, estado**: *I’m 25. She’s from Peru. They’re tired.*"},{"type":"box","kind":"warn","t":"Cuidado","body":"Português usa “ter” para idade; inglês usa **be**: *I am 20* (não *I have 20*)."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"She ___ from Peru.","a":"is","why":"she → is.","say":"She is from Peru"},{"s":"They ___ tired.","a":"are","why":"they → are."},{"s":"I ___ not late.","a":"am","why":"I → am."},{"s":"___ you a student?","a":"Are","why":"you → are."},{"s":"He ___ 25 years old.","a":"is","why":"idade com