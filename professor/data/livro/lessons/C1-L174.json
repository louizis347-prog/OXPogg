liar","Pontos"],"rows":[["Leitura","Quadros 3–4: ideias principais e vocabulário","/ 10"],["Escuta","Quadro 9: entender o diálogo e repetir","/ 10"],["Fala","Quadro 10: frases completas sem pausas longas","/ 10"],["Escrita","Quadro 11: frases corretas com a lista de verificação","/ 10"]],"cap":"Autoavaliação (40 pontos)"},{"type":"box","kind":"look","t":"Critério de conclusão","body":"**28 a 40 pontos:** siga para a próxima unidade. **20 a 27:** repita as aulas em que errou mais. **Menos de 20:** volte à Unidade e refaça os exercícios dos quadros 5 e 6."},{"type":"mcq","title":"Final check","items":[{"q":"What does “job application” mean?","opts":["estilo compacto","candidatura a emprego","divisão de argumentos"],"ans":1,"why":"**job application** = candidatura a emprego."},{"q":"What does “compact style” mean?","opts":["decisão antitruste","etapa de preparação","estilo compacto"],"ans":2,"why":"**compact style** = estilo compacto."},{"q":"What does “anti-trust ruling” mean?","opts":["decisão antitruste","divisão de argumentos","candidatura a emprego"],"ans":0,"why":"**anti-trust ruling** = decisão antitruste."},{"q":"What does “case split” mean?","opts":["etapa de preparação","divisão de argumentos","estilo compacto"],"ans":1,"why":"**case split** = divisão de argumentos."},{"q":"What does “preparation stage” mean?","opts":["candidatura a emprego","decisão antitruste","etapa de preparação"],"ans":2,"why":"**preparation stage** = etapa de preparação."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","No IELTS e TOEFL C1, concessão e causalidade precisas são marcadores de nível avançado."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique sem consulta e com tempo.","Grave a parte oral.","Use a lista para autoavaliação."]}]}]}