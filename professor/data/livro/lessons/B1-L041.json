rely","why":"advérbio."},{"s":"The city ___ donated tools. (has)","a":"has","why":"Present Perfect."},{"s":"Families ___ vegetables. (trade)","a":"trade","why":"Present Simple."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["community garden","horta comunitária"],["oak street","rua dos carvalhos"],["garden tools","ferramentas de jardim"],["weekly lunch","almoço semanal"],["vegetable patch","canteiro de legumes"]]},{"type":"order","title":"Put the words in order","items":[{"words":["you","do","now","What","do"],"ans":"What do you do now","pt":"O que fazem agora?"},{"words":["trade","vegetables","We"],"ans":"We trade vegetables","pt":"Trocamos legumes."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"oak street","pos":"word","pt":"rua dos carvalhos","ex":"Oak street.","expt":"Rua dos carvalhos."},{"w":"garden tools","pos":"word","pt":"ferramentas de jardim","ex":"Garden tools.","expt":"Ferramentas de jardim."},{"w":"weekly lunch","pos":"word","pt":"almoço semanal","ex":"Weekly lunch.","expt":"Almoço semanal."},{"w":"vegetable patch","pos":"word","pt":"canteiro de legumes","ex":"Vegetable patch.","expt":"Canteiro de legumes."},{"w":"first harvest","pos":"word","pt":"primeira colheita","ex":"First harvest.","expt":"Primeira colheita."},{"w":"city donation","pos":"word","pt":"doação da prefeitura","ex":"City donation.","expt":"Doação da prefeitura."},{"w":"garden volunteer","pos":"word","pt":"voluntário da horta","ex":"Garden volunteer.","expt":"Voluntário da horta."},{"w":"neighborhood news","pos":"word","pt":"notícias do bairro","ex":"Neighborhood news.","expt":"Notícias do bairro."},{"w":"resident meeting","pos":"word","pt":"reunião de moradores","ex":"Resident meeting.","expt":"Reunião de moradores."},{"w":"tomato plant","pos":"word","pt":"pé de tomate","ex":"Tomato plant.","expt":"Pé de tomate."},{"w":"compost pile","pos":"word","pt":"pilha de compostagem","ex":"Compost pile.","expt":"Pilha de compostagem."},{"w":"garden fence","pos":"word","pt":"cerca do jardim","ex":"Garden fence.","expt":"Cerca do jardim."},{"w":"spring planting","pos":"word","pt":"plantio de primavera","ex":"Spring planting.","expt":"Plantio de primavera."},{"w":"street party","pos":"word","pt":"festa de rua","ex":"Street party.","expt":"Festa de rua."},{"w":"elderly resident","pos":"word","pt":"morador idoso","ex":"Elderly resident.","expt":"Morador idoso."},{"w":"local council","pos":"word","pt":"conselho local","ex":"Local council.","expt":"Conselho local."},{"w":"garden club","pos":"word","pt":"clube de jardinagem","ex":"Garden club.","expt":"Clube de jardinagem."},{"w":"vegetable swap","pos":"word","pt":"troca de legumes","ex":"Vegetable swap.","expt":"Troca de legumes."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Many hands make light work.** — Muitas mãos aliviam o trabalho.","**Neighbors turned friends.** — Vizinhos que viraram amigos.","**Reap what you sow.** — Colher o que se planta.","**How long have you been working here?** — Há quanto tempo trabalham aqui?","**Since spring. We barely knew each other.** — Desde a primavera. Mal nos conhecíamos.","**What do you do now?** — O que fazem agora?","**Get the hang of it.** — Pegar o jeito.","**Give it a shot.** — Dê uma chance."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"gather","pt":"reunir","forms":[["I / you / we / they gather","We gather here."],["he / she / it gathers","She gathers wood."]]}]}]},{"tag":"Escuta e diálogo","title":"Garden talk","blocks":[{"type":"dialog","title":"Garden talk","lines":[["Reporter","How long have you been working here?","Há quanto tempo trabalham aqui?"],["Rita","Since spring. We barely knew each other.","Desde a primavera. Mal nos conhecíamos."],["Reporter","What do you do now?","O que fazem agora?"],["Rita","We trade vegetables.","Trocamos legumes."]]},{"type":"pron","title":"Pronúncia: Word stress","items":[{"label":"Wor