og reader","leitor de blog"],["English diary","diário de inglês"],["teaching career","carreira de ensino"],["learning streak","sequência de estudo"]]}]},{"tag":"Leitura","title":"Reading · A blog post","blocks":[{"type":"text","title":"Ten Years of Learning English","paras":["I **have learned** English **for ten years**, and **since 2020** I **have taught** it online. I **haven’t stopped** studying: I **have read** over 100 books and **have kept** a diary **since** I was twelve.","**How long have you been** learning? Tell me in the comments. I **have always believed** that small habits win."],"kicker":"LEARNING BLOG","by":"Nina","gloss":[["diary","diário"],["habit","hábito"],["comments","comentários"],["win","vencer"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Nina has learned English for ten years.","ans":"T","why":"for ten years."},{"q":"Nina has taught since 2010.","ans":"F","why":"since 2020."},{"q":"Nina has kept a diary since twelve.","ans":"T","why":"since I was twelve."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“diary” = ?","opts":["diário","dieta","dia"],"ans":0,"why":"diary."},{"q":"“comments” = ?","opts":["comentários","comandos","combinados"],"ans":0,"why":"comments."}]}]},{"tag":"Gramática","title":"Duration: production","blocks":[{"type":"table","head":["Para…","Exemplo"],"rows":[["período","**I have learned English for ten years.**"],["início","**I have taught since 2020.**"],["hábito longo","**I have kept a diary since I was twelve.**"],["pergunta aos leitores","**How long have you been learning?**"]],"cap":"Duration: production"},{"type":"box","kind":"look","t":"Regra","body":"Em blog, conecte passado e presente: *For ten years… Since then… Now…*"}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"I have learned English ___ ten years. (for)","a":"for","why":"período."},{"s":"I have taught ___ 2020. (since)","a":"since","why":"início."},{"s":"I have kept a diary ___ I was twelve. (since)","a":"since","why":"início."},{"s":"I ___ stopped studying. (haven’t)","a":"haven’t","why":"neg."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["learning blog","blog de aprendizado"],["ten years","dez anos"],["online teaching","ensino online"],["book list","lista de livros"],["long habit","hábito antigo"]]},{"type":"order","title":"Put the words in order","items":[{"words":["years","For","ten"],"ans":"For ten years","pt":"Há dez anos."},{"words":["taught","English","How","long","have","you"],"ans":"How long have you taught English","pt":"Há quanto tempo ensina inglês?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"learning blog","pos":"word","pt":"blog de aprendizado","ex":"A learning blog.","expt":"Um blog de aprendizado."},{"w":"ten years","pos":"word","pt":"dez anos","ex":"Ten years.","expt":"Dez anos."},{"w":"online teaching","pos":"word","pt":"ensino online","ex":"Online teaching.","expt":"Ensino online."},{"w":"reader comment","pos":"word","pt":"comentário de leitor","ex":"A reader comment.","expt":"Um comentário de leitor."},{"w":"study diary","pos":"word","pt":"diário de estudo","ex":"A study diary.","expt":"Um diário de estudo."},{"w":"daily practice","pos":"word","pt":"prática diária","ex":"Daily practice.","expt":"Prática diária."},{"w":"progress note","pos":"word","pt":"nota de progresso","ex":"A progress note.","expt":"Uma nota de progresso."},{"w":"English journey","pos":"word","pt":"jornada com o inglês","ex":"An English journey.","expt":"Uma jornada com o inglês."},{"w":"blog post","pos":"word","pt":"post de blog","ex":"A blog post.","expt":"Um post de blog."},{"w":"learning tips","pos":"word","pt":"dicas de aprendizado","ex":"Learning tips.","expt":"Dicas de aprendizado."},{"w":"teacher voice","pos":"word","pt":"voz de professora","ex":"A teacher voice.","expt":"Uma voz de professor