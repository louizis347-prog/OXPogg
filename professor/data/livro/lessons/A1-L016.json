","cebola"],["salt","sal"],["pot","panela"],["garden","jardim"],["cut","cortar"],["add","adicionar"],["eat","comer"],["routine","rotina"],["breakfast","café da manhã"],["garage","garagem"],["live","morar"],["drink","beber"],["relax","relaxar"],["bedroom","quarto"],["living room","sala de estar"],["ship","navio"],["sheep","ovelha"],["seat","assento"],["sit","sentar"],["fish","peixe"],["waiter","garçom"],["stairs","escada"],["smile","sorriso"],["rest","descansar"],["call","ligar"],["always","sempre"],["usually","geralmente"],["sometimes","às vezes"],["never","nunca"],["bell","campainha"],["same","mesmo"],["sleep","sono"],["grade","nota"],["improve","melhorar"],["later","mais tarde"],["start","começar"],["towel","toalha"],["teenager","adolescente"],["idea","ideia"],["adult","adulto"],["habit","hábito"],["exercise","exercício"],["soap","sabonete"],["study","estudo"],["answer","resposta"],["daily","diário"],["person","pessoa"],["shower","banho"],["break","pausa"],["photo","foto"],["taxi","táxi"],["test","prova"],["toothbrush","escova de dentes"],["blanket","cobertor"],["long","longo"],["pillow","travesseiro"],["television","televisão"],["advice","conselho"],["research","pesquisa"],["closer","mais perto"],["replace","substituir"],["radio","rádio"],["miss","sentir falta"],["library","biblioteca"],["manager","gerente"],["offer","oferecer"],["open","abrir"],["close","fechar"],["reader","leitor"],["screen","tela"],["keyboard","teclado"],["university","universidade"],["gym","academia"],["restroom","banheiro"],["music","música"],["charger","carregador"],["email","e-mail"],["password","senha"],["website","site"],["sun","sol"],["tea","chá"],["rise","nascer, levantar"],["walk","andar"],["read","ler"],["write","escrever"],["hard","muito, duro"],["video","vídeo"]]},{"type":"vocab","items":[{"w":"sugar","pos":"word","pt":"açúcar","ex":"Two spoons of sugar.","expt":"Duas colheres de açúcar."},{"w":"oil","pos":"word","pt":"óleo","ex":"Olive oil.","expt":"Azeite."},{"w":"beef","pos":"wo