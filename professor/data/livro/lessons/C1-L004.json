 de sucesso"],["office cartoon","charge de escritório"],["intern contribution","contribuição do estagiário"],["quarterly results","resultados trimestrais"],["revenue surge","salto de receita"],["sales slump","queda de vendas"],["blame game","jogo de culpa"],["root cause","causa raiz"],["cause and effect","causa e efeito"],["management spin","versão da gerência"],["workplace joke","piada de trabalho"],["meeting fatigue","fadiga de reuniões"],["merit award","prêmio por mérito"],["unsung hero","herói anônimo"],["public acknowledgment","reconhecimento público"]]}]},{"tag":"Leitura","title":"Reading · A cartoon","blocks":[{"type":"comic","title":"Who Gets the Credit?","panels":[{"scene":"📈","bubbles":[["Manager","We attribute this growth to teamwork."],["Intern","Funny, I attributed it to coffee."]],"cap":"Panel 1"},{"scene":"📉","bubbles":[["Manager","The dip is attributed to market conditions."],["Intern","Or to the 4 p.m. meetings."]],"cap":"Panel 2"},{"scene":"🏆","bubbles":[["Manager","I owe my promotion to my team."],["Intern","And to the intern who wrote the report."]],"cap":"Panel 3"}],"gloss":[["growth","crescimento"],["dip","queda"],["credit","crédito, mérito"],["intern","estagiário"]],"say":""}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The manager attributes growth to teamwork.","ans":"T","why":"attribute this growth to teamwork."},{"q":"The intern attributes growth to the market.","ans":"F","why":"to coffee."},{"q":"The manager owes his promotion to the team.","ans":"T","why":"owe … to my team."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“dip” = ?","opts":["queda leve","mergulho","dívida"],"ans":0,"why":"the dip."},{"q":"“intern” = ?","opts":["estagiário","interno só","internet"],"ans":0,"why":"intern."}]}]},{"tag":"Gramática","title":"attribute something to something","blocks":[{"type":"table","head":["Estrutura","Exemplo"],"rows":[["attribute A to B","**We attribute the growth 