ograph","photography","develop","different"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say what you have been doing.","pt":"Diga.","model":"I have been studying all day."},{"q":"Ask How long…?","pt":"Pergunte.","model":"How long have you been waiting?"},{"q":"Give a cooking step.","pt":"Dê.","model":"Chop the onion."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences about what you have been doing lately.","model":"I have been studying English every day. I have been cooking at home. My sister has been working late. We have been walking after dinner. I have been sleeping well.","checklist":["Usei **have/has been + -ing**","Usei **for/since**","5 frases"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “study night” mean?","opts":["noite de estudos","sopa de legumes","fogo baixo"],"ans":0,"why":"**study night** = noite de estudos."},{"q":"What does “vegetable soup” mean?","opts":["tempo de cozimento","sopa de legumes","cenoura picada"],"ans":1,"why":"**vegetable soup** = sopa de legumes."},{"q":"What does “cooking time” mean?","opts":["fogo baixo","água fervendo","tempo de cozimento"],"ans":2,"why":"**cooking time** = tempo de cozimento."},{"q":"What does “low heat” mean?","opts":["fogo baixo","cenoura picada","timer de cozinha"],"ans":0,"why":"**low heat** = fogo baixo."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}