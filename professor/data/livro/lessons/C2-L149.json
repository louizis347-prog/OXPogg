voz alta"],["better listeners","melhores ouvintes"],["overcrowded timetable","grade horária sobrecarregada"],["staff upskilling","capacitação de docentes"],["four-school pilot","piloto em quatro escolas"],["encouraging results","resultados encorajadores"],["teacher courses","cursos para professores"],["funding pledge","promessa de financiamento"],["fairness question","pergunta sobre justiça"],["unfair rule","regra injusta"],["two-year review","revisão em dois anos"],["school philosophy","filosofia na escola"],["philosophy for children","filosofia para crianças"],["community of inquiry","comunidade de investigação"],["circle talk","roda de conversa"],["stimulus story","história-estímulo"],["open-ended question","pergunta aberta"],["thinking skills","habilidades de pensamento"],["critical literacy","letramento crítico"]]}]},{"tag":"Leitura","title":"Reading · A short news report","blocks":[{"type":"news","headline":"Council Brings Philosophy to Primary Schools","paras":["The Northbridge education board voted on Wednesday to introduce weekly philosophy sessions for pupils aged eight to eleven from next September. **The measure passed 7–2** after a **lively** debate.","Supporters **argued** that children who **practise** reasoning aloud become **better listeners**; opponents **worried** the timetable was **already overcrowded** and that teachers **lacked training**. Board chair Teresa Quinn said that **a pilot in four schools** had **shown** encouraging results, **adding that** the board **would fund** teacher courses.","Under the plan, pupils **will discuss** questions such as “**What is fairness?**” and “**Can a rule be unfair?**”. **A review is expected** in two years."],"kicker":"EDUCATION NEWS","by":"Northbridge Gazette","gloss":[["pupil","aluno"],["overcrowded","sobrecarregado"],["pilot","projeto-piloto"],["fund","financiar"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The measure passed unanimously.","ans":"F","why":"7–2."},{"q":"Opponents worried teachers lacked training.","ans":"T","why":"teachers lacked training."},{"q":"A review is expected in two years.","ans":"T","why":"in two years."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“pilot” (noun) = ?","opts":["projeto-piloto","piloto de avião","guia"],"ans":0,"why":"a pilot in four schools."},{"q":"“overcrowded” = ?","opts":["sobrecarregado, lotado","pouco usado","vazio"],"ans":0,"why":"overcrowded timetable."}]}]},{"tag":"Gramática","title":"Relatar decisões e razões","blocks":[{"type":"table","head":["Estrutura","Exemplo","Função"],"rows":[["voz passiva","**A review is expected** in two years.","impessoal"],["verbos de relato","Supporters **argued** that…; opponents **worried** that…","posições"],["**adding that**","…results, **adding that** the board would fund…","acréscimo"],["futuro no plano","Pupils **will discuss** questions…","programação"]],"cap":"Relatar decisões e razões"},{"type":"box","kind":"look","t":"Regra","body":"Em notícias educacionais, use **verbos de relato** com *that*, **passiva** para fatos oficiais e **will** para programação. Números: *7–2* lê-se *seven to two*."},{"type":"box","kind":"warn","t":"Cuidado","body":"*Pupil* (BrE, escola básica) × *student* (AmE e ensino superior): ambos aparecem em notícias."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"The board ___ on Wednesday to introduce sessions. (vote, passado)","a":"voted","why":"verbo."},{"s":"Supporters ___ that children become better listeners. (argue, passado)","a":"argued","why":"relato."},{"s":"A review is ___ in two years. (expected)","a":"expected","why":"passiva."},{"s":"Pupils ___ discuss questions such as What is fairness? (will)","a":"will","why":"futuro."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["education board","conselho de educação"],["weekly sessions","sessões semanais"],["pupils aged eigh