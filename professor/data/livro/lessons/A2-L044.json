ipe médica"],["pulse check","medição do pulso"]]}]},{"tag":"Leitura","title":"Reading · A news report","blocks":[{"type":"news","headline":"Health Fair Promises Free Check-ups","paras":["The city **will** open a free health fair on Saturday. Doctors **will** check blood pressure, nurses **will** offer flu shots, and a dietitian **will describe** healthy menus.","“We **won’t** charge anything,” says the organizer. “People **will** leave with a plan.” Experts expect 2,000 visitors."],"kicker":"LOCAL NEWS","by":"By Rae Holt","gloss":[["fair","feira"],["flu shot","vacina da gripe"],["dietitian","nutricionista"],["charge","cobrar"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The fair will be on Saturday.","ans":"T","why":"“on Saturday.”"},{"q":"Visitors will pay a small fee.","ans":"F","why":"won’t charge."},{"q":"Experts expect 2,000 visitors.","ans":"T","why":"2,000."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“charge” (verbo) = ?","opts":["cobrar","carregar","cancelar"],"ans":0,"why":"charge."},{"q":"“dietitian” = ?","opts":["nutricionista","dentista","enfermeiro"],"ans":0,"why":"dietitian."}]}]},{"tag":"Gramática","title":"will: production","blocks":[{"type":"table","head":["Função","Exemplo"],"rows":[["promessa","**I will call you.**"],["previsão","**It will be crowded.**"],["decisão na hora","**I’ll take it.**"],["negativa","**We won’t charge.**"]],"cap":"will: production"},{"type":"box","kind":"look","t":"Regra","body":"Para pedir descrição: *Can you describe it?* — resposta com *It is…*"}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Doctors ___ check blood pressure. (will)","a":"will","why":"will."},{"s":"We ___ charge anything. (won’t)","a":"won’t","why":"neg."},{"s":"A dietitian will ___ menus. (describe)","a":"describe","why":"base."},{"s":"___ people come? (will)","a":"Will","why":"pergunta."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["dietitian","nutricionista"],["flu shot","vacina da gripe"],["organizer","organizador"],["fair","feira"],["screening","triagem"]]},{"type":"order","title":"Put the words in order","items":[{"words":["will","be","free","No","it"],"ans":"No it will be free","pt":"Não, será grátis."},{"words":["ten","minutes","Yes","in"],"ans":"Yes in ten minutes","pt":"Sim, em dez minutos."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"dietitian","pos":"word","pt":"nutricionista","ex":"The dietitian helps.","expt":"A nutricionista ajuda."},{"w":"flu shot","pos":"word","pt":"vacina da gripe","ex":"Get a flu shot.","expt":"Tome a vacina da gripe."},{"w":"organizer","pos":"word","pt":"organizador","ex":"The organizer smiles.","expt":"O organizador sorri."},{"w":"screening","pos":"word","pt":"triagem","ex":"A free screening.","expt":"Uma triagem gratuita."},{"w":"pamphlet","pos":"word","pt":"folheto","ex":"Take a pamphlet.","expt":"Pegue um folheto."},{"w":"booth","pos":"word","pt":"estande","ex":"Visit the booth.","expt":"Visite o estande."},{"w":"volunteer doctor","pos":"word","pt":"médico voluntário","ex":"A volunteer doctor.","expt":"Um médico voluntário."},{"w":"health fair","pos":"word","pt":"feira de saúde","ex":"A health fair.","expt":"Uma feira de saúde."},{"w":"blood pressure check","pos":"word","pt":"aferição de pressão","ex":"A blood pressure check.","expt":"Uma aferição de pressão."},{"w":"healthy menu","pos":"word","pt":"cardápio saudável","ex":"A healthy menu.","expt":"Um cardápio saudável."},{"w":"free screening","pos":"word","pt":"triagem grátis","ex":"A free screening.","expt":"Uma triagem grátis."},{"w":"fair booth","pos":"word","pt":"estande da feira","ex":"A fair booth.","expt":"Um estande da feira."},{"w":"flu season","pos":"word","pt":"temporada de gripe","ex":"Flu season.","expt":"Temporada de gripe."},{"w":"health tip","pos":"word","pt":"dica de saúde",