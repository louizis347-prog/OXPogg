glish.","Preciso de ajuda com inglês."]]},{"type":"pron","title":"Pronúncia: Entonação de perguntas","items":[{"label":"Entonação de perguntas","note":"Perguntas com Wh- descem no final: Where are you from? ↘","words":["Where are you from?","What is your name?","How are you?"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Ask: Where are you from?","pt":"Pergunte.","model":"Where are you from?"},{"q":"Ask: Who is that?","pt":"Pergunte.","model":"Who is that?"},{"q":"Ask for help.","pt":"Peça ajuda.","model":"Can you help me?"}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 4 questions with what, where, who, how.","model":"What is your name? Where are you from? Who is your teacher? How are you?","checklist":["Usei **4 Wh-**","Usei **be** na ordem certa","Usei **?**"],"words":"4 perguntas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “what” mean?","opts":["onde","quando","o que, qual"],"ans":2,"why":"**what** = o que, qual."},{"q":"What does “where” mean?","opts":["onde","quem","por que"],"ans":0,"why":"**where** = onde."},{"q":"What does “who” mean?","opts":["quando","quem","como"],"ans":1,"why":"**who** = quem."},{"q":"What does “when” mean?","opts":["por que","o que, qual","quando"],"ans":2,"why":"**when** = quando."},{"q":"Which is correct?","opts":["Where are you from?","Where you are from?","Where is you from?"],"ans":0,"why":"Wh- + be + sujeito."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Em **Speaking**, perguntas Wh- pedem **respostas completas**.","Em **Listening**, a palavra Wh- diz o que ouvir (quem? onde?)."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use **cartões Wh-** e peça perguntas para cada resposta.","Treine a **ordem**: Wh + be + sujeito.","Erro típico: *“Where you are from?”* → *Where are you from?*"]}]}]}