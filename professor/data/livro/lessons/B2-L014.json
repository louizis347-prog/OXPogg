ocus","blocks":[{"type":"verbs","items":[{"v":"cancel","pt":"cancelar","forms":[["I / you / we / they cancel","They cancel the train."],["he / she / it cancels","Eles cancelam o trem."]]}]}]},{"tag":"Escuta e diálogo","title":"Conversation","blocks":[{"type":"dialog","title":"Conversation","lines":[["Stranger","Had you been waiting long?","Esperava há muito?"],["Marta","An hour. I’d been planning this trip for months.","Uma hora. Planejava essa viagem havia meses."],["Stranger","I can give you a ride.","Posso lhe dar uma carona."],["Marta","Thank you! That’s very kind.","Obrigada! É muito gentil."]]},{"type":"pron","title":"Pronúncia: Flap T americano","items":[{"label":"Flap T americano","note":"Pratique em voz alta.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Set the scene.","pt":"Prepare a cena.","model":"She had been waiting for an hour."},{"q":"Use a blessing in disguise.","pt":"Use.","model":"Losing the job was a blessing in disguise."},{"q":"Offer help.","pt":"Ofereça.","model":"I can give you a ride."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-line story using the Past Perfect Continuous.","model":"Marta had been waiting at the station for an hour when her train was cancelled. She had been planning the trip for months. A stranger offered her a ride. They talked for hours. Years later they married. The missed train was a blessing in disguise.","checklist":["Usei **had been + -ing**","Usei **a blessing in disguise**","História curta"],"words":"6 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “train station” mean?","opts":["trem cancelado","longa espera","estação de trem"],"ans":2,"why":"**train station** = estação de trem."},{"q":"What does “cancelled train” mean?","opts":["trem cancelado","anúncio da estação","oferta de um estranho"],"ans":0,"why":"**cancelled train** = trem cancelado."},{"q":"What does “station announcement” mean?","opts":["longa espera","anúncio da estação","carona"],"ans":1,"why":"**station announcement** = anúncio da estação."},{"q":"What does “long wait” mean?","opts":["oferta de um estranho","encontro casual","longa espera"],"ans":2,"why":"**long wait** = longa espera."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}