,"taxa de abstenção"],["personal liberty","liberdade pessoal"],["civic obligation","obrigação cívica"],["response timer","cronômetro de resposta"],["opinion prompt","enunciado de opinião"],["two-reason answer","resposta com duas razões"],["spoken fluency","fluência oral"],["delivery score","nota de entrega"],["topic development","desenvolvimento do tema"],["prep time","tempo de preparo"],["recording button","botão de gravação"],["rating rubric","rubrica de avaliação"],["pace control","controle de ritmo"],["self-correction","autocorreção"],["national election","eleição nacional"]]}]},{"tag":"Leitura","title":"Reading · An infographic","blocks":[{"type":"info","title":"Should Voting Be Mandatory?","items":[["A favor","**More people vote**, so results reflect the whole society"],["Contra","Forcing people **violates** personal freedom"],["Exemplo","In some countries, turnout is **above 90%** when voting is required"],["Opinião","I think voting should be encouraged, **not required**"]],"note":"Dica de fala: Opinião + 2 razões + 1 exemplo em 45 segundos.","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Mandatory voting can raise turnout above 90%.","ans":"T","why":"above 90%."},{"q":"The infographic says nobody opposes mandatory voting.","ans":"F","why":"Contra."},{"q":"The suggested speaking answer has opinion, reasons and example.","ans":"T","why":"Opinião + razões."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“violate” = ?","opts":["violar","violão","vigiar"],"ans":0,"why":"violate."},{"q":"“encourage” = ?","opts":["incentivar","encurralar","encurtar"],"ans":0,"why":"encourage."}]}]},{"tag":"Gramática","title":"Resposta de fala: opinião + razões + exemplo","blocks":[{"type":"table","head":["Parte","Frase-modelo"],"rows":[["opinião","In my opinion, voting should be…"],["razão 1","First, it helps raise awareness…"],["razão 2","Second, it respects freedom…"],["exemplo","For example, in Australia…"]],"cap":"Resposta de fala: opinião + razões + exemplo"},{"type":"box","kind":"look","t":"Regra","body":"No TOEFL Speaking, organize em **30–45 segundos**: opinião, duas razões, um exemplo. Use **raise awareness** para campanhas."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"In my ___ , voting should be encouraged. (opinion)","a":"opinion","why":"opinião."},{"s":"First, it helps ___ awareness. (raise)","a":"raise","why":"raise awareness."},{"s":"Forcing people ___ their freedom. (violate, present)","a":"violates","why":"verbo."},{"s":"For ___ , turnout is above 90%. (example)","a":"example","why":"exemplo."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["mandatory voting","voto obrigatório"],["compulsory turnout","comparecimento compulsório"],["fine for abstaining","multa por abstenção"],["voter reminder","lembrete ao eleitor"],["awareness drive","campanha de conscientização"]]},{"type":"order","title":"Put the words in order","items":[{"words":["first","Give","your","opinion"],"ans":"Give your opinion first","pt":"Dê sua opinião primeiro."},{"words":["voting","be","mandatory","Should"],"ans":"Should voting be mandatory","pt":"O voto deveria ser obrigatório?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"mandatory voting","pos":"word","pt":"voto obrigatório","ex":"Mandatory voting.","expt":"Voto obrigatório."},{"w":"compulsory turnout","pos":"word","pt":"comparecimento compulsório","ex":"Compulsory turnout.","expt":"Comparecimento compulsório."},{"w":"fine for abstaining","pos":"word","pt":"multa por abstenção","ex":"Fine for abstaining.","expt":"Multa por abstenção."},{"w":"voter reminder","pos":"word","pt":"lembrete ao eleitor","ex":"Voter reminder.","expt":"Lembrete ao eleitor."},{"w":"awareness drive","pos":"word","pt":"campanha de conscientização","ex":"Awareness drive.","expt":"Campanha de conscientização."},{"w":"abstention rate","pos":"word","pt":"taxa de abstenção","ex":"Abstention rate.","expt":"Taxa de abstenção."},{"w":"personal liberty","pos":"word","pt":"liberdade pessoal","ex":"Personal liberty.","expt":"Liberdade pessoal."},{"w":"civic obligation","pos":"word","pt":"obrigação cívica","ex":"Civic obligation.","expt":"Obrigação cívica."},{"w":"response timer","pos":"word","pt":"cronômetro de resposta","ex":"Response timer.","expt":"Cronômetro de resposta."},{"w":"opinion prompt","pos":"word","pt":"enunciado de opinião","ex":"Opinion prompt.","expt":"Enunciado de opinião."},{"w":"two-reason answer","pos":"word","pt":"resposta com duas razões","ex":"Two-reason answer.","expt":"Resposta com duas razões."},{"w":"spoken fluency","pos":"word","pt":"fluência oral","ex":"Spoken fluency.","expt":"Fluência oral."},{"w":"delivery score","pos":"word","pt":"nota de entrega","ex":"Delivery score.","expt":"Nota de entrega."},{"w":"topic development","pos":"word","pt":"desenvolvimento do tema","ex":"Topic development.","expt":"Desenvolvimento do tema."},{"w":"prep time","pos":"word","pt":"tempo de preparo","ex":"Prep time.","expt":"Tempo de preparo."},{"w":"recording button","pos":"word","pt":"botão de gravação","ex":"Recording button.","expt":"Botão de gravação."},{"w":"rating rubric","pos":"word","pt":"rubrica de avaliação","ex":"Rating rubric.","expt":"Rubrica de avaliação."},{"w":"pace control","pos":"word","pt":"controle de ritmo","ex":"Pace control.","expt":"Controle de ritmo."},{"w":"self-correction","pos":"word","pt":"autocorreção","ex":"Self-correction.","expt":"Autocorreção."},{"w":"national election","pos":"word","pt":"eleição nacional","ex":"National election.","expt":"Eleição nacional."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Raise awareness.** — Aumentar a conscientização.","**For the sake of.** — Em prol de.","**Weigh the pros and cons.** — Ponderar prós e contras.","**On balance.** — No geral.","**Make my point.** — Defender meu ponto.","**In a nutshell.** — Resumindo.","**Should voting be mandatory?** — O voto deveria ser obrigatório?","**Give your opinion first.** — Dê sua opinião primeiro.","**In my opinion, it should be encouraged, not required.** — Na minha opinião, deveria ser incentivado, não exigido."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"violate","pt":"violar","forms":[["I / you / we / they violate","That rule violates our rights."],["he / she / it violates","Essa regra viola nossos direitos."]]}]}]},{"tag":"Escuta e diálogo","title":"Speaking class","blocks":[{"type":"dialog","title":"Speaking class","lines":[["Student","Should voting be mandatory?","O voto deveria ser obrigatório?"],["Tutor","Give your opinion first.","Dê sua opinião primeiro."],["Student","In my opinion, it should be encouraged, not required.","Na minha opinião, deveria ser incentivado, não exigido."],["Tutor","Good. Now add two reasons and an example.","Bom. Agora acrescente duas razões e um exemplo."]]},{"type":"pron","title":"Pronúncia: Acento para enfatizar informação","items":[{"label":"Acento para enfatizar informação","note":"A palavra nova ou importante recebe o acento mais forte: I want the RED one, not the blue one.","words":["I want the RED one.","She said TUESDAY.","Not TWO, THREE.","He BOUGHT it."]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"State an opinion.","pt":"Dê opinião.","model":"In my opinion, voting should be encouraged."},{"q":"Give a reason.","pt":"Dê razão.","model":"First, it raises awareness."},{"q":"Give an example.","pt":"Dê exemplo.","model":"For example, some countries fine non-voters."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write your 45-second answer (5 sentences): opinion, two reasons, example.","model":"In my opinion, voting should be encouraged, not required. First, campaigns can raise awareness without forcing anyone. Second, personal freedom matters. For example, some countries fine people who do not vote, but many citizens resent it. That is why I prefer encouragement.","checklist":["Usei **opinião**","Usei **raise awareness**","Usei **exemplo**"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “mandatory voting” mean?","opts":["comparecimento compulsório","lembrete ao eleitor","voto obrigatório"],"ans":2,"why":"**mandatory voting** = voto obrigatório."},{"q":"What does “compulsory turnout” mean?","opts":["comparecimento compulsório","multa por abstenção","campanha de conscientização"],"ans":0,"why":"**compulsory turnout** = comparecimento compulsório."},{"q":"What does “fine for abstaining” mean?","opts":["lembrete ao eleitor","multa por abstenção","taxa de abstenção"],"ans":1,"why":"**fine for abstaining** = multa por abstenção."},{"q":"What does “voter reminder” mean?","opts":["campanha de conscientização","liberdade pessoal","lembrete ao eleitor"],"ans":2,"why":"**voter reminder** = lembrete ao eleitor."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["TOEFL Speaking Task 1: 15 s para planejar e 45 s para falar.","Estrutura: opinião, razão 1, razão 2, exemplo curto.","Fale em frases completas e sem pausas longas; corrija-se sem parar."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}