osta do vereador"],["municipal budget","orçamento municipal"],["maintenance backlog","atraso de manutenção"],["reference number","número de protocolo"],["photographic evidence","prova fotográfica"],["escalation route","via de recurso"],["ombudsman office","ouvidoria"],["neighbourhood safety","segurança do bairro"],["precise detail","detalhe preciso"],["firm tone","tom firme"],["courteous wording","redação cortês"],["follow-up call","ligação de acompanhamento"],["social work","serviço social"],["homework club","clube de tarefas"],["church hall","salão paroquial"],["community centre","centro comunitário"],["neighbourhood project","projeto de bairro"],["scholarship holder","bolsista"],["crowded flat","apartamento lotado"],["collective effort","esforço coletivo"],["local leader","liderança local"],["grassroots movement","movimento de base"],["social entrepreneur","empreendedor social"],["funding appeal","apelo por financiamento"],["after-school support","apoio extraescolar"],["counter-argument","contra-argumento"],["task achievement","cumprimento da tarefa"],["coherence mark","nota de coerência"],["lexical range","amplitude lexical"],["grammatical accuracy","precisão gramatical"],["timed writing","redação cronometrada"],["planning minute","minuto de planejamento"],["band descriptor","descritor de nota"],["to-what-extent prompt","to-what-extent prompt"]]},{"type":"vocab","items":[]},{"type":"box","kind":"culture","t":"Novas expressões da revisão","body":["**Do me a favor.** — Faça-me um favor.","**Not bad.** — Nada mal."]},{"type":"box","kind":"tip","t":"Estratégia","body":"Escolha **5 palavras** que ainda travam. Escreva uma frase **sua** com cada uma e diga em voz alta."}]},{"tag":"Verbos","title":"Verbs of the unit","blocks":[{"type":"table","head":["Verbo","Significado"],"rows":[["**reconcile**","conciliar"],["**criticise**","criticar"],["**request**","solicitar; pedir"],["**give**","dar; fazer; ceder"],["**specify**","especificar"],["**collect**","coletar; reunir"],