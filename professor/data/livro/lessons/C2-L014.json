acidental"],["observation","observação"],["experimental error","erro experimental"],["purification","purificação"],["mass production","produção em massa"],["wartime need","necessidade de guerra"],["clinical use","uso clínico"],["bacterial infection","infecção bacteriana"],["resistance","resistência"],["antibiotic resistance","resistência a antibióticos"],["shared prize","prêmio compartilhado"],["medical breakthrough","avanço médico"],["scientific paper","artigo científico"],["hospital laboratory","laboratório hospitalar"],["specimen","espécime"],["staining method","método de coloração"],["infection","infection"]]}]},{"tag":"Leitura","title":"Reading · A short biography","blocks":[{"type":"bio","name":"Alexander Fleming (1881–1955)","paras":["Alexander Fleming was a Scottish physician and microbiologist. In 1928, working at St Mary’s Hospital in London, he noticed that a **mould** had **contaminated** a **culture plate** and **inhibited** the bacteria around it. The mould, later identified as **Penicillium**, produced a substance he named **penicillin**.","Fleming **published** his observation in 1929 but could not purify the substance. Years later, **Howard Florey** and **Ernst Chain** developed it as a drug. The three shared the **Nobel Prize** in 1945."],"years":"1881–1955","facts":[["Born","Escócia"],["Discovery","penicilina (1928)"],["Prize","Nobel, 1945"]],"gloss":[["mould","mofo"],["culture plate","placa de cultura"],["purify","purificar"],["inhibit","inibir"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Fleming noticed a mould inhibiting bacteria.","ans":"T","why":"inhibited the bacteria."},{"q":"He alone developed penicillin as a drug.","ans":"F","why":"Florey and Chain."},{"q":"The three shared the Nobel Prize.","ans":"T","why":"1945."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“inhibit” = ?","opts":["inibir, impedir","inspirar","investir"],"ans":0,"why":"inhibit."},{"q":"“purify” = ?","opts":["purificar","pular","provar"],"ans":0,"why":"purify."}]}]},{"tag":"Gramática","title":"Linguagem de relato científico (biografia)","blocks":[{"type":"table","head":["Recurso","Exemplo"],"rows":[["passado simples","He **noticed** that a mould…"],["past perfect","A mould **had contaminated** the plate."],["verbos técnicos","**inhibit, isolate, purify, identify**"],["nominalização","**the identification** of the mould"]],"cap":"Linguagem de relato científico (biografia)"},{"type":"box","kind":"look","t":"Regra","body":"Biografias científicas narram **descoberta → obstáculos → reconhecimento**. O **past perfect** marca o que veio antes do fato central."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"A mould ___ contaminated the plate. (have, past perfect)","a":"had","why":"past perfect."},{"s":"It ___ the growth of bacteria. (inhibit, past)","a":"inhibited","why":"verbo técnico."},{"s":"He could not ___ the substance. (purify)","a":"purify","why":"verbo."},{"s":"The three scientists ___ the prize in 1945. (share, past)","a":"shared","why":"passado."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["microbiologist","microbiologista"],["culture plate","placa de cultura"],["bacterial colony","colônia bacteriana"],["mould contamination","contaminação por mofo"],["zone of inhibition","halo de inibição"]]},{"type":"order","title":"Put the words in order","items":[{"words":["Fleming","notice","What","did"],"ans":"What did Fleming notice","pt":"O que Fleming notou?"},{"words":["developed","the","drug","And","who"],"ans":"And who developed the drug","pt":"E quem desenvolveu o medicamento?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"microbiologist","pos":"word","pt":"microbiologista","ex":"Microbiologist.","expt":"Microbiologista."},{"w":"culture plate","pos":"word","pt":"placa de cultura","ex":"Culture plate.","