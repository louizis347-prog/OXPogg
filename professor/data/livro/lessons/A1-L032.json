itoral"],["radio","rádio"],["song","música (canção)"],["vacation","férias"],["shine","brilhar"],["enjoy","curtir"],["road","estrada"],["trip","viagem"],["sunset","pôr do sol"],["waiter","garçom"],["phone","celular"],["music","música"],["review","resenha"],["bring","trazer"],["sit","sentar"],["quiet","silencioso"],["bike","bicicleta"],["ride","andar (de bike)"],["corner","esquina"],["empty","vazio"],["fast","rápido"],["laugh","rir"],["wait","esperar"],["arrive","chegar"],["dishes","louça"],["laundry","roupa suja"],["homework","lição de casa"],["housework","serviço doméstico"],["fair","justo"],["tidy","arrumado"],["best","melhor"],["share","dividir"],["commute","trajeto diário"],["worker","trabalhador"],["lane","faixa"],["popular","popular"],["however","porém"],["travel","viajar"],["build","construir"],["month","mês"],["subject","sujeito"],["object","objeto"],["action","ação"],["example","exemplo"],["order","ordem"],["sentence","frase"],["read","ler"],["watch","assistir"],["brain","cérebro"],["energy","energia"],["habit","hábito"],["routine","rotina"],["life","vida"],["save","economizar"],["remember","lembrar"],["really","realmente"],["playground","parquinho"],["lake","lago"],["tree","árvore"],["mayor","prefeito"],["space","espaço"],["visitor","visitante"],["next","próximo"],["yet","ainda"],["assistant","assistente"],["farm","fazenda"],["cookbook","livro de receitas"],["kitchen","cozinha"],["show","programa"],["north","norte"],["free","livre"],["small","pequeno"]]},{"type":"box","kind":"tip","t":"Estratégia","body":"Escolha **5 palavras** que ainda travam. Escreva uma frase **sua** com cada uma e diga em voz alta."}]},{"tag":"Verbos","title":"Verbs of the unit","blocks":[{"type":"table","head":["Verbo","Significado"],"rows":[["**walk**","andar"],["**make**","fazer, criar"],["**run**","correr"],["**drive**","dirigir"],["**ride**","andar de (bike, cavalo)"],["**do**","fazer"],["**travel**","viajar"],["**arrive**","chegar"]],"cap":"Verbos vistos nesta unidade"},{"type":"