","bank":null,"items":[{"s":"I ___ Spanish since 2018. (use, PP)","a":"have used","why":"since."},{"s":"I ___ my partner in Madrid. (meet, past)","a":"met","why":"Past Simple."},{"s":"How much ___ you improved? (have)","a":"have","why":"PP."},{"s":"Last month I ___ a talk. (give, past)","a":"gave","why":"Past Simple."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["language podcast","podcast de idiomas"],["daily practice","prática diária"],["language partner","parceiro de idioma"],["guest speaker","palestrante convidado"],["study routine","rotina de estudo"]]},{"type":"order","title":"Put the words in order","items":[{"words":["gave","a","talk","in","Spanish","I"],"ans":"I gave a talk in Spanish","pt":"Dei uma palestra em espanhol."},{"words":["you","do","last","month","What","did"],"ans":"What did you do last month","pt":"O que fez mês passado?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"language podcast","pos":"word","pt":"podcast de idiomas","ex":"Language podcast.","expt":"Podcast de idiomas."},{"w":"study routine","pos":"word","pt":"rotina de estudo","ex":"Study routine.","expt":"Rotina de estudo."},{"w":"language journey","pos":"word","pt":"jornada com o idioma","ex":"Language journey.","expt":"Jornada com o idioma."},{"w":"short talk","pos":"word","pt":"palestra curta","ex":"Short talk.","expt":"Palestra curta."},{"w":"keep practicing","pos":"word","pt":"continuar praticando","ex":"Keep practicing.","expt":"Continuar praticando."},{"w":"big improvement","pos":"word","pt":"grande melhora","ex":"Big improvement.","expt":"Grande melhora."},{"w":"study trip","pos":"word","pt":"viagem de estudos","ex":"Study trip.","expt":"Viagem de estudos."},{"w":"language app","pos":"word","pt":"aplicativo de idiomas","ex":"Language app.","expt":"Aplicativo de idiomas."},{"w":"vocabulary list","pos":"word","pt":"lista de vocabulário","ex":"Vocabulary list.","expt":"Lista de vocabulário."},{"w":"listen