ft","minuta de contrato"],["initial page","página rubricada"],["cold feet","receio de última hora"],["nervous laugh","riso nervoso"],["awkward pause","pausa constrangedora"],["sketch artist","sketch artist"],["signing order","signing order"],["lawyer’s veto","lawyer’s veto"],["half-endorsement","half-endorsement"]]}]},{"tag":"Leitura","title":"Reading · A comic strip","blocks":[{"type":"comic","title":"Who Signs First?","panels":[{"scene":"🖊️","bubbles":[["Ines","I will sign if you will."],["Theo","I would, but my lawyer won’t let me."]],"cap":"Panel 1"},{"scene":"📄","bubbles":[["Ines","Then ask her to. She endorsed the plan last week."],["Theo","She did, but only the first half."]],"cap":"Panel 2"},{"scene":"😅","bubbles":[["Ines","So who signs first?"],["Theo","You can, if you want to… or I can… or neither of us does."]],"cap":"Panel 3"}],"gloss":[],"say":""}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Ines will sign if Theo will.","ans":"T","why":"if you will."},{"q":"The lawyer endorsed the whole plan.","ans":"F","why":"only the first half."},{"q":"Theo is eager to sign first.","ans":"NG","why":"Texto não diz."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“endorse” = ?","opts":["apoiar, endossar","adormecer","terminar"],"ans":0,"why":"endorse = endossar."},{"q":"“I would, but my lawyer won’t” omite ?","opts":["sign","the plan","Ines"],"ans":0,"why":"I would (sign)."}]}]},{"tag":"Gramática","title":"Elipse × substituição × repetição","blocks":[{"type":"table","head":["Recurso","Exemplo","Quando"],"rows":[["elipse","I will sign if you **will**.","auxiliar basta"],["do so","She tried to settle and **did so** quickly.","retoma ação, formal"],["one / ones","The first offer was better than the second **one**.","retoma substantivo"],["repetição","I **want to sign**, but not **sign first**.","quando evita ambiguidade"]],"cap":"Elipse × substituição × repetição"},{"type":"box","kind":"look","t":"Regra","body":"Se omitir deixar a frase **ambígua**, use *do so*, *one* ou repita. Elipse é natural na fala; textos formais preferem *do so*."},{"type":"box","kind":"warn","t":"Cuidado","body":"*Do so* não pode retomar estados: *She is tired and does so* ✗."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"I will sign if you ___ . (will)","a":"will","why":"elipse do verbo."},{"s":"She endorsed the plan; I did ___ too. (so)","a":"so","why":"do so."},{"s":"The first draft was better than the second ___ . (one)","a":"one","why":"substituição."},{"s":"He didn’t want to sign, but I ___ . (do, present)","a":"did","why":"elipse; veja o tempo da primeira oração."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["endorse a plan","endossar um plano"],["sign first","assinar primeiro"],["binding signature","assinatura vinculante"],["lawyer’s advice","conselho jurídico"],["first half","primeira metade"]]},{"type":"order","title":"Put the words in order","items":[{"words":["but","only","half","She","did"],"ans":"She did but only half","pt":"Endossou, mas só metade."},{"words":["me","I","would","if","she","let"],"ans":"I would if she let me","pt":"Assinaria, se ela deixasse."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"endorse a plan","pos":"word","pt":"endossar um plano","ex":"Endorse a plan.","expt":"Endossar um plano."},{"w":"sign first","pos":"word","pt":"assinar primeiro","ex":"Sign first.","expt":"Assinar primeiro."},{"w":"binding signature","pos":"word","pt":"assinatura vinculante","ex":"Binding signature.","expt":"Assinatura vinculante."},{"w":"lawyer’s advice","pos":"word","pt":"conselho jurídico","ex":"Lawyer’s advice.","expt":"Conselho jurídico."},{"w":"first half","pos":"word","pt":"primeira metade","ex":"First half.","expt":"Primeira metade."},{"w":"running gag","pos":"word","pt":"piada recorrente","ex":"Running gag.","