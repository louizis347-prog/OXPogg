eck yourself","items":[{"q":"What does “coach” mean?","opts":["torneio","tênis","treinar"],"ans":2,"why":"**coach** = treinar."},{"q":"What does “tournament” mean?","opts":["torneio","taça","tênis"],"ans":0,"why":"**tournament** = torneio."},{"q":"What does “cup” mean?","opts":["treinar","taça","verão"],"ans":1,"why":"**cup** = taça."},{"q":"What does “train” mean?","opts":["verão","criança","treinar"],"ans":2,"why":"**train** = treinar."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}