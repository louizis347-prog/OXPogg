]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Dana trains for two hours.","ans":"T","why":"“for two hours.”"},{"q":"She coaches on Sundays.","ans":"F","why":"Saturdays."},{"q":"She won her first cup in 2015.","ans":"T","why":"“in 2015.”"}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“coach” means…","opts":["treinar/técnico","jogador","juiz"],"ans":0,"why":"coach."},{"q":"“tournament” means…","opts":["torneio","treino","aula"],"ans":0,"why":"tournament."}]}]},{"tag":"Gramática","title":"Time prepositions: contrast","blocks":[{"type":"table","head":["Preposição","Exemplo"],"rows":[["**at**","at night, at six"],["**on**","on Saturdays, on May 5"],["**in**","in the morning, in 2015"],["**from … to**","from nine to five"],["**for**","for two hours (duração)"]],"cap":"Time prepositions: contrast"},{"type":"box","kind":"look","t":"Regra","body":"**for** = duração; **since** = desde (A2). *for two hours* ≠ *in two hours*."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"She trains ___ two hours. (for)","a":"for","why":"duração."},{"s":"She coaches ___ Saturdays. (on)","a":"on","why":"dia."},{"s":"She won ___ 2015. (in)","a":"in","why":"ano."},{"s":"I work ___ nine to five. (from)","a":"from","why":"from…to."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["coach","treinar"],["tournament","torneio"],["cup","taça"],["tennis","tênis"],["summer","verão"]]},{"type":"order","title":"Put the words in order","items":[{"words":["hours","For","two"],"ans":"For two hours","pt":"Duas horas."},{"words":["you","train","How","long","do"],"ans":"How long do you train","pt":"Quanto tempo treina?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"coach","pos":"word","pt":"treinar","ex":"She coaches kids.","expt":"Ela treina crianças."},{"w":"tournament","pos":"word","pt"