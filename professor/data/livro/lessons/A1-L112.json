ensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Most students bring a notebook.","ans":"T","why":"notebook and phone."},{"q":"Many bring a dictionary.","ans":"F","why":"Few."},{"q":"Preparation brings confidence.","ans":"T","why":"brings confidence."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“confidence” means…","opts":["confiança","confusão","coragem só"],"ans":0,"why":"confidence."},{"q":"“conclude” means…","opts":["concluir","começar","explicar"],"ans":0,"why":"conclude."}]}]},{"tag":"Gramática","title":"Key verb: bring","blocks":[{"type":"table","head":["Uso","Exemplo"],"rows":[["trazer/levar","**Bring a notebook.**"],["causar","**Preparation brings confidence.**"],["bring up","**Don’t bring up the past.**"],["bring × take","**bring** = em direção a mim; **take** = para longe"]],"cap":"Key verb: bring"},{"type":"box","kind":"look","t":"Regra","body":"Irregular: **bring – brought – brought**."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"I ___ a notebook to class. (bring)","a":"bring","why":"bring."},{"s":"She ___ snacks. (bring)","a":"brings","why":"she → brings."},{"s":"Students who prepare ___ it. (enjoy)","a":"enjoy","why":"enjoy."},{"s":"Preparation ___ confidence. (bring)","a":"brings","why":"causa."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["notebook","caderno"],["preparation","preparação"],["confidence","confiança"],["snack","lanche"],["dictionary","dicionário"]]},{"type":"order","title":"Put the words in order","items":[{"words":["I","bring","snacks","Can"],"ans":"Can I bring snacks","pt":"Posso levar lanches?"},{"words":["enjoy","snacks","Sure","I"],"ans":"Sure I enjoy snacks","pt":"Claro, adoro lanches!"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"notebook","pos":"word","pt":"caderno","ex":"A new notebook.","expt":"Um caderno novo."},