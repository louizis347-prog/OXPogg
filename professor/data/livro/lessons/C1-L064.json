],["speaking script","roteiro de fala"],["clear articulation","articulação clara"],["spoken abstract","resumo falado"],["intonation unit","unidade de entonação"],["syllable stress","acento silábico"],["pitch drop","queda de entonação"],["listener comprehension","compreensão do ouvinte"],["talk pacing","talk pacing"],["pause marker","pause marker"],["rhythm drill","rhythm drill"]]}]},{"tag":"Leitura","title":"Reading · An academic text (read aloud)","blocks":[{"type":"text","title":"Abstract: Rhythm in Academic Speech","paras":["In academic talks, | speakers who pause | between thought groups | are understood better. | Stress falls on content words, | while function words | are reduced.","A pause before a key term | draws attention to it; | a pause after it | lets the audience absorb the idea."],"kicker":"ABSTRACT","by":"Journal of Spoken Discourse","gloss":[["thought group","grupo de sentido"],["absorb","absorver"],["reduce","reduzir"],["key term","termo-chave"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Speakers who pause are understood better.","ans":"T","why":"understood better."},{"q":"Function words get the main stress.","ans":"F","why":"content words."},{"q":"A pause after a key term helps the audience absorb it.","ans":"T","why":"absorb the idea."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“thought group” = ?","opts":["grupo de sentido","grupo de pensadores","pensamento grupal"],"ans":0,"why":"between thought groups."},{"q":"“absorb” = ?","opts":["absorver","absolver","abordar"],"ans":0,"why":"absorb the idea."}]}]},{"tag":"Gramática","title":"Pausas e ritmo no inglês acadêmico","blocks":[{"type":"table","head":["Elemento","Regra","Exemplo"],"rows":[["grupo de sentido","4–7 palavras, uma ideia","**In academic talks | speakers pause**"],["palavras de conteúdo","recebem o acento","**ACAdemic TALKS**"],["palavras funcionais","são reduzidas","**to /tə/, of /əv/**"],["pausa antes do termo-chave","cria expectativa","**The | key term | is…**"]],"cap":"Pausas e ritmo no inglês acadêmico"},{"type":"box","kind":"look","t":"Regra","body":"O inglês tem ritmo **por acento** (stress-timed): as sílabas fortes ocorrem em intervalos regulares; as fracas são comprimidas. Marque pausas com **|** antes de ler."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Pause between thought ___ . (groups)","a":"groups","why":"grupos de sentido."},{"s":"Stress falls on ___ words. (content)","a":"content","why":"palavras de conteúdo."},{"s":"Function words are ___ . (reduced)","a":"reduced","why":"reduzidas."},{"s":"A pause draws ___ to a key term. (attention)","a":"attention","why":"efeito."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["speech rhythm","ritmo da fala"],["thought-group boundary","fronteira de grupo de sentido"],["content word","palavra de conteúdo"],["function word","palavra funcional"],["pause length","duração da pausa"]]},{"type":"order","title":"Put the words in order","items":[{"words":["stressed","Which","words","are"],"ans":"Which words are stressed","pt":"Quais palavras são acentuadas?"},{"words":["in","this","sentence","Where","do","I","pause"],"ans":"Where do I pause in this sentence","pt":"Onde faço pausa nesta frase?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"thought-group boundary","pos":"word","pt":"fronteira de grupo de sentido","ex":"Thought-group boundary.","expt":"Fronteira de grupo de sentido."},{"w":"pause length","pos":"word","pt":"duração da pausa","ex":"Pause length.","expt":"Duração da pausa."},{"w":"stress-timed language","pos":"word","pt":"língua de ritmo por acento","ex":"Stress-timed language.","expt":"Língua de ritmo por acento."},{"w":"syllable reduction","pos":"word","pt":"redução de sílabas","ex":"Syllable reduction.","expt":"Redução de sílabas."},{"w":"academic delivery