ver","why":"nunca."},{"s":"She has worked ___ 20 years. (for)","a":"for","why":"duração."},{"s":"She has lived there ___ 2004. (since)","a":"since","why":"início."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["chef career","carreira de chef"],["three restaurants","três restaurantes"],["two cookbooks","dois livros de receitas"],["national prize","prêmio nacional"],["busy kitchen","cozinha movimentada"]]},{"type":"order","title":"Put the words in order","items":[{"words":["twenty","years","For"],"ans":"For twenty years","pt":"Há vinte anos."},{"words":["ever","closed","on","Sunday","Have","you"],"ans":"Have you ever closed on Sunday","pt":"Já fechou num domingo?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"chef career","pos":"word","pt":"carreira de chef","ex":"A chef career.","expt":"Uma carreira de chef."},{"w":"three restaurants","pos":"word","pt":"três restaurantes","ex":"Three restaurants.","expt":"Três restaurantes."},{"w":"two cookbooks","pos":"word","pt":"dois livros de receitas","ex":"Two cookbooks.","expt":"Dois livros de receitas."},{"w":"national prize","pos":"word","pt":"prêmio nacional","ex":"A national prize.","expt":"Um prêmio nacional."},{"w":"busy kitchen","pos":"word","pt":"cozinha movimentada","ex":"A busy kitchen.","expt":"Uma cozinha movimentada."},{"w":"twenty years","pos":"word","pt":"vinte anos","ex":"Twenty years.","expt":"Vinte anos."},{"w":"Sunday lunch","pos":"word","pt":"almoço de domingo","ex":"Sunday lunch.","expt":"Almoço de domingo."},{"w":"kitchen team","pos":"word","pt":"equipe de cozinha","ex":"A kitchen team.","expt":"Uma equipe de cozinha."},{"w":"menu change","pos":"word","pt":"mudança de cardápio","ex":"A menu change.","expt":"Uma mudança de cardápio."},{"w":"food award","pos":"word","pt":"prêmio de gastronomia","ex":"A food award.","expt":"Um prêmio de gastronomia."},{"w":"family restaurant","pos":"word","pt":"restaurante familiar","ex":"A family restaurant.","expt":"Um restaurante familiar."},{"w":"daily special","pos":"word","pt":"prato do dia","ex":"The daily special.","expt":"O prato do dia."},{"w":"young cook","pos":"word","pt":"jovem cozinheira","ex":"A young cook.","expt":"Uma jovem cozinheira."},{"w":"learning curve","pos":"word","pt":"curva de aprendizado","ex":"A learning curve.","expt":"Uma curva de aprendizado."},{"w":"proud mother","pos":"word","pt":"mãe orgulhosa","ex":"A proud mother.","expt":"Uma mãe orgulhosa."},{"w":"cooking prize","pos":"word","pt":"cooking prize","ex":"prêmio de culinária","expt":"Cooking prize."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**I’ve never looked back.** — Nunca olhei para trás.","**It’s been a while.** — Faz tempo.","**For the time being.** — Por enquanto.","**For twenty years.** — Há vinte anos.","**Have you ever closed on Sunday?** — Já fechou num domingo?","**No, never.** — Não, nunca.","**For sure.** — Com certeza."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"cheer","pt":"torcer","forms":[["I / you / we / they cheer","We cheer loudly."],["he / she / it cheers","He cheers for his team."]]}]}]},{"tag":"Escuta e diálogo","title":"Interview","blocks":[{"type":"dialog","title":"Interview","lines":[["Reporter","How long have you worked as a chef?","Há quanto tempo é chef?"],["Ana","For twenty years.","Há vinte anos."],["Reporter","Have you ever closed on Sunday?","Já fechou num domingo?"],["Ana","No, never.","Não, nunca."]]},{"type":"pron","title":"Pronúncia: gonna e wanna (reconhecimento)","items":[{"label":"gonna e wanna (reconhecimento)","note":"Na fala: going to → gonna, want to → wanna. Reconheça; na escrita use a forma completa.","words":["I’m gonna go","I wanna eat","What are you gonna do?"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say how long you have done something.","pt":"Diga.","model":"I have studied English for two years."