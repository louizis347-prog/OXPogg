":"match","title":"Match the word to its meaning","pairs":[["course review","resenha do curso"],["ten weeks","dez semanas"],["Friday test","prova de sexta"],["class notes","anotações de aula"],["evening group","turma da noite"]]},{"type":"order","title":"Put the words in order","items":[{"words":["ten","weeks","About"],"ans":"About ten weeks","pt":"Cerca de dez semanas."},{"words":["you","take","notes","Do"],"ans":"Do you take notes","pt":"Você faz anotações?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"ten weeks","pos":"word","pt":"dez semanas","ex":"Ten weeks.","expt":"Dez semanas."},{"w":"Friday test","pos":"word","pt":"prova de sexta","ex":"Friday test.","expt":"Prova de sexta."},{"w":"evening group","pos":"word","pt":"turma da noite","ex":"Evening group.","expt":"Turma da noite."},{"w":"homework load","pos":"word","pt":"carga de tarefas","ex":"Homework load.","expt":"Carga de tarefas."},{"w":"study effort","pos":"word","pt":"esforço de estudo","ex":"Study effort.","expt":"Esforço de estudo."},{"w":"course price","pos":"word","pt":"preço do curso","ex":"Course price.","expt":"Preço do curso."},{"w":"teacher advice","pos":"word","pt":"conselho do professor","ex":"Teacher advice.","expt":"Conselho do professor."},{"w":"learning pace","pos":"word","pt":"ritmo de aprendizagem","ex":"Learning pace.","expt":"Ritmo de aprendizagem."},{"w":"weekly quiz","pos":"word","pt":"teste semanal","ex":"Weekly quiz.","expt":"Teste semanal."},{"w":"course material","pos":"word","pt":"material do curso","ex":"Course material.","expt":"Material do curso."},{"w":"student review","pos":"word","pt":"avaliação de aluno","ex":"Student review.","expt":"Avaliação de aluno."},{"w":"class size","pos":"word","pt":"tamanho da turma","ex":"Class size.","expt":"Tamanho da turma."},{"w":"final grade","pos":"word","pt":"nota final","ex":"Final grade.","expt":"Nota final."},{"w":"worth the money","pos":"word","pt":"vale o dinheiro","ex":"Worth t