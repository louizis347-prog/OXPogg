alogue","da tensão ao diálogo"],["calm temperament","temperamento calmo"],["trust on both sides","confiança dos dois lados"],["assumption trap","armadilha da suposição"],["language coach","instrutor de idiomas"],["simultaneous interpreting","interpretação simultânea"],["consecutive interpreting","interpretação consecutiva"],["cultural briefing","orientação cultural"],["diplomatic tact","tato diplomático"],["intercultural career","carreira intercultural"],["interpreter booth","cabine de intérprete"],["glossary list","lista de glossário"],["terminology","terminologia"],["dual identity","identidade dupla"],["ethical interpreting","interpretação ética"],["career pivot","mudança de carreira"],["working languages","idiomas de trabalho"]]}]},{"tag":"Leitura","title":"Reading · A biography","blocks":[{"type":"bio","name":"Camila Duarte (fictional)","paras":["Camila Duarte, a fictional interpreter and mediator, **was inclined to** study languages from childhood. **Having grown up** between two cultures, she **tends to** notice what others overlook. **Not only did** she translate negotiations, **but she also** coached executives on etiquette.","**What she does best is** to turn tension into dialogue. **It was** her calm **that** earned trust on both sides. **Asked** about her method, she says: “**Never** assume; **only by** asking do we understand.”"],"years":"b. 1978","facts":[["Job","intérprete e mediadora"],["Languages","4"],["Method","perguntar antes de supor"]],"gloss":[["interpreter","intérprete"],["mediator","mediadora"],["etiquette","etiqueta"],["overlook","não perceber"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Camila grew up in a single culture.","ans":"F","why":"between two cultures."},{"q":"She also coached executives.","ans":"T","why":"coached executives."},{"q":"Her method is to assume.","ans":"F","why":"Never assume."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“interpreter” = ?","opts":["intérprete","interprete só","interno"],"ans":0,"why":"interpreter."},{"q":"“overlook” = ?","opts":["não perceber","olhar por cima","vigiar"],"ans":0,"why":"overlook."}]}]},{"tag":"Gramática","title":"Biografia: estruturas combinadas","blocks":[{"type":"table","head":["Estrutura","Exemplo"],"rows":[["be inclined to / tend to","**She tends to notice what others overlook.**"],["particípio perfeito","**Having grown up between cultures, she…**"],["Not only did… but also","**Not only did she translate, but she also coached.**"],["pseudo-clivada","**What she does best is to turn tension into dialogue.**"]],"cap":"Biografia: estruturas combinadas"},{"type":"box","kind":"look","t":"Regra","body":"Em biografias C1, varie estruturas: tendência, particípio, ênfase e pseudo-clivada."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"She tends ___ notice what others overlook. (to)","a":"to","why":"tend to."},{"s":"___ grown up between cultures, she is bilingual. (Having)","a":"Having","why":"particípio perfeito."},{"s":"Not only ___ she translate, but she also coached. (did)","a":"did","why":"inversão."},{"s":"What she does best ___ to turn tension into dialogue. (is)","a":"is","why":"pseudo-cleft."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["conference interpreter","intérprete de conferência"],["cultural mediator","mediador cultural"],["bilingual upbringing","criação bilíngue"],["etiquette coaching","coaching de etiqueta"],["negotiation interpreter","intérprete de negociação"]]},{"type":"order","title":"Put the words in order","items":[{"words":["others","overlook","What"],"ans":"What others overlook","pt":"O que os outros deixam passar."},{"words":["she","do","best","What","does"],"ans":"What does she do best","pt":"O que ela faz melhor?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"conference interpreter","pos":"word","pt":"intérprete de conferência","ex":"Conference interpreter.","expt":"Intérprete de conferência."},{"w":"cultural mediator","pos":"word","pt":"mediador cultural","ex":"Cultural mediator.","expt":"Mediador cultural."},{"w":"bilingual upbringing","pos":"word","pt":"criação bilíngue","ex":"Bilingual upbringing.","expt":"Criação bilíngue."},{"w":"etiquette coaching","pos":"word","pt":"coaching de etiqueta","ex":"Etiquette coaching.","expt":"Coaching de etiqueta."},{"w":"negotiation interpreter","pos":"word","pt":"intérprete de negociação","ex":"Negotiation interpreter.","expt":"Intérprete de negociação."},{"w":"tension to dialogue","pos":"word","pt":"da tensão ao diálogo","ex":"Tension to dialogue.","expt":"Da tensão ao diálogo."},{"w":"calm temperament","pos":"word","pt":"temperamento calmo","ex":"Calm temperament.","expt":"Temperamento calmo."},{"w":"trust on both sides","pos":"word","pt":"confiança dos dois lados","ex":"Trust on both sides.","expt":"Confiança dos dois lados."},{"w":"assumption trap","pos":"word","pt":"armadilha da suposição","ex":"Assumption trap.","expt":"Armadilha da suposição."},{"w":"language coach","pos":"word","pt":"instrutor de idiomas","ex":"Language coach.","expt":"Instrutor de idiomas."},{"w":"simultaneous interpreting","pos":"word","pt":"interpretação simultânea","ex":"Simultaneous interpreting.","expt":"Interpretação simultânea."},{"w":"consecutive interpreting","pos":"word","pt":"interpretação consecutiva","ex":"Consecutive interpreting.","expt":"Interpretação consecutiva."},{"w":"cultural briefing","pos":"word","pt":"orientação cultural","ex":"Cultural briefing.","expt":"Orientação cultural."},{"w":"diplomatic tact","pos":"word","pt":"tato diplomático","ex":"Diplomatic tact.","expt":"Tato diplomático."},{"w":"intercultural career","pos":"word","pt":"carreira intercultural","ex":"Intercultural career.","expt":"Carreira intercultural."},{"w":"interpreter booth","pos":"word","pt":"cabine de intérprete","ex":"Interpreter booth.","expt":"Cabine de intérprete."},{"w":"glossary list","pos":"word","pt":"lista de glossário","ex":"Glossary list.","expt":"Lista de glossário."},{"w":"terminology","pos":"word","pt":"terminologia","ex":"Terminology.","expt":"Terminologia."},{"w":"dual identity","pos":"word","pt":"identidade dupla","ex":"Dual identity.","expt":"Identidade dupla."},{"w":"ethical interpreting","pos":"word","pt":"interpretação ética","ex":"Ethical interpreting.","expt":"Interpretação ética."},{"w":"career pivot","pos":"word","pt":"mudança de carreira","ex":"Career pivot.","expt":"Mudança de carreira."},{"w":"working languages","pos":"word","pt":"idiomas de trabalho","ex":"Working languages.","expt":"Idiomas de trabalho."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Bridge the gap.** — Cobrir a distância.","**Walk a fine line.** — Andar na corda bamba.","**Keep a straight face.** — Manter a seriedade.","**Make oneself understood.** — Fazer-se entender.","**Speak with one voice.** — Falar a uma só voz.","**Mind one’s manners.** — Cuidar das maneiras.","**When in Rome, do as the Romans do.** — Onde estiver, faça como vir.","**Break the language barrier.** — Quebrar a barreira do idioma.","**What is Camila Duarte inclined to notice?** — O que Camila Duarte tende a notar?","**What others overlook.** — O que os outros deixam passar.","**What does she do best?** — O que ela faz melhor?"]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"mediate","pt":"mediar","forms":[["I / you / we / they mediate","She mediates disputes."],["he / she / it mediates","Ela media disputas."]]}]}]},{"tag":"Escuta e diálogo","title":"Profile talk","blocks":[{"type":"dialog","title":"Profile talk","lines":[["Ana","What is Camila Duarte inclined to notice?","O que Camila Duarte tende a notar?"],["Leo","What others overlook.","O que os outros deixam passar."],["Ana","What does she do best?","O que ela faz melhor?"],["Leo","What she does best is to turn tension into dialogue.","O que ela faz melhor é transformar tensão em diálogo."]]},{"type":"pron","title":"Pronúncia: Pausas e ritmo","items":[{"label":"Pausas e ritmo","note":"Faça pausas curtas entre grupos de sentido (thought groups) e mantenha o ritmo: sílabas fortes em intervalos regulares, fracas comprimidas.","words":["In my view, | the plan | is sound.","Having reviewed the data, | we agreed."]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Describe a tendency.","pt":"Descreva.","model":"I tend to listen first."},{"q":"Use having + participle.","pt":"Use.","model":"Having lived abroad, I speak two languages."},{"q":"Use a pseudo-cleft.","pt":"Use.","model":"What I do is mediate."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write an 8-sentence biography of an interpreter or mediator using tend to, having + participle, not only… but also and a pseudo-cleft.","model":"Camila Duarte is a fictional interpreter and mediator. Having grown up between two cultures, she tends to notice what others overlook. Not only did she translate negotiations, but she also coached executives on etiquette. What she does best is to turn tension into dialogue. It was her calm that earned trust on both sides. Asked about her method, she says: never assume. Only by asking do we understand. She continues to build bridges.","checklist":["Usei **tend to**","Usei **having + particípio**","8 frases"],"words":"8 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “conference interpreter” mean?","opts":["intérprete de conferência","mediador cultural","coaching de etiqueta"],"ans":0,"why":"**conference interpreter** = intérprete de conferência."},{"q":"What does “cultural mediator” mean?","opts":["criação bilíngue","mediador cultural","intérprete de negociação"],"ans":1,"why":"**cultural mediator** = mediador cultural."},{"q":"What does “bilingual upbringing” mean?","opts":["coaching de etiqueta","briefing executivo","criação bilíngue"],"ans":2,"why":"**bilingual upbringing** = criação bilíngue."},{"q":"What does “etiquette coaching” mean?","opts":["coaching de etiqueta","intérprete de negociação","da tensão ao diálogo"],"ans":0,"why":"**etiquette coaching** = coaching de etiqueta."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}