on","photograph","photography","develop","different"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Imagine with If I had…","pt":"Imagine.","model":"If I had time, I would travel."},{"q":"Give advice with If I were you.","pt":"Aconselhe.","model":"If I were you, I would apply."},{"q":"Say you are not used to it.","pt":"Diga.","model":"I’m not used to the cold."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences with the Second Conditional.","model":"If I had more time, I would study design. If I earned more, I would travel. If I were the boss, I would listen. If you called me, I would answer. If I were you, I would apply.","checklist":["Usei **if + Past Simple**","Usei **would**","5 frases"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “dream job” mean?","opts":["emprego dos sonhos","escolha de emprego","salário maior"],"ans":0,"why":"**dream job** = emprego dos sonhos."},{"q":"What does “job choice” mean?","opts":["trabalho noturno","escolha de emprego","mudança de carreira"],"ans":1,"why":"**job choice** = escolha de emprego."},{"q":"What does “night work” mean?","opts":["salário maior","cargo de chefe","trabalho noturno"],"ans":2,"why":"**night work** = trabalho noturno."},{"q":"What does “higher salary” mean?","opts":["salário maior","mudança de carreira","tempo livre"],"ans":0,"why":"**higher salary** = salário maior."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}