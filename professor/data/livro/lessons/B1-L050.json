,"laço entre irmãos"],["regret scene","cena de arrependimento"]]}]},{"tag":"Leitura","title":"Reading · A review","blocks":[{"type":"text","title":"Review: “The Missed Call” (film) ★★★☆☆","paras":["In this drama, a man **should have called** his brother, but he forgot. The brother **must have felt** alone. He **might have waited** all night, or he **could have gone** out.","The ending is unclear: the brother **can’t have known** the truth. I **would have preferred** a clearer ending."],"kicker":"FILM REVIEW","by":"Cinema Club","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The man should have called his brother.","ans":"T","why":"should have called."},{"q":"The brother must have felt happy.","ans":"F","why":"alone."},{"q":"The reviewer wanted a clearer ending.","ans":"T","why":"clearer ending."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“should have” = ?","opts":["deveria ter","deve ter só","poderia ter"],"ans":0,"why":"should have."},{"q":"“drama” = ?","opts":["drama","dramaturgo","trama"],"ans":0,"why":"drama."}]}]},{"tag":"Gramática","title":"Modal + have + participle","blocks":[{"type":"table","head":["Forma","Sentido","Exemplo"],"rows":[["must have + part.","certeza (passado)","**He must have felt alone.**"],["might/could have + part.","possibilidade","**He might have waited.**"],["can’t have + part.","impossibilidade","**He can’t have known.**"],["should have + part.","crítica/arrependimento","**He should have called.**"]],"cap":"Modal + have + participle"},{"type":"box","kind":"look","t":"Regra","body":"Depois de **have**, use o **particípio**: *must have gone* (✗ *must have went*)."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"He ___ have called. (should)","a":"should","why":"crítica."},{"s":"She must have ___ alone. (feel, part.)","a":"felt","why":"particípio."},{"s":"He might have ___ all night. (wait, part.)","a":"waited","why":"particípio."},{"s":"He can’t ___ known. (have)","a":"have","why":"can’t have."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["film drama","drama de cinema"],["missed call","ligação perdida"],["older brother","irmão mais velho"],["lonely night","noite solitária"],["unclear ending","final nebuloso"]]},{"type":"order","title":"Put the words in order","items":[{"words":["called","him","I","would","have"],"ans":"I would have called him","pt":"Eu teria ligado."},{"words":["all","night","He","might","have","waited"],"ans":"He might have waited all night","pt":"Ele pode ter esperado a noite toda."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"film drama","pos":"word","pt":"drama de cinema","ex":"Film drama.","expt":"Drama de cinema."},{"w":"missed call","pos":"word","pt":"ligação perdida","ex":"Missed call.","expt":"Ligação perdida."},{"w":"older brother","pos":"word","pt":"irmão mais velho","ex":"Older brother.","expt":"Irmão mais velho."},{"w":"lonely night","pos":"word","pt":"noite solitária","ex":"Lonely night.","expt":"Noite solitária."},{"w":"unclear ending","pos":"word","pt":"final nebuloso","ex":"Unclear ending.","expt":"Final nebuloso."},{"w":"movie plot","pos":"word","pt":"enredo do filme","ex":"Movie plot.","expt":"Enredo do filme."},{"w":"lead actor","pos":"word","pt":"ator principal","ex":"Lead actor.","expt":"Ator principal."},{"w":"supporting role","pos":"word","pt":"papel coadjuvante","ex":"Supporting role.","expt":"Papel coadjuvante."},{"w":"film critic","pos":"word","pt":"crítico de cinema","ex":"Film critic.","expt":"Crítico de cinema."},{"w":"cinema seat","pos":"word","pt":"poltrona de cinema","ex":"Cinema seat.","expt":"Poltrona de cinema."},{"w":"movie scene","pos":"word","pt":"cena de filme","ex":"Movie scene.","expt":"Cena de filme."},{"w":"film score","pos":"word","pt":"trilha sonora","ex":"Film score.","expt":"Trilha sonora."},{"w":"f