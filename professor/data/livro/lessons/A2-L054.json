ude"]]},{"type":"order","title":"Put the words in order","items":[{"words":["think","Cusco","I"],"ans":"Cusco I think","pt":"Cusco, eu acho."},{"words":["is","cheaper","Which"],"ans":"Which is cheaper","pt":"Qual é mais barato?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"comparison","pos":"word","pt":"comparação","ex":"A simple comparison.","expt":"Uma comparação simples."},{"w":"colder","pos":"word","pt":"mais frio","ex":"It is colder.","expt":"Está mais frio."},{"w":"altitude","pos":"word","pt":"altitude","ex":"High altitude.","expt":"Alta altitude."},{"w":"local dish","pos":"word","pt":"prato típico","ex":"A local dish.","expt":"Um prato típico."},{"w":"city comparison","pos":"word","pt":"comparação de cidades","ex":"A city comparison.","expt":"Uma comparação de cidades."},{"w":"high altitude","pos":"word","pt":"altitude elevada","ex":"High altitude.","expt":"Altitude elevada."},{"w":"local food","pos":"word","pt":"comida local","ex":"Local food.","expt":"Comida local."},{"w":"warm coat","pos":"word","pt":"casaco quente","ex":"A warm coat.","expt":"Um casaco quente."},{"w":"hotel price","pos":"word","pt":"preço de hotel","ex":"The hotel price.","expt":"O preço do hotel."},{"w":"travel blog","pos":"word","pt":"blog de viagem","ex":"A travel blog.","expt":"Um blog de viagem."},{"w":"friendly people","pos":"word","pt":"pessoas simpáticas","ex":"Friendly people.","expt":"Pessoas simpáticas."},{"w":"city size","pos":"word","pt":"tamanho da cidade","ex":"City size.","expt":"Tamanho da cidade."},{"w":"street food","pos":"word","pt":"comida de rua","ex":"Street food.","expt":"Comida de rua."},{"w":"cold nights","pos":"word","pt":"noites frias","ex":"Cold nights.","expt":"Noites frias."},{"w":"big market","pos":"word","pt":"mercado grande","ex":"A big market.","expt":"Um mercado grande."},{"w":"city guide","pos":"word","pt":"guia da cidade","ex":"City guide.","expt":"Guia da cidade."}]},{"type":"box","kind":"culture"