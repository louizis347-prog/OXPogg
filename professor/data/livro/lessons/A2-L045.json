,"business trip"],["return flight","return flight"],["medical supplies","medical supplies"],["conference badge","conference badge"]]}]},{"tag":"Leitura","title":"Reading · A short biography","blocks":[{"type":"bio","name":"Dr. Ana Pires","paras":["Next week Ana **is flying** to Lima for a conference. She **is meeting** a team of nurses on Tuesday and **is giving** a talk on Wednesday.","Her clinic **is running out of** vaccines, so she **is not staying** long. “I **am coming** back on Friday,” she says."],"years":"Born 1982","facts":[["Job","doctor"],["Trip","Lima"],["Talk","Wednesday"],["Back","Friday"]],"gloss":[["conference","congresso"],["vaccine","vacina"],["talk","palestra"],["stay","ficar"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Ana is flying to Lima next week.","ans":"T","why":"is flying."},{"q":"She is staying a month.","ans":"F","why":"not staying long."},{"q":"She is giving a talk on Wednesday.","ans":"T","why":"giving a talk."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“conference” = ?","opts":["congresso","conferir","confusão"],"ans":0,"why":"conference."},{"q":"“run out of” = ?","opts":["ficar sem","correr de","sair de"],"ans":0,"why":"run out of."}]}]},{"tag":"Gramática","title":"Present Continuous for future","blocks":[{"type":"table","head":["Estrutura","Exemplo"],"rows":[["arranjo definido","**I am meeting the nurses on Tuesday.**"],["negativa","**She isn’t staying long.**"],["pergunta","**Are you flying on Monday?**"]],"cap":"Present Continuous for future"},{"type":"box","kind":"look","t":"Regra","body":"Use com **hora/dia combinado**: *tomorrow, next week, on Friday.*"},{"type":"box","kind":"warn","t":"Cuidado","body":"Para intenção geral use **going to**; para arranjo fechado, o contínuo."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Ana ___ to Lima next week. (fly)","a":"is flying","why":"arranjo."},{"s":"She ___ a talk on Wednesday. (give)","a":"is giving","why":"arranjo."},{"s":"We ___ vaccines. (run out of)","a":"are running out of","why":"run out of.","say":"run out of"},{"s":"I ___ back on Friday. (come)","a":"am coming","why":"arranjo."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["lecture","aula magna"],["hall","auditório"],["delegate","delegado"],["itinerary","roteiro"],["boarding","embarque"]]},{"type":"order","title":"Put the words in order","items":[{"words":["to","Lima","I'm","flying"],"ans":"I'm flying to Lima","pt":"Vou voar para Lima."},{"words":["long","Are","you","staying"],"ans":"Are you staying long","pt":"Fica muito tempo?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"delegate","pos":"word","pt":"delegado","ex":"A conference delegate.","expt":"Um delegado do congresso."},{"w":"boarding","pos":"word","pt":"embarque","ex":"Boarding is at six.","expt":"O embarque é às seis."},{"w":"hotel booking","pos":"word","pt":"reserva de hotel","ex":"A hotel booking.","expt":"Uma reserva de hotel."},{"w":"shortage","pos":"word","pt":"falta","ex":"A vaccine shortage.","expt":"Falta de vacinas."},{"w":"medical conference","pos":"word","pt":"medical conference","ex":"congresso médico","expt":"A medical conference."},{"w":"flight to Lima","pos":"word","pt":"flight to Lima","ex":"voo para Lima","expt":"A flight to Lima."},{"w":"conference talk","pos":"word","pt":"conference talk","ex":"palestra do congresso","expt":"A conference talk."},{"w":"nurse team","pos":"word","pt":"nurse team","ex":"equipe de enfermeiros","expt":"A nurse team."},{"w":"vaccine shortage","pos":"word","pt":"vaccine shortage","ex":"falta de vacinas","expt":"A vaccine shortage."},{"w":"clinic stock","pos":"word","pt":"clinic stock","ex":"estoque da clínica","expt":"Clinic stock."},{"w":"short stay","pos":"word","pt":"short stay","ex":"estadia curta","expt":"A short stay."},{"w":"hotel in Lima","pos":"word","pt":"hotel in Lima","ex":"hotel em Lima","expt":"A hotel in Lima."},{"w":"business trip","pos":"word","pt":"business trip","ex":"viagem de trabalho","expt":"A business trip."},{"w":"return flight","pos":"word","pt":"return flight","ex":"voo de volta","expt":"A return flight."},{"w":"medical supplies","pos":"word","pt":"medical supplies","ex":"material médico","expt":"Medical supplies."},{"w":"conference badge","pos":"word","pt":"conference badge","ex":"crachá do congresso","expt":"Conference badge."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**What are you doing next week?** — O que você faz semana que vem?","**I’m flying to Lima.** — Vou voar para Lima.","**Are you staying long?** — Fica muito tempo?","**It’s a small world.** — O mundo é pequeno.","**It’s getting late.** — Está ficando tarde.","**It’s getting dark.** — Está escurecendo.","**It’s raining cats and dogs.** — Está chovendo canivete."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"hurt","pt":"machucar","forms":[["I / you / we / they hurt","My leg hurts."],["he / she / it hurts","His back hurts."]]}]},{"type":"table","head":["Phrasal verb","Significado","Exemplo"],"rows":[["**run out of**","ficar sem","We ran out of water. — Ficamos sem água."]],"cap":"Phrasal verbs"}]},{"tag":"Escuta e diálogo","title":"Before the trip","blocks":[{"type":"dialog","title":"Before the trip","lines":[["Leo","What are you doing next week?","O que você faz semana que vem?"],["Ana","I’m flying to Lima.","Vou voar para Lima."],["Leo","Are you staying long?","Fica muito tempo?"],["Ana","No, I’m coming back on Friday.","Não, volto na sexta."]]},{"type":"pron","title":"Pronúncia: gonna e wanna (reconhecimento)","items":[{"label":"gonna e wanna (reconhecimento)","note":"Na fala: going to → gonna, want to → wanna. Reconheça; na escrita use a forma completa.","words":["I’m gonna go","I wanna eat","What are you gonna do?"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Tell your plans for next week.","pt":"Conte.","model":"I am meeting a friend on Tuesday."},{"q":"Ask about someone’s plans.","pt":"Pergunte.","model":"What are you doing tomorrow?"},{"q":"Say what you are running out of.","pt":"Diga.","model":"I am running out of time."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences about next week with the Present Continuous.","model":"I am flying to Lima. I am meeting a team on Tuesday. I am giving a talk on Wednesday. We are not staying long. I am coming back on Friday.","checklist":["Usei **am/is/are + -ing**","Usei **tempos futuros**","Usei **uma negativa**"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “lecture” mean?","opts":["auditório","aula magna","roteiro"],"ans":1,"why":"**lecture** = aula magna."},{"q":"What does “hall” mean?","opts":["delegado","embarque","auditório"],"ans":2,"why":"**hall** = auditório."},{"q":"What does “delegate” mean?","opts":["delegado","roteiro","reserva de hotel"],"ans":0,"why":"**delegate** = delegado."},{"q":"What does “itinerary” mean?","opts":["embarque","roteiro","suprimentos"],"ans":1,"why":"**itinerary** = roteiro."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}