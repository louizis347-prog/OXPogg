o","bad","That's"],"ans":"That's too bad","pt":"Que pena!"},{"words":["broke","my","phone","I"],"ans":"I broke my phone","pt":"Quebrei meu celular."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"chores","pos":"word","pt":"tarefas domésticas","ex":"Do the chores.","expt":"Faça as tarefas."},{"w":"groceries","pos":"word","pt":"compras de mercado","ex":"Buy the groceries.","expt":"Faça as compras."},{"w":"yoga","pos":"word","pt":"ioga","ex":"Do yoga.","expt":"Faça ioga."},{"w":"washing","pos":"word","pt":"lavagem de roupa","ex":"Do the washing.","expt":"Lave a roupa."},{"w":"project","pos":"word","pt":"projeto","ex":"A school project.","expt":"Um projeto escolar."},{"w":"iron","pos":"word","pt":"passar roupa","ex":"Iron the shirt.","expt":"Passe a camisa."},{"w":"stretch","pos":"word","pt":"alongar","ex":"Stretch your arms.","expt":"Alongue os braços."},{"w":"laundry basket","pos":"word","pt":"laundry basket","ex":"cesto de roupa","expt":"A full laundry basket."},{"w":"fabric softener","pos":"word","pt":"fabric softener","ex":"amaciante","expt":"Add fabric softener."},{"w":"clothesline","pos":"word","pt":"clothesline","ex":"varal","expt":"Hang it on the clothesline."},{"w":"ironing board","pos":"word","pt":"ironing board","ex":"tábua de passar","expt":"Open the ironing board."},{"w":"dustpan","pos":"word","pt":"dustpan","ex":"pá de lixo","expt":"Use a dustpan."},{"w":"garbage bag","pos":"word","pt":"garbage bag","ex":"saco de lixo","expt":"A black garbage bag."},{"w":"recycling bin","pos":"word","pt":"recycling bin","ex":"lixeira de reciclagem","expt":"The recycling bin."},{"w":"duster","pos":"word","pt":"duster","ex":"espanador","expt":"A feather duster."},{"w":"rubber gloves","pos":"word","pt":"rubber gloves","ex":"luvas de borracha","expt":"Wear rubber gloves."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**That’s too bad** — Que pena","**What did you do on Sunday?** — O que fez no doming