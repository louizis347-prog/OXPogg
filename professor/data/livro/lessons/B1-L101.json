]]}]},{"tag":"Leitura","title":"Reading · A review","blocks":[{"type":"text","title":"Review: Smart Speaker X ★★★☆☆","paras":["This speaker **gives** clear sound and **gives** you the weather in seconds. It also **gave** me a headache when it **gave** wrong answers. If it **gave** me fewer ads, I **would give** it five stars.","Overall, I **give** it three. Don’t **give up**: updates may fix it."],"kicker":"PRODUCT REVIEW","by":"TechBuyer","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The speaker gives clear sound.","ans":"T","why":"clear sound."},{"q":"The reviewer gives it five stars.","ans":"F","why":"three."},{"q":"Updates may fix problems.","ans":"T","why":"updates may fix."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“headache” = ?","opts":["dor de cabeça","cabeça dura","cabelo"],"ans":0,"why":"headache."},{"q":"“give up” = ?","opts":["desistir","dar para cima","dar alto"],"ans":0,"why":"give up."}]}]},{"tag":"Gramática","title":"Key verb: give","blocks":[{"type":"table","head":["Sentido","Exemplo"],"rows":[["dar","**give a gift**"],["fornecer","**It gives clear sound.**"],["causar","**It gave me a headache.**"],["dar nota","**I give it three stars.**"],["give up / in","**Don’t give up.**"]],"cap":"Key verb: give"},{"type":"box","kind":"look","t":"Regra","body":"Passado **gave**, particípio **given**. *give someone something* = *give something to someone*."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"It ___ clear sound. (give, 3ª)","a":"gives","why":"3ª pessoa."},{"s":"It ___ me a headache. (give, past)","a":"gave","why":"give-gave."},{"s":"If it gave fewer ads, I ___ give it five stars. (would)","a":"would","why":"2º cond."},{"s":"Don’t give ___ . (up)","a":"up","why":"give up."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["smart speaker","caixa de som inteligente"],["sound quality","qualidade do som"],["voice assistant","assistente de voz"],["weather report","previsão do tempo"],["wrong answer","resposta errada"]]},{"type":"order","title":"Put the words in order","items":[{"words":["buy","it","again","Would","you"],"ans":"Would you buy it again","pt":"Compraria de novo?"},{"words":["yes","If","it","gave","fewer","ads"],"ans":"If it gave fewer ads yes","pt":"Se desse menos anúncios, sim."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"smart speaker","pos":"word","pt":"caixa de som inteligente","ex":"Smart speaker.","expt":"Caixa de som inteligente."},{"w":"sound quality","pos":"word","pt":"qualidade do som","ex":"Sound quality.","expt":"Qualidade do som."},{"w":"voice assistant","pos":"word","pt":"assistente de voz","ex":"Voice assistant.","expt":"Assistente de voz."},{"w":"wrong answer","pos":"word","pt":"resposta errada","ex":"Wrong answer.","expt":"Resposta errada."},{"w":"too many ads","pos":"word","pt":"anúncios demais","ex":"Too many ads.","expt":"Anúncios demais."},{"w":"battery power","pos":"word","pt":"carga da bateria","ex":"Battery power.","expt":"Carga da bateria."},{"w":"setup time","pos":"word","pt":"tempo de configuração","ex":"Setup time.","expt":"Tempo de configuração."},{"w":"bass sound","pos":"word","pt":"som grave","ex":"Bass sound.","expt":"Som grave."},{"w":"volume control","pos":"word","pt":"controle de volume","ex":"Volume control.","expt":"Controle de volume."},{"w":"home device","pos":"word","pt":"aparelho doméstico","ex":"Home device.","expt":"Aparelho doméstico."},{"w":"voice command","pos":"word","pt":"comando de voz","ex":"Voice command.","expt":"Comando de voz."},{"w":"buyer’s guide","pos":"word","pt":"guia do comprador","ex":"Buyer’s guide.","expt":"Guia do comprador."},{"w":"return policy","pos":"word","pt":"política de devolução","ex":"Return policy.","expt":"Política de devolução."},{"w":"bluetooth link","pos":"word","pt":"conexão bluetooth","ex":"Bluetooth link.","expt":"Conexão bluetooth."},{"w":"room size","pos":"word","pt":"tamanho do cômodo","ex":"Room size.","expt":"Tamanho do cômodo."},{"w":"smart home","pos":"word","pt":"casa inteligente","ex":"Smart home.","expt":"Casa inteligente."},{"w":"music playlist","pos":"word","pt":"lista de músicas","ex":"Music playlist.","expt":"Lista de músicas."},{"w":"customer rating","pos":"word","pt":"nota do cliente","ex":"Customer rating.","expt":"Nota do cliente."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Give or take.** — Mais ou menos.","**Give it a try.** — Experimente.","**Give me a hand.** — Me dê uma mão.","**How many stars do you give it?** — Quantas estrelas você dá?","**Would you buy it again?** — Compraria de novo?","**If it gave fewer ads, yes.** — Se desse menos anúncios, sim.","**Spill the beans.** — Contar o segredo.","**Stand your ground.** — Manter-se firme."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"give","pt":"dar","forms":[["I / you / we / they give","I give advice."],["he / she / it gives","Eu dou conselhos."]]}]}]},{"tag":"Escuta e diálogo","title":"Shopping","blocks":[{"type":"dialog","title":"Shopping","lines":[["Ana","How many stars do you give it?","Quantas estrelas você dá?"],["Leo","I give it three. It gave me a headache with ads.","Dou três. Deu-me dor de cabeça com os anúncios."],["Ana","Would you buy it again?","Compraria de novo?"],["Leo","If it gave fewer ads, yes.","Se desse menos anúncios, sim."]]},{"type":"pron","title":"Pronúncia: Entonação","items":[{"label":"Entonação","note":"Perguntas de sim/não sobem; Wh- descem; listas sobem e descem no fim; dúvida sobe.","words":["Have you ever studied abroad? ↗","Where did you study? ↘","books, notes, and pens ↘"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Give a rating.","pt":"Dê.","model":"I give it four stars."},{"q":"Use give up.","pt":"Use.","model":"N