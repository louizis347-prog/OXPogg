e, past)","a":"had","why":"have + obj + part."},{"s":"I kept ___ to restart it. (try -ing)","a":"trying","why":"keep + -ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["dead phone","celular morto"],["phone repair","conserto de celular"],["screen cable","cabo da tela"],["water damage","dano por água"],["battery life","duração da bateria"]]},{"type":"order","title":"Put the words in order","items":[{"words":["phone","is","dead","My"],"ans":"My phone is dead","pt":"Meu celular morreu."},{"words":["be","the","battery","It","can't"],"ans":"It can't be the battery","pt":"Não pode ser a bateria."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"dead phone","pos":"word","pt":"celular morto","ex":"Dead phone.","expt":"Celular morto."},{"w":"screen cable","pos":"word","pt":"cabo da tela","ex":"Screen cable.","expt":"Cabo da tela."},{"w":"water damage","pos":"word","pt":"dano por água","ex":"Water damage.","expt":"Dano por água."},{"w":"battery life","pos":"word","pt":"duração da bateria","ex":"Battery life.","expt":"Duração da bateria."},{"w":"charger cable","pos":"word","pt":"cabo do carregador","ex":"Charger cable.","expt":"Cabo do carregador."},{"w":"software bug","pos":"word","pt":"bug de software","ex":"Software bug.","expt":"Bug de software."},{"w":"restart button","pos":"word","pt":"botão de reiniciar","ex":"Restart button.","expt":"Botão de reiniciar."},{"w":"dark screen","pos":"word","pt":"tela escura","ex":"Dark screen.","expt":"Tela escura."},{"w":"phone doctor","pos":"word","pt":"técnico de celular","ex":"Phone doctor.","expt":"Técnico de celular."},{"w":"spare battery","pos":"word","pt":"bateria reserva","ex":"Spare battery.","expt":"Bateria reserva."},{"w":"phone warranty","pos":"word","pt":"garantia do celular","ex":"Phone warranty.","expt":"Garantia do celular."},{"w":"data loss","pos":"word","pt":"perda de dados","ex":"Data loss.","expt":"Perda de dados."},{"w":"cloud backup","pos":"