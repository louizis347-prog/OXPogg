hich)","a":"which","why":"extra."},{"s":"They ___ up a class. (set)","a":"set","why":"set up.","say":"set up"}]},{"type":"match","title":"Match the word to its meaning","pairs":[["community garden","horta comunitária"],["mailbox library","biblioteca na caixa de correio"],["senior class","aula para idosos"],["phone lesson","aula de celular"],["small project","pequeno projeto"]]},{"type":"order","title":"Put the words in order","items":[{"words":["up","the","garden","Who","set"],"ans":"Who set up the garden","pt":"Quem montou a horta?"},{"words":["library","And","the","little"],"ans":"And the little library","pt":"E a biblioteca pequena?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"community garden","pos":"word","pt":"horta comunitária","ex":"A community garden.","expt":"Uma horta comunitária."},{"w":"mailbox library","pos":"word","pt":"biblioteca na caixa de correio","ex":"A mailbox library.","expt":"Uma biblioteca na caixa de correio."},{"w":"senior class","pos":"word","pt":"aula para idosos","ex":"A senior class.","expt":"Uma aula para idosos."},{"w":"phone lesson","pos":"word","pt":"aula de celular","ex":"A phone lesson.","expt":"Uma aula de celular."},{"w":"small project","pos":"word","pt":"pequeno projeto","ex":"A small project.","expt":"Um pequeno projeto."},{"w":"local helper","pos":"word","pt":"ajudante local","ex":"A local helper.","expt":"Um ajudante local."},{"w":"street garden","pos":"word","pt":"horta de rua","ex":"A street garden.","expt":"Uma horta de rua."},{"w":"free book","pos":"word","pt":"livro grátis","ex":"A free book.","expt":"Um livro grátis."},{"w":"shared tool","pos":"word","pt":"ferramenta compartilhada","ex":"A shared tool.","expt":"Uma ferramenta compartilhada."},{"w":"block party","pos":"word","pt":"festa de quarteirão","ex":"A block party.","expt":"Uma festa de quarteirão."},{"w":"good idea","pos":"word","pt":"boa ideia","ex":"A good idea.","expt":"Uma boa ideia."},{"w":"neighbor group","pos":"word","pt":"grupo de vizinhos","ex":"A neighbor group.","expt":"Um grupo de vizinhos."},{"w":"low cost","pos":"word","pt":"baixo custo","ex":"Low cost.","expt":"Baixo custo."},{"w":"kind act","pos":"word","pt":"ato gentil","ex":"A kind act.","expt":"Um ato gentil."},{"w":"city block","pos":"word","pt":"quarteirão","ex":"A city block.","expt":"Um quarteirão."},{"w":"strong community","pos":"word","pt":"comunidade forte","ex":"A strong community.","expt":"Uma comunidade forte."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Give it a try.** — Experimente.","**Every little bit helps.** — Cada pouquinho ajuda.","**Make a difference.** — Fazer a diferença.","**Who set up the garden?** — Quem montou a horta?","**The neighbors who live on this street.** — Os vizinhos que moram nesta rua.","**And the little library?** — E a biblioteca pequena?","**Keep an eye on it.** — Fique de olho."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"care","pt":"importar-se","forms":[["I / you / we / they care","I care about you."],["he / she / it cares","He cares a lot."]]}]},{"type":"table","head":["Phrasal verb","Significado","Exemplo"],"rows":[["**set up**","montar, criar","They set up a class. — Eles montaram uma aula."]],"cap":"Phrasal verbs"}]},{"tag":"Escuta e diálogo","title":"Neighbors","blocks":[{"type":"dialog","title":"Neighbors","lines":[["Ana","Who set up the garden?","Quem montou a horta?"],["Leo","The neighbors who live on this street.","Os vizinhos que moram nesta rua."],["Ana","And the little library?","E a biblioteca pequena?"],["Leo","The one which is in the mailbox.","A que fica na caixa de correio."]]},{"type":"pron","title":"Pronúncia: Ligação entre palavras","items":[{"label":"Ligação entre palavras","note":"Consoante final liga à vogal seguinte: pick it up → pi-ki-tup.","words":["pick it up","turn it off","an apple","check in"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak",