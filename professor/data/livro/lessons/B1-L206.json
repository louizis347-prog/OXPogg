dy","estudo de psicologia"],["research result","resultado de pesquisa"],["decision bias","viés de decisão"],["brain study","estudo do cérebro"],["choice overload","excesso de escolhas"],["mental shortcut","atalho mental"],["gut reaction","reação instintiva"],["decision rule","regra de decisão"],["calm thinking","pensar com calma"]]}]},{"tag":"Leitura","title":"Reading · An academic summary","blocks":[{"type":"text","title":"Summary: How People Make Decisions","paras":["This study **examines** how people decide under stress. **Although** most participants **believed** they were rational, results **showed** that emotions **played** a major role. **Despite** having enough information, many **chose** quickly.","The authors **suggest taking** time to reflect, and **recommend discussing** big choices with others."],"kicker":"ACADEMIC SUMMARY","by":"Psychology Review","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Participants believed they were rational.","ans":"T","why":"believed they were rational."},{"q":"Emotions had no role.","ans":"F","why":"played a major role."},{"q":"The authors suggest taking time to reflect.","ans":"T","why":"taking time."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“rational” = ?","opts":["racional","razão só","racionar"],"ans":0,"why":"rational."},{"q":"“reflect” = ?","opts":["refletir","reagir","reduzir"],"ans":0,"why":"reflect."}]}]},{"tag":"Gramática","title":"Resumo de decisão","blocks":[{"type":"table","head":["Parte","Frase"],"rows":[["método","**This study examines how people decide.**"],["contraste","**Although most believed…, results showed…**"],["sugestão","**The authors suggest taking time.**"],["recomendação","**…recommend discussing big choices.**"]],"cap":"Resumo de decisão"},{"type":"box","kind":"look","t":"Regra","body":"Em resumos use **although/despite** para ressaltar o que surpreende e **suggest/recommend + -ing**."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"The study ___ how people decide. (examine, 3ª)","a":"examines","why":"3ª pessoa."},{"s":"___ they believed they were rational,… (Although)","a":"Although","why":"contraste."},{"s":"The authors suggest ___ time. (take -ing)","a":"taking","why":"suggest + -ing."},{"s":"They recommend ___ big choices. (discuss -ing)","a":"discussing","why":"recommend + -ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["decision making","tomada de decisão"],["stress response","resposta ao estresse"],["rational thinking","pensamento racional"],["emotional role","papel emocional"],["quick choice","escolha rápida"]]},{"type":"order","title":"Put the words in order","items":[{"words":["to","reflect","Taking","time"],"ans":"Taking time to reflect","pt":"Dedicar tempo para refletir."},{"words":["suggest","What","do","the","authors"],"ans":"What do the authors suggest","pt":"O que os autores sugerem?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"decision making","pos":"word","pt":"tomada de decisão","ex":"Decision making.","expt":"Tomada de decisão."},{"w":"stress response","pos":"word","pt":"resposta ao estresse","ex":"Stress response.","expt":"Resposta ao estresse."},{"w":"rational thinking","pos":"word","pt":"pensamento racional","ex":"Rational thinking.","expt":"Pensamento racional."},{"w":"emotional role","pos":"word","pt":"papel emocional","ex":"Emotional role.","expt":"Papel emocional."},{"w":"quick choice","pos":"word","pt":"escolha rápida","ex":"Quick choice.","expt":"Escolha rápida."},{"w":"study participant","pos":"word","pt":"participante do estudo","ex":"Study participant.","expt":"Participante do estudo."},{"w":"enough information","pos":"word","pt":"informação suficiente","ex":"Enough information.","expt":"Informação suficiente."},{"w":"reflection time","pos":"word","pt":"tempo de reflexão","ex":"Reflection time.","expt":"Tempo de reflexão."},{"w":"big choice","pos":"word","pt":"grande escolha","ex":"Big choice.","expt":"Grande escolha."},{"w":"psychology study","pos":"word","pt":"estudo de psicologia","ex":"Psychology study.","expt":"Estudo de psicologia."},{"w":"research result","pos":"word","pt":"resultado de pesquisa","ex":"Research result.","expt":"Resultado de pesquisa."},{"w":"decision bias","pos":"word","pt":"viés de decisão","ex":"Decision bias.","expt":"Viés de decisão."},{"w":"brain study","pos":"word","pt":"estudo do cérebro","ex":"Brain study.","expt":"Estudo do cérebro."},{"w":"choice overload","pos":"word","pt":"excesso de escolhas","ex":"Choice overload.","expt":"Excesso de escolhas."},{"w":"mental shortcut","pos":"word","pt":"atalho mental","ex":"Mental shortcut.","expt":"Atalho mental."},{"w":"gut reaction","pos":"word","pt":"reação instintiva","ex":"Gut reaction.","expt":"Reação instintiva."},{"w":"decision rule","pos":"word","pt":"regra de decisão","ex":"Decision rule.","expt":"Regra de decisão."},{"w":"calm thinking","pos":"word","pt":"pensar com calma","ex":"Calm thinking.","expt":"Pensar com calma."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Think it through.** — Pense bem.","**Sleep on it.** — Pense com calma.","**Weigh up the options.** — Pesar as opções.","**Look before you leap.** — Pense antes de agir.","**How do people decide under stress?** — Como as pessoas decidem sob estresse?","**What do the authors suggest?** — O que os autores sugerem?","**Taking time to reflect.** — Dedicar tempo para refletir.","**Toe the line.** — Seguir as regras."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"reflect","pt":"refletir","forms":[["I / you / we / they reflect","I reflect on my day."],["he / she / it reflects","Reflito sobre meu dia."]]}]}]},{"tag":"Escuta e diálogo","title":"Study talk","blocks":[{"type":"dialog","title":"Study talk","lines":[["Ana","How do people decide under stress?","Como as pessoas decidem sob estresse?"],["Leo","Although they believe they’re rational, emotions play a role.","Embora achem que são racionais, emoções têm papel."],["Ana","What do the authors suggest?","O que os autores sugerem?"],["Leo","Taking time to reflect.","Dedicar tempo para refletir."]]},{"type":"pron","title":"Pronúncia: Contrações e fala conectada (compreensão)","items":[{"label":"Contrações e fala conectada (compreensão)","note":"Reconheça: I’ve → /aɪv/, she’s → /ʃiz/, wouldn’t’ve, whaddaya (what do you), gonna, wanna.","words":["I’ve been there.","She’s been studying.","What do you want?","I’d’ve gone."]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Summarize a finding.","pt":"Resuma.","model":"The study shows that emotions matter."},{"q":"Use although.","pt":"Use.","model":"Although they were calm, they chose fast."},{"q":"Use recommend + -ing.","pt":"Use.","model":"They recommend discussing choices."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-line summary about decision-making.","model":"This study examines how people decide under stress. Although most participants believed they were rational, emotions played a major role. Despite having enough information, many chose quickly. The authors suggest taking time to reflect. They recommend discussing big choices with others. More research is needed.","checklist":["Usei **although / despite**","Usei **suggest + -ing**","Resumo claro"],"words":"6 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “decision making” mean?","opts":["resposta ao estresse","tomada de decisão","papel emocional"],"ans":1,"why":"**decision making** = tomada de decisão."},{"q":"What does “stress response” mean?","opts":["pensamento racional","escolha rápida","resposta ao estresse"],"ans":2,"why":"**stress response** = resposta ao estresse."},{"q":"What does “rational thinking” mean?","opts":["pensamento racional","papel emocional","participante do estudo"],"ans":0,"why":"**rational thinking** = pensamento racional."},{"q":"What does “emotional role” mean?","opts":["escolha rápida","papel emocional","informação suficiente"],"ans":1,"why":"**emotional role** = papel emocional."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}