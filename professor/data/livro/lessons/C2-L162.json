es"],["liberal arts","artes liberais"],["citizenship teaching","ensino de cidadania"],["reasoned scepticism","ceticismo fundamentado"],["soft skills","habilidades interpessoais"],["hard core","núcleo duro"],["self-government","autogoverno"],["public reason","razão pública"],["democratic deliberation","deliberação democrática"],["ethical literacy","letramento ético"],["value judgment","juízo de valor"],["utilitarian audit","auditoria utilitarista"],["payback yield","retorno financeiro"],["job-specific training","treino profissionalizante"],["STEM funding","financiamento de ciências e tecnologia"],["degree program","curso de graduação"],["faculty shutdown","fechamento de faculdade"],["funding axe","corte de verbas"],["enrolment decline","queda nas matrículas"],["campus protest","protesto no campus"],["op-ed","artigo de opinião"],["rhetorical query","indagação retórica"],["appeal to the readers’ conscience","apelo à consciência dos leitores"],["fallacy detection","detecção de falácias"]]},{"type":"vocab","items":[]},{"type":"box","kind":"culture","t":"Novas expressões da revisão","body":["**How about you?** — E você?","**I don’t mind.** — Não me importo."]},{"type":"box","kind":"tip","t":"Estratégia","body":"Escolha **5 palavras** que ainda travam. Escreva uma frase **sua** com cada uma e diga em voz alta."}]},{"tag":"Verbos","title":"Verbs of the unit","blocks":[{"type":"table","head":["Verbo","Significado"],"rows":[["**abdicate**","abdicar, renunciar a"],["**corroborate**","corroborar"],["**persist**","persistir, continuar"],["**refute**","refutar"],["**underpin**","sustentar, embasar"],["**reconcile**","conciliar, harmonizar"],["**withhold**","reter, suspender"],["**arbitrate**","arbitrar"],["**posit**","postular"],["**ascribe**","atribuir"],["**chair**","presidir, mediar"],["**dismantle**","desmontar"],["**unsettle**","perturbar"],["**ponder**","ponderar"],["**endure**","perdurar"],["**delegate**","delegar"]],"cap":"Verbos vistos nesta unidade"},{"type":"box","kind":"look","t":"Revisão","body":"Diga uma frase com cada verbo. Atenção a **he / she / it**: o verbo muda (**has, does, goes**)."}]},{"tag":"Escuta e diálogo","title":"Assessment talk","blocks":[{"type":"dialog","title":"Assessment talk","lines":[["Ana","What keeps a seminar alive?","O que mantém um seminário vivo?"],["Leo","It is the question, not the answer.","É a pergunta, não a resposta."],["Ana","And what troubles teachers?","E o que preocupa os professores?"],["Leo","What troubles them is time.","O que os preocupa é o tempo."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"Ajuste refinado de entonação","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"Ritmo e ênfase para nuances","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Use a cleft sentence.","pt":"Use.","model":"It is the question that matters."},{"q":"Use a negative inversion.","pt":"Use.","model":"Rarely have I heard such a clear argument."},{"q":"Express caution.","pt":"Cautela.","model":"I would be reluctant to draw that conclusion."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-sentence note on why schools should teach argument, using the unit structures.","model":"It is high time schools taught students how to argue. What matters is not winning but understanding. Were pupils to reconstruct arguments, they would listen better. Not until they can restate a rival view fairly are they ready to object. Rarely has a skill been so useful. In other words, argument is a way of respecting others.","checklist":["Usei **It is high time**","Usei **What matters is**","Usei **inversão**"],"words":"6 frases"}]},{"tag":"Revisão e exame","title":"Assessment · Score and next steps","blocks":[{"type":"table","head":["Parte","O que avaliar","Pontos"],"rows":[["Leitura","Quadros 3–4: ideias principais e vocabulário","/ 10"],["Escuta","Quadro 9: entender o diálogo e repetir","/ 10"],["Fala","Quadro 10: frases completas sem pausas longas","/ 10"],["Escrita","Quadro 11: frases corretas com a lista de verificação","/ 10"]],"cap":"Autoavaliação (40 pontos)"},{"type":"box","kind":"look","t":"Critério de conclusão","body":"**28 a 40 pontos:** siga para a próxima unidade. **20 a 27:** repita as aulas em que errou mais. **Menos de 20:** volte à Unidade e refaça os exercícios dos quadros 5 e 6."},{"type":"mcq","title":"Final check","items":[{"q":"What does “automated decision” mean?","opts":["revisão ética","identidade pessoal","decisão automatizada"],"ans":2,"why":"**automated decision** = decisão automatizada."},{"q":"What does “ethics review” mean?","opts":["revisão ética","autorização do comitê de ética","convicção fundamentada"],"ans":0,"why":"**ethics review** = revisão ética."},{"q":"What does “review-board clearance” mean?","opts":["identidade pessoal","autorização do comitê de ética","decisão automatizada"],"ans":1,"why":"**review-board clearance** = autorização do comitê de ética."},{"q":"What does “personal identity” mean?","opts":["convicção fundamentada","revisão ética","identidade pessoal"],"ans":2,"why":"**personal identity** = identidade pessoal."},{"q":"What does “warranted conviction” mean?","opts":["convicção fundamentada","decisão automatizada","autorização do comitê de ética"],"ans":0,"why":"**warranted conviction** = convicção fundamentada."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","No C2, a variedade de estruturas de ênfase pesa nos critérios de Writing (CPE)."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique sem consulta e com tempo.","Grave a parte oral e devolva comentários.","Use a lista para autoavaliação do aluno."]}]}]}