o retrospectiva"],["lost opportunity","oportunidade perdida"],["cancellation","cancellation"],["canceled","canceled"],["water heater","water heater"],["air conditioner","air conditioner"],["outcome","outcome"]]}]},{"tag":"Leitura","title":"Reading · An infographic","blocks":[{"type":"info","title":"What If the Past Had Been Different?","items":[["Se tivéssemos poupado","If we **had saved**, we **would have bought** a home"],["Se tivesse chovido","If it **had rained**, the match **would have been** cancelled"],["Se ele tivesse estudado","If he **had studied**, he **wouldn’t have failed**"],["Negação","He **denied** knowing the rules"],["Dica","*if + had + particípio, would have + particípio*"]],"note":"Dica: Third Conditional = passado **irreal**. Não use *would* depois de *if*.","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"If we had saved, we would have bought a home.","ans":"T","why":"had saved … would have bought."},{"q":"He passed because he studied.","ans":"F","why":"wouldn’t have failed (he didn’t study)."},{"q":"The text uses would after if.","ans":"F","why":"had + particípio."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“deny” = ?","opts":["negar","denunciar","depender"],"ans":0,"why":"deny."},{"q":"“cancel” = ?","opts":["cancelar","canalizar","calcular"],"ans":0,"why":"cancel."}]}]},{"tag":"Gramática","title":"Third Conditional","blocks":[{"type":"table","head":["Parte","Estrutura","Exemplo"],"rows":[["if-clause","had + particípio","**If I had known,…**"],["main clause","would have + particípio","**…I would have called.**"],["negativa","hadn’t / wouldn’t have","**If he hadn’t left, he wouldn’t have missed it.**"],["could/might have","possibilidade","**…I might have helped.**"]],"cap":"Third Conditional"},{"type":"box","kind":"look","t":"Regra","body":"Third Conditional = **passado que não aconteceu**. Expressa arrependimento ou crítica."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"If we ___ saved, we would have bought a home. (have)","a":"had","why":"if + had."},{"s":"If it had rained, the match ___ have been cancelled. (would)","a":"would","why":"would have."},{"s":"If he had studied, he wouldn’t have ___ . (fail, part.)","a":"failed","why":"particípio."},{"s":"He ___ knowing the rules. (deny, past)","a":"denied","why":"Past Simple."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["home deposit","entrada de imóvel"],["missed chance","chance perdida"],["match day","dia de jogo"],["heavy rain","chuva forte"],["exam failure","reprovação"]]},{"type":"order","title":"Put the words in order","items":[{"words":["denied","not","studying","He"],"ans":"He denied not studying","pt":"Ele negou não ter estudado."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"home deposit","pos":"word","pt":"entrada de imóvel","ex":"Home deposit.","expt":"Entrada de imóvel."},{"w":"match day","pos":"word","pt":"dia de jogo","ex":"Match day.","expt":"Dia de jogo."},{"w":"past regret","pos":"word","pt":"arrependimento do passado","ex":"Past regret.","expt":"Arrependimento do passado."},{"w":"alternative past","pos":"word","pt":"passado alternativo","ex":"Alternative past.","expt":"Passado alternativo."},{"w":"saving plan","pos":"word","pt":"plano de poupança","ex":"Saving plan.","expt":"Plano de poupança."},{"w":"rental cost","pos":"word","pt":"custo do aluguel","ex":"Rental cost.","expt":"Custo do aluguel."},{"w":"housing market","pos":"word","pt":"mercado imobiliário","ex":"Housing market.","expt":"Mercado imobiliário."},{"w":"bank loan","pos":"word","pt":"empréstimo bancário","ex":"Bank loan.","expt":"Empréstimo bancário."},{"w":"stadium crowd","pos":"word","pt":"multidão no estádio","ex":"Stadium crowd.","expt":"Multidão no estádio."},{"w":"cancelled game","pos":"word","pt":"jogo cancelado","ex":"Cancelled 