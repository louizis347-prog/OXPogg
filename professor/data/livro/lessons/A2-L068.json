","why":"razão."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["request","pedido"],["single room","quarto individual"],["double room","quarto de casal"],["availability","disponibilidade"],["booking","reserva"]]},{"type":"order","title":"Put the words in order","items":[{"words":["you","check","availability","Could"],"ans":"Could you check availability","pt":"Pode verificar a disponibilidade?"},{"words":["mind","waiting","a","moment","Would","you"],"ans":"Would you mind waiting a moment","pt":"Importa-se de esperar um momento?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"request","pos":"word","pt":"pedido","ex":"A polite request.","expt":"Um pedido educado."},{"w":"tone","pos":"word","pt":"tom","ex":"A friendly tone.","expt":"Um tom amigável."},{"w":"massage","pos":"word","pt":"massage","ex":"massagem","expt":"A relaxing massage."},{"w":"dry cleaning","pos":"word","pt":"dry cleaning","ex":"lavagem a seco","expt":"Dry cleaning is ready."},{"w":"alteration","pos":"word","pt":"alteration","ex":"ajuste (roupa)","expt":"A quick alteration."},{"w":"repair shop","pos":"word","pt":"repair shop","ex":"oficina de conserto","expt":"A repair shop."},{"w":"estimate","pos":"word","pt":"estimate","ex":"orçamento","expt":"A free estimate."},{"w":"customer service","pos":"word","pt":"customer service","ex":"atendimento","expt":"Call customer service."},{"w":"hotline","pos":"word","pt":"hotline","ex":"linha de atendimento","expt":"A help hotline."},{"w":"pickup","pos":"word","pt":"pickup","ex":"retirada","expt":"Store pickup."},{"w":"subscription","pos":"word","pt":"subscription","ex":"assinatura","expt":"A monthly subscription."},{"w":"renewal","pos":"word","pt":"renewal","ex":"renovação","expt":"A license renewal."},{"w":"permit","pos":"word","pt":"permit","ex":"permissão","expt":"A parking permit."},{"w":"document","pos":"word","pt":"document","ex":"documento","expt":"An official document."},{"w":"copy","