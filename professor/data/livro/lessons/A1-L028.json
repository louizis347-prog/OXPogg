eto","ex":"The object is “a book”.","expt":"O objeto é “a book”."},{"w":"action","pos":"noun","pt":"ação","ex":"An action verb.","expt":"Um verbo de ação."},{"w":"example","pos":"noun","pt":"exemplo","ex":"Give an example.","expt":"Dê um exemplo."},{"w":"order","pos":"noun","pt":"ordem","ex":"Word order.","expt":"Ordem das palavras."},{"w":"sentence","pos":"noun","pt":"frase","ex":"A short sentence.","expt":"Uma frase curta."},{"w":"read","pos":"verb","pt":"ler","ex":"Read a book.","expt":"Leia um livro."},{"w":"watch","pos":"verb","pt":"assistir","ex":"Watch TV.","expt":"Assista TV."}]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"table","head":["Phrasal verb","Significado","Exemplo"],"rows":[["**stand up**","levantar-se","Please stand up. — Por favor, levantem-se."]],"cap":"Phrasal verbs"}]},{"tag":"Escuta e diálogo","title":"Class time","blocks":[{"type":"dialog","title":"Class time","lines":[["Teacher","Stand up, please.","Levantem-se, por favor."],["Class","OK.","Certo."],["Teacher","Sit down. Read the sentence.","Sentem-se. Leiam a frase."],["Ana","She reads a book.","Ela lê um livro."],["Teacher","Good! What is the object?","Bom! Qual é o objeto?"],["Ana","A book.","Um livro."]]},{"type":"pron","title":"Pronúncia: bed/bad","items":[{"label":"bed/bad","note":"Sílaba tônica: SENtence, EXample, SUBject, OBject (substantivo: 1ª sílaba).","words":["sentence","example","subject","object"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Make three S-V-O sentences.","pt":"Faça.","model":"I eat bread. She reads a book. They watch TV."},{"q":"Use an object pronoun.","pt":"Use.","model":"She helps me."},{"q":"Give a command with a phrasal verb.","pt":"Dê.","model":"Stand up, please."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 S-V-O sentences.","model":"I eat bread. She reads a book. They watch TV. He writes a letter. We drink coffee.","checklist":["Usei **S + V + 