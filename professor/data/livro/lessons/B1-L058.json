art.)","a":"decided","why":"Present Perfect."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["phone booth","cabine telefônica"],["town square","praça da cidade"],["coin phone","telefone de moeda"],["long queue","fila longa"],["mobile phone","celular"]]},{"type":"order","title":"Put the words in order","items":[{"words":["to","it","What","will","happen"],"ans":"What will happen to it","pt":"O que acontecerá com ela?"},{"words":["library","It","will","become","a"],"ans":"It will become a library","pt":"Virará uma biblioteca."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"phone booth","pos":"word","pt":"cabine telefônica","ex":"Phone booth.","expt":"Cabine telefônica."},{"w":"coin phone","pos":"word","pt":"telefone de moeda","ex":"Coin phone.","expt":"Telefone de moeda."},{"w":"long queue","pos":"word","pt":"fila longa","ex":"Long queue.","expt":"Fila longa."},{"w":"mobile phone","pos":"word","pt":"celular","ex":"Mobile phone.","expt":"Celular."},{"w":"small library","pos":"word","pt":"biblioteca pequena","ex":"Small library.","expt":"Biblioteca pequena."},{"w":"last booth","pos":"word","pt":"última cabine","ex":"Last booth.","expt":"Última cabine."},{"w":"public phone","pos":"word","pt":"telefone público","ex":"Public phone.","expt":"Telefone público."},{"w":"family call","pos":"word","pt":"ligação familiar","ex":"Family call.","expt":"Ligação familiar."},{"w":"phone card","pos":"word","pt":"cartão telefônico","ex":"Phone card.","expt":"Cartão telefônico."},{"w":"booth door","pos":"word","pt":"porta da cabine","ex":"Booth door.","expt":"Porta da cabine."},{"w":"glass panel","pos":"word","pt":"painel de vidro","ex":"Glass panel.","expt":"Painel de vidro."},{"w":"red booth","pos":"word","pt":"cabine vermelha","ex":"Red booth.","expt":"Cabine vermelha."},{"w":"reader’s corner","pos":"word","pt":"cantinho do leitor","ex":"Reader’s corner.","expt":"Cantinho do leitor."},{"w":"town history","pos":"word","pt":"história da cidade","ex":"Town history.","expt":"História da cidade."},{"w":"local memory","pos":"word","pt":"memória local","ex":"Local memory.","expt":"Memória local."},{"w":"retired man","pos":"word","pt":"aposentado","ex":"Retired man.","expt":"Aposentado."},{"w":"council vote","pos":"word","pt":"votação do conselho","ex":"Council vote.","expt":"Votação do conselho."},{"w":"coin slot","pos":"word","pt":"fenda de moedas","ex":"Coin slot.","expt":"Fenda de moedas."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**End of an era.** — Fim de uma era.","**Times have changed.** — Os tempos mudaram.","**It’s a sign of the times.** — É sinal dos tempos.","**What will happen to it?** — O que acontecerá com ela?","**It will become a library.** — Virará uma biblioteca.","**Did you use to call from this booth?** — Você costumava ligar desta cabine?","**Not bad at all.** — Nada mal.","**One way or another,…** — De um jeito ou de outro,…"]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"refuse","pt":"recusar","forms":[["I / you / we / they refuse","She refused to go."],["he / she / it refuses","Ela se recusou a ir."]]}]}]},{"tag":"Escuta e diálogo","title":"Town talk","blocks":[{"type":"dialog","title":"Town talk","lines":[["Reporter","Did you use to call from this booth?","Você costumava ligar desta cabine?"],["Ben","Yes. I refused to buy a mobile phone.","Sim. Recusei-me a comprar um celular."],["Reporter","What will happen to it?","O que acontecerá com ela?"],["Ben","It will become a library.","Virará uma biblioteca."]]},{"type":"pron","title":"Pronúncia: Contrações e fala conectada (compreensão)","items":[{"label":"Contrações e fala conectada (compreensão)","note":"Reconheça: I’ve → /aɪv/, she’s → /ʃiz/, wouldn’t’ve, whaddaya (what do you), gonna, wanna.","words":["I’ve been there.","She’s been studying.","What do you want?","I’d’ve gone."]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Use used to for a town habit.","pt":"Use.","model":"People used to queue here."},{"q":"Use refuse.","pt":"Use.","model":"He refused to leave."},{"q":"Report a decision.","pt":"Relate.","model":"The council has decided to close it."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-line news report using used to.","model":"The last phone booth closed on Friday. Residents used to queue there. Ben refused to buy a mobile phone for years. “We didn’t use to have phones,” he said. The council has decided to open a small library. The town will keep the booth.","checklist":["Usei **used to**","Usei **refuse to**","Notícia clara"],"words":"6 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “phone booth” mean?","opts":["cabine telefônica","praça da cidade","fila longa"],"ans":0,"why":"**phone booth** = cabine telefônica."},{"q":"What does “town square” mean?","opts":["telefone de moeda","praça da cidade","celular"],"ans":1,"why":"**town square** = praça da cidade."},{"q":"What does “coin phone” mean?","opts":["fila longa","conselho municipal","telefone de moeda"],"ans":2,"why":"**coin phone** = telefone de moeda."},{"q":"What does “long queue” mean?","opts":["fila longa","celular","biblioteca pequena"],"ans":0,"why":"**long queue** = fila longa."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}