 word to its meaning","pairs":[["good advice","bom conselho"],["helpful friend","amigo prestativo"],["emotional support","apoio emocional"],["bad day","dia ruim"],["deep breath","respiração profunda"]]},{"type":"order","title":"Put the words in order","items":[{"words":["rest","He","advised","me","to"],"ans":"He advised me to rest","pt":"Aconselhou-me a descansar."},{"words":["not","to","worry","He","told","you"],"ans":"He told you not to worry","pt":"Ele disse para não se preocupar."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"good advice","pos":"word","pt":"bom conselho","ex":"Good advice.","expt":"Bom conselho."},{"w":"helpful friend","pos":"word","pt":"amigo prestativo","ex":"Helpful friend.","expt":"Amigo prestativo."},{"w":"emotional support","pos":"word","pt":"apoio emocional","ex":"Emotional support.","expt":"Apoio emocional."},{"w":"heart-to-heart","pos":"word","pt":"conversa franca","ex":"Heart-to-heart.","expt":"Conversa franca."},{"w":"comfort words","pos":"word","pt":"palavras de conforto","ex":"Comfort words.","expt":"Palavras de conforto."},{"w":"panic attack","pos":"word","pt":"crise de pânico","ex":"Panic attack.","expt":"Crise de pânico."},{"w":"warm hug","pos":"word","pt":"abraço caloroso","ex":"Warm hug.","expt":"Abraço caloroso."},{"w":"listening ear","pos":"word","pt":"ouvido atento","ex":"Listening ear.","expt":"Ouvido atento."},{"w":"kind invitation","pos":"word","pt":"convite gentil","ex":"Kind invitation.","expt":"Convite gentil."},{"w":"friend in need","pos":"word","pt":"amigo em necessidade","ex":"Friend in need.","expt":"Amigo em necessidade."},{"w":"cheer-up call","pos":"word","pt":"ligação para animar","ex":"Cheer-up call.","expt":"Ligação para animar."},{"w":"tough time","pos":"word","pt":"momento difícil","ex":"Tough time.","expt":"Momento difícil."},{"w":"open heart","pos":"word","pt":"coração aberto","ex":"Open heart.","expt":"Coração aberto."},{"w":"tea together","pos":"word",