king","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say what is in your fridge.","pt":"Diga.","model":"There are two eggs. There is some milk."},{"q":"Give a kitchen command with turn on.","pt":"Diga.","model":"Turn on the stove."},{"q":"Ask: Is there any cheese?","pt":"Pergunte.","model":"Is there any cheese?"}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 5-line recipe using there is / are and turn on.","model":"There are two eggs. There is some cheese. Turn on the stove. Break the eggs. Cook for three minutes.","checklist":["Usei **there is/are**","Usei **turn on**","Usei **imperativos**"],"words":"5 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “closed” mean?","opts":["queijo","rápido","fechado"],"ans":2,"why":"**closed** = fechado."},{"q":"What does “cheese” mean?","opts":["queijo","difícil","lento"],"ans":0,"why":"**cheese** = queijo."},{"q":"What does “difficult” mean?","opts":["rápido","difícil","cuidadoso"],"ans":1,"why":"**difficult** = difícil."},{"q":"What does “quick” mean?","opts":["lento","alto (som)","rápido"],"ans":2,"why":"**quick** = rápido."},{"q":"“Turn on the stove” means…","opts":["Ligue o fogão","Desligue o fogão","Compre o fogão"],"ans":0,"why":"turn on = ligar."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Em **Reading**, receitas usam **imperativos numerados**.","Em **Writing**, use verbos de ação precisos."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Faça uma **receita em aula** com ingredientes reais.","Compare **contável × incontável**.","Erro típico: *“There is three eggs.”* → *There are.*"]}]}]}