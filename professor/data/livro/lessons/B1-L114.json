ing · An interview","blocks":[{"type":"iv","intro":"A tech reporter talks about her gadgets.","qa":[["Interviewer: Do you fix your devices yourself?","No, I **have** them **repaired** at a local shop. Last month I **had** my screen **replaced**."],["Interviewer: What else do you **get** done?","I **get** my software **updated** automatically, and I **had** all my data **backed up**."]],"gloss":[["gadget","dispositivo"],["replace","substituir"],["automatically","automaticamente"],["data","dados"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"She fixes her devices herself.","ans":"F","why":"have them repaired."},{"q":"She had her screen replaced last month.","ans":"T","why":"Last month."},{"q":"Her software is updated automatically.","ans":"T","why":"automatically."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“gadget” = ?","opts":["gadget","jardim","gato"],"ans":0,"why":"gadget."},{"q":"“automatically” = ?","opts":["automaticamente","automóvel","astutamente"],"ans":0,"why":"automatically."}]}]},{"tag":"Gramática","title":"have/get + objeto + particípio: uso","blocks":[{"type":"table","head":["Situação","Exemplo"],"rows":[["serviço","**I had my hair cut.**"],["conserto","**She got her phone fixed.**"],["pergunta","**Where do you get it done?**"],["negativa","**I haven’t had it checked.**"]],"cap":"have/get + objeto + particípio: uso"},{"type":"box","kind":"look","t":"Regra","body":"Use para serviços: *have my car washed*, *get my photo printed*, *have my eyes tested*."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"I ___ my screen replaced. (have, past)","a":"had","why":"have + obj + part."},{"s":"She ___ her software updated. (get)","a":"gets","why":"get + obj + part."},{"s":"We had our data ___ up. (back, part.)","a":"backed","why":"particípio."},{"s":"I haven’t had it ___ . (check, part.)","a":"checked","why":"particípio."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["local shop","loja local"],["screen replacement","troca de tela"],["data backup","cópia de dados"],["auto update","atualização automática"],["tech gadget","gadget de tecnologia"]]},{"type":"order","title":"Put the words in order","items":[{"words":["your","data","backed","up","Did","you","have"],"ans":"Did you have your data backed up","pt":"Fez backup dos seus dados?"},{"words":["your","screen","replaced","Where","did","you","have"],"ans":"Where did you have your screen replaced","pt":"Onde você trocou a tela?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"local shop","pos":"word","pt":"loja local","ex":"Local shop.","expt":"Loja local."},{"w":"screen replacement","pos":"word","pt":"troca de tela","ex":"Screen replacement.","expt":"Troca de tela."},{"w":"auto update","pos":"word","pt":"atualização automática","ex":"Auto update.","expt":"Atualização automática."},{"w":"tech gadget","pos":"word","pt":"gadget de tecnologia","ex":"Tech gadget.","expt":"Gadget de tecnologia."},{"w":"repair service","pos":"word","pt":"serviço de conserto","ex":"Repair service.","expt":"Serviço de conserto."},{"w":"hair salon","pos":"word","pt":"salão de cabeleireiro","ex":"Hair salon.","expt":"Salão de cabeleireiro."},{"w":"car wash","pos":"word","pt":"lava-rápido","ex":"Car wash.","expt":"Lava-rápido."},{"w":"photo print","pos":"word","pt":"impressão de foto","ex":"Photo print.","expt":"Impressão de foto."},{"w":"dry cleaning","pos":"word","pt":"lavagem a seco","ex":"Dry cleaning.","expt":"Lavagem a seco."},{"w":"haircut","pos":"word","pt":"corte de cabelo","ex":"Haircut.","expt":"Corte de cabelo."},{"w":"nail salon","pos":"word","pt":"salão de manicure","ex":"Nail salon.","expt":"Salão de manicure."},{"w":"tailor shop","pos":"word","pt":"alfaiataria","ex":"Tailor shop.","expt":"Alfaiataria."},{"w":"key copy","pos":"word","pt":"cópia de chave","ex":"Key co