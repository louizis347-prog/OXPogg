entar, defender"],["**renovate**","reformar"],["**dissolve**","dissolver"],["**isolate**","isolar"],["**stage**","encenar"],["**reconcile**","reconciliar"],["**differentiate**","diferenciar"],["**facilitate**","facilitar"],["**screen**","rastrear, examinar"],["**consolidate**","consolidar"],["**postpone**","adiar"],["**credit**","atribuir mérito"],["**trim**","ajustar, aparar"],["**simplify**","simplificar"],["**infringe**","infringir, violar (direito)"],["**standardise**","padronizar"]],"cap":"Verbos vistos nesta unidade"},{"type":"box","kind":"look","t":"Revisão","body":"Diga uma frase com cada verbo. Atenção a **he / she / it**: o verbo muda (**has, does, goes**)."}]},{"tag":"Escuta e diálogo","title":"Unit review","blocks":[{"type":"dialog","title":"Unit review","lines":[["Ana","Was the project about correcting mistakes?","O projeto era sobre corrigir erros?"],["Leo","Not so much correcting as reconciling.","Não tanto corrigir quanto conciliar."],["Ana","What happened to unused terms?","O que aconteceu com os termos sem uso?"],["Leo","They were weeded out.","Foram descartados."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"Ajuste refinado de entonação","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"Ritmo e ênfase para nuances","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Contrast two reasons with not so much… as….","pt":"Contraste.","model":"I chose it not so much for the salary as for the team."},{"q":"Disagree politely in writing.","pt":"Discorde.","model":"We respectfully disagree with that reading."},{"q":"Use weed out.","pt":"Use.","model":"We weeded out the weakest candidates."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-sentence note on how a team can agree on technical vocabulary, using the unit structures.","model":"A shared glossary is less a list than an agreement. Rather than impose words, we should invite people to choose them. The aim is not so much accuracy as trust. We will weed out variants nobody uses. Where a colleague disagrees, we will say so respectfully. Precision, after all, belongs to everyone who has to use it.","checklist":["Usei **less… than**","Usei **rather than**","Usei **weed out**"],"words":"6 frases"}]},{"tag":"Revisão e exame","title":"Review · Spaced practice · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “alleged theft” mean?","opts":["guia do editor","suposto furto","calibração"],"ans":1,"why":"**alleged theft** = suposto furto."},{"q":"What does “editor’s guide” mean?","opts":["transferência de propriedade","retrato em contraluz","guia do editor"],"ans":2,"why":"**editor’s guide** = guia do editor."},{"q":"What does “conveyancing” mean?","opts":["transferência de propriedade","calibração","suposto furto"],"ans":0,"why":"**conveyancing** = transferência de propriedade."},{"q":"What does “calibration” mean?","opts":["retrato em contraluz","calibração","guia do editor"],"ans":1,"why":"**calibration** = calibração."},{"q":"What does “backlit portrait” mean?","opts":["suposto furto","transferência de propriedade","retrato em contraluz"],"ans":2,"why":"**backlit portrait** = retrato em contraluz."}]},{"type":"box","kind":"exam","t":"Plano de revisão espaçada","body":["**Hoje:** refaça os quadros 6 e 7.","**Em 3 dias:** diga as frases do quadro 10 sem olhar.","**Em 7 dias:** escreva de memória o texto do quadro 11.","Em provas C2, estruturas de contraste elaboradas aparecem em Use of English e em Writing."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Peça que os alunos expliquem a diferença entre not X but Y e not so much X as Y.","Retome o quadro 5 com exemplos próprios.","Registre erros de paralelismo."]}]}]}