,{"s":"Do you mind ___ ? (wait -ing)","a":"waiting","why":"mind + -ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["job satisfaction","satisfação no emprego"],["work colleague","colega de trabalho"],["team lunch","almoço da equipe"],["office break","pausa no escritório"],["work tiredness","cansaço no trabalho"]]},{"type":"order","title":"Put the words in order","items":[{"words":["mind","helping","me","Do","you"],"ans":"Do you mind helping me","pt":"Importa-se de me ajudar?"},{"words":["working","here","Do","you","enjoy"],"ans":"Do you enjoy working here","pt":"Gosta de trabalhar aqui?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"work colleague","pos":"word","pt":"colega de trabalho","ex":"Work colleague.","expt":"Colega de trabalho."},{"w":"office break","pos":"word","pt":"pausa no escritório","ex":"Office break.","expt":"Pausa no escritório."},{"w":"work tiredness","pos":"word","pt":"cansaço no trabalho","ex":"Work tiredness.","expt":"Cansaço no trabalho."},{"w":"planning stage","pos":"word","pt":"etapa de planejamento","ex":"Planning stage.","expt":"Etapa de planejamento."},{"w":"worker survey","pos":"word","pt":"pesquisa com trabalhadores","ex":"Worker survey.","expt":"Pesquisa com trabalhadores."},{"w":"workplace mood","pos":"word","pt":"clima do trabalho","ex":"Workplace mood.","expt":"Clima do trabalho."},{"w":"morning routine","pos":"word","pt":"rotina da manhã","ex":"Morning routine.","expt":"Rotina da manhã."},{"w":"team happiness","pos":"word","pt":"felicidade da equipe","ex":"Team happiness.","expt":"Felicidade da equipe."},{"w":"work friendship","pos":"word","pt":"amizade no trabalho","ex":"Work friendship.","expt":"Amizade no trabalho."},{"w":"desk job","pos":"word","pt":"trabalho de escritório","ex":"Desk job.","expt":"Trabalho de escritório."},{"w":"paid leave","pos":"word","pt":"licença remunerada","ex":"Paid leave.","expt":"Licença remunerada."},{"w":"work reward","pos":"word","pt":"recompensa no trabalho","ex":"Work reward.","expt":"Recompensa no trabalho."},{"w":"employee survey","pos":"word","pt":"pesquisa com funcionários","ex":"Employee survey.","expt":"Pesquisa com funcionários."},{"w":"office morale","pos":"word","pt":"moral do escritório","ex":"Office morale.","expt":"Moral do escritório."},{"w":"importance","pos":"word","pt":"importance","ex":"importância","expt":"Great importance."},{"w":"convenience store","pos":"word","pt":"convenience store","ex":"loja de conveniência","expt":"A convenience store."},{"w":"dining room","pos":"word","pt":"dining room","ex":"sala de jantar","expt":"A formal dining room."},{"w":"waiting list","pos":"word","pt":"waiting list","ex":"lista de espera","expt":"On the waiting list."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Not at all.** — De jeito nenhum.","**I don’t mind.** — Não me importo.","**Can’t help it.** — Não consigo evitar.","**Do you enjoy working here?** — Gosta de trabalhar aqui?","**Yes, I enjoy talking to my colleagues.** — Sim, gosto de conversar com colegas.","**Do you mind helping me?** — Importa-se de me ajudar?","**Fly by the seat of your pants.** — Improvisar.","**For the record,…** — Para constar,…"]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"enjoy","pt":"curtir","forms":[["I / you / we / they enjoy","I enjoy music."],["he / she / it enjoys","Eu curto música."]]}]}]},{"tag":"Escuta e diálogo","title":"Office chat","blocks":[{"type":"dialog","title":"Office chat","lines":[["Ana","Do you enjoy working here?","Gosta de trabalhar aqui?"],["Leo","Yes, I enjoy talking to my colleagues.","Sim, gosto de conversar com colegas."],["Ana","Do you mind helping me?","Importa-se de me ajudar?"],["Leo","Not at all. I just finished writing my report.","De jeito nenhum. Acabei de escrever meu relatório."]]},{"type":"pron","title":"Pronúncia: Entonação","items":[{"label":"Entonação","note":"Perguntas de sim/não sobe