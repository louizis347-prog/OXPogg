se yesterday. (discuss, past)","a":"discussed","why":"Past Simple."},{"s":"Come and ___ with teachers. (talk)","a":"talk","why":"talk."},{"s":"Ask ___ scholarships. (about)","a":"about","why":"ask about."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["open day","dia aberto"],["college lab","laboratório da faculdade"],["campus tour","visita ao campus"],["free coffee","café grátis"],["course fair","feira de cursos"]]},{"type":"order","title":"Put the words in order","items":[{"words":["free","Is","the","tour"],"ans":"Is the tour free","pt":"A visita é gratuita?"},{"words":["the","coffee","Yes","and","so","is"],"ans":"Yes and so is the coffee","pt":"Sim, e o café também."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"college lab","pos":"word","pt":"laboratório da faculdade","ex":"College lab.","expt":"Laboratório da faculdade."},{"w":"campus tour","pos":"word","pt":"visita ao campus","ex":"Campus tour.","expt":"Visita ao campus."},{"w":"free coffee","pos":"word","pt":"café grátis","ex":"Free coffee.","expt":"Café grátis."},{"w":"course fair","pos":"word","pt":"feira de cursos","ex":"Course fair.","expt":"Feira de cursos."},{"w":"scholarship fund","pos":"word","pt":"fundo de bolsas","ex":"Scholarship fund.","expt":"Fundo de bolsas."},{"w":"admission office","pos":"word","pt":"secretaria de admissão","ex":"Admission office.","expt":"Secretaria de admissão."},{"w":"visitor badge","pos":"word","pt":"crachá de visitante","ex":"Visitor badge.","expt":"Crachá de visitante."},{"w":"information stand","pos":"word","pt":"estande de informações","ex":"Information stand.","expt":"Estande de informações."},{"w":"student guide","pos":"word","pt":"guia estudantil","ex":"Student guide.","expt":"Guia estudantil."},{"w":"program brochure","pos":"word","pt":"folheto do programa","ex":"Program brochure.","expt":"Folheto do programa."},{"w":"tuition fee","pos":"word","pt":"mensalidade","ex":"Tuition fee.","expt":"Mensalidade."},{"w":"registration form","pos":"word","pt":"formulário de inscrição","ex":"Registration form.","expt":"Formulário de inscrição."},{"w":"science lab","pos":"word","pt":"laboratório de ciências","ex":"Science lab.","expt":"Laboratório de ciências."},{"w":"college life","pos":"word","pt":"vida universitária","ex":"College life.","expt":"Vida universitária."},{"w":"degree program","pos":"word","pt":"programa de graduação","ex":"Degree program.","expt":"Programa de graduação."},{"w":"entry requirement","pos":"word","pt":"requisito de entrada","ex":"Entry requirement.","expt":"Requisito de entrada."},{"w":"application deadline","pos":"word","pt":"prazo de inscrição","ex":"Application deadline.","expt":"Prazo de inscrição."},{"w":"campus visit day","pos":"word","pt":"campus visit day","ex":"dia de visita ao campus","expt":"Campus visit day."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Sign up today.** — Inscreva-se hoje.","**Spaces are limited.** — Vagas limitadas.","**Don’t miss out.** — Não perca.","**Can I discuss scholarships here?** — Posso discutir bolsas aqui?","**Yes, at the information stand.** — Sim, no estande de informações.","**Is the tour free?** — A visita é gratuita?","**Now and again.** — Vez ou outra.","**No matter what.** — Não importa o quê."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"discuss","pt":"discutir (um tema)","forms":[["I / you / we / they discuss","Let’s discuss it."],["he / she / it discusses","Vamos discutir isso."]]}]}]},{"tag":"Escuta e diálogo","title":"At the open day","blocks":[{"type":"dialog","title":"At the open day","lines":[["Visitor","Can I discuss scholarships here?","Posso discutir bolsas aqui?"],["Guide","Yes, at the information stand.","Sim, no estande de informações."],["Visitor","Is the tour free?","A visita é gratuita?"],["Guide","Yes, and so is the coffee.","Sim, e o café também."]]},{"type":"pron","title":"Pronúncia: Contrações e fala c