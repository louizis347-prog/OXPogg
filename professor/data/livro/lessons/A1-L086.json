ate","prato"],["mine","meu"]]},{"type":"order","title":"Put the words in order","items":[{"words":["yours","Is","this"],"ans":"Is this yours","pt":"Isto é seu?"},{"words":["it's","mine","No"],"ans":"No it's mine","pt":"Não, é meu."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"missing","pos":"word","pt":"sumido","ex":"Missing keys.","expt":"Chaves sumidas."},{"w":"mine","pos":"word","pt":"meu","ex":"It’s mine.","expt":"É meu."},{"w":"yours","pos":"word","pt":"seu","ex":"Is it yours?","expt":"É seu?"},{"w":"ours","pos":"word","pt":"nosso","ex":"It’s ours.","expt":"É nosso."},{"w":"theirs","pos":"word","pt":"deles","ex":"It’s theirs.","expt":"É deles."},{"w":"breakfast plate","pos":"word","pt":"breakfast plate","ex":"prato de café da manhã","expt":"A breakfast plate."},{"w":"breakfast table","pos":"word","pt":"breakfast table","ex":"mesa do café","expt":"The breakfast table."},{"w":"fried egg","pos":"word","pt":"fried egg","ex":"ovo frito","expt":"A fried egg."},{"w":"orange juice","pos":"word","pt":"orange juice","ex":"suco de laranja","expt":"Orange juice."},{"w":"butter knife","pos":"word","pt":"butter knife","ex":"faca de manteiga","expt":"A butter knife."},{"w":"maple syrup","pos":"word","pt":"maple syrup","ex":"calda de bordo","expt":"Maple syrup."},{"w":"missing bacon","pos":"word","pt":"missing bacon","ex":"bacon sumido","expt":"The missing bacon."},{"w":"dog’s plate","pos":"word","pt":"dog’s plate","ex":"prato do cachorro","expt":"The dog’s plate."},{"w":"my own","pos":"word","pt":"my own","ex":"meu próprio","expt":"My own plate."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**make breakfast** — preparar o café da manhã","**Is this yours?** — Isto é seu?","**No, it’s mine.** — Não, é meu.","**Whose is that?** — De quem é aquele?","**Better late than never.** — Antes tarde do que nunca.","**Easy come, easy go.** — O que vem fácil, vai fácil."]}]},{"tag":"Verbos","title":"Verbs in fo