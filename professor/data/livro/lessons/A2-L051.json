ança"]]},{"type":"order","title":"Put the words in order","items":[{"words":["to","Peru","I","went"],"ans":"I went to Peru","pt":"Fui ao Peru."},{"words":["go","Where","did","you"],"ans":"Where did you go","pt":"Aonde você foi?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"village","pos":"word","pt":"vila","ex":"A small village.","expt":"Uma vila pequena."},{"w":"dawn","pos":"word","pt":"amanhecer","ex":"At dawn.","expt":"Ao amanhecer."},{"w":"storm","pos":"word","pt":"tempestade","ex":"A big storm.","expt":"Uma grande tempestade."},{"w":"guide","pos":"word","pt":"guia","ex":"The guide knew the way.","expt":"O guia sabia o caminho."},{"w":"backpacking trip","pos":"word","pt":"backpacking trip","ex":"viagem de mochila","expt":"A backpacking trip."},{"w":"first journey","pos":"word","pt":"first journey","ex":"primeira viagem","expt":"A first journey."},{"w":"village life","pos":"word","pt":"village life","ex":"vida na vila","expt":"Village life."},{"w":"mountain village","pos":"word","pt":"mountain village","ex":"vila de montanha","expt":"A mountain village."},{"w":"travel story","pos":"word","pt":"travel story","ex":"história de viagem","expt":"A travel story."},{"w":"lost camera","pos":"word","pt":"lost camera","ex":"câmera perdida","expt":"A lost camera."},{"w":"storm warning","pos":"word","pt":"storm warning","ex":"alerta de tempestade","expt":"A storm warning."},{"w":"early start","pos":"word","pt":"early start","ex":"saída cedo","expt":"An early start."},{"w":"travel memory","pos":"word","pt":"travel memory","ex":"lembrança de viagem","expt":"A travel memory."},{"w":"small backpack","pos":"word","pt":"small backpack","ex":"mochila pequena","expt":"A small backpack."},{"w":"local guide","pos":"word","pt":"local guide","ex":"guia local","expt":"A local guide."},{"w":"mountain guide","pos":"word","pt":"mountain guide","ex":"guia de montanha","expt":"Mountain guide."}]},{"type":"box","kind":"culture","t":"Express