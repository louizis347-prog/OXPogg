:"Match the word to its meaning","pairs":[["learning method","método de aprendizagem"],["first woman","primeira mulher"],["medical school","faculdade de medicina"],["children school","escola infantil"],["child development","desenvolvimento infantil"]]},{"type":"order","title":"Put the words in order","items":[{"words":["Italy","in","1870","In"],"ans":"In Italy in 1870","pt":"Na Itália, em 1870."},{"words":["she","develop","What","did"],"ans":"What did she develop","pt":"O que ela desenvolveu?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"first woman","pos":"word","pt":"primeira mulher","ex":"First woman.","expt":"Primeira mulher."},{"w":"medical school","pos":"word","pt":"faculdade de medicina","ex":"Medical school.","expt":"Faculdade de medicina."},{"w":"children school","pos":"word","pt":"escola infantil","ex":"Children school.","expt":"Escola infantil."},{"w":"child development","pos":"word","pt":"desenvolvimento infantil","ex":"Child development.","expt":"Desenvolvimento infantil."},{"w":"life work","pos":"word","pt":"obra de vida","ex":"Life work.","expt":"Obra de vida."},{"w":"famous educator","pos":"word","pt":"educadora famosa","ex":"Famous educator.","expt":"Educadora famosa."},{"w":"teaching legacy","pos":"word","pt":"legado de ensino","ex":"Teaching legacy.","expt":"Legado de ensino."},{"w":"hands-on learning","pos":"word","pt":"aprendizagem prática","ex":"Hands-on learning.","expt":"Aprendizagem prática."},{"w":"self-learning","pos":"word","pt":"autoaprendizagem","ex":"Self-learning.","expt":"Autoaprendizagem."},{"w":"early years","pos":"word","pt":"primeiros anos","ex":"Early years.","expt":"Primeiros anos."},{"w":"new idea","pos":"word","pt":"ideia nova","ex":"New idea.","expt":"Ideia nova."},{"w":"school founder","pos":"word","pt":"fundadora de escola","ex":"School founder.","expt":"Fundadora de escola."},{"w":"world influence","pos":"word","pt":"influência mundial","ex":"World influence.","expt":"