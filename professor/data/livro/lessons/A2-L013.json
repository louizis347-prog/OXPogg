tems":[{"w":"tasty","pos":"word","pt":"gostoso","ex":"A tasty cake.","expt":"Um bolo gostoso."},{"w":"crumb","pos":"word","pt":"migalha","ex":"A cake crumb.","expt":"Uma migalha de bolo."},{"w":"dish","pos":"word","pt":"prato","ex":"A clean dish.","expt":"Um prato limpo."},{"w":"suspect","pos":"word","pt":"suspeito","ex":"The main suspect.","expt":"O principal suspeito."},{"w":"guilty","pos":"word","pt":"culpado","ex":"She looks guilty.","expt":"Ela parece culpada."},{"w":"innocent","pos":"word","pt":"inocente","ex":"The dog is innocent.","expt":"O cachorro é inocente."},{"w":"clue","pos":"word","pt":"pista","ex":"A big clue.","expt":"Uma grande pista."},{"w":"hilarious","pos":"word","pt":"hilário","ex":"A hilarious scene.","expt":"Uma cena hilária."},{"w":"joke","pos":"word","pt":"piada","ex":"Tell a joke.","expt":"Conte uma piada."},{"w":"mess","pos":"word","pt":"bagunça","ex":"What a mess!","expt":"Que bagunça!"}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**Did you eat the cake?** — Você comeu o bolo?","**No, I didn’t.** — Não.","**Did the dog eat it?** — O cachorro comeu?"]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"box","kind":"tip","t":"Verbos desta aula","body":"Esta aula revisa verbos já vistos dentro das frases do diálogo e dos exercícios. Observe: **be, have, do**."}]},{"tag":"Escuta e diálogo","title":"Detective time","blocks":[{"type":"dialog","title":"Detective time","lines":[["Mom","Did you eat the cake?","Você comeu o bolo?"],["Kid","No, I didn’t.","Não."],["Mom","Did the dog eat it?","O cachorro comeu?"],["Kid","No, he didn’t. Grandma did!","Não. A vovó comeu!"]]},{"type":"pron","title":"Pronúncia: Terminações do passado /t/ /d/ /ɪd/","items":[{"label":"Terminações do passado /t/ /d/ /ɪd/","note":"Pratique em voz alta.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Defend yourself: I didn’t…","pt":"Defenda-se.","model":"I didn’t eat the cake!"},{"q":"Ask: Did you…?","pt":"Pergunte.","model":"Did you see the cake?"},{"q":"Answer: Yes, I did.","pt":"Responda.","model":"Yes, I did."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 5-line mystery dialogue (past).","model":"A: Who ate the cake? B: I didn’t eat it. A: Did the dog eat it? B: No, he didn’t. A: Then who did? B: Grandma did.","checklist":["Usei **didn’t**","Usei **Did…?**","Usei **respostas curtas**"],"words":"5 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “tasty” mean?","opts":["migalha","suspeito","gostoso"],"ans":2,"why":"**tasty** = gostoso."},{"q":"What does “crumb” mean?","opts":["migalha","prato","culpado"],"ans":0,"why":"**crumb** = migalha."},{"q":"What does “dish” mean?","opts":["suspeito","prato","inocente"],"ans":1,"why":"**dish** = prato."},{"q":"What does “suspect” mean?","opts":["culpado","pista","suspeito"],"ans":2,"why":"**suspect** = suspeito."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}