","bank":null,"items":[{"s":"She ___ that the result is right. (claim)","a":"claims","why":"verbo."},{"s":"He ___ out that the sample is small. (point)","a":"points","why":"point out."},{"s":"I ___ on checking again. (insist)","a":"insist","why":"insist on."},{"s":"She ___ making a mistake. (deny)","a":"denies","why":"deny + -ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["lab debate","debate de laboratório"],["small sample","amostra pequena"],["first test","primeiro teste"],["fresh check","nova checagem"],["publication rush","pressa de publicar"]]},{"type":"order","title":"Put the words in order","items":[{"words":["checking","again","I","insist","on"],"ans":"I insist on checking again","pt":"Insisto em checar de novo."},{"words":["right","I","claim","the","result","is"],"ans":"I claim the result is right","pt":"Afirmo que o resultado está certo."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"lab debate","pos":"word","pt":"debate de laboratório","ex":"Lab debate.","expt":"Debate de laboratório."},{"w":"first test","pos":"word","pt":"primeiro teste","ex":"First test.","expt":"Primeiro teste."},{"w":"fresh check","pos":"word","pt":"nova checagem","ex":"Fresh check.","expt":"Nova checagem."},{"w":"publication rush","pos":"word","pt":"pressa de publicar","ex":"Publication rush.","expt":"Pressa de publicar."},{"w":"lab disagreement","pos":"word","pt":"desacordo de laboratório","ex":"Lab disagreement.","expt":"Desacordo de laboratório."},{"w":"microscope","pos":"word","pt":"microscópio","ex":"Microscope.","expt":"Microscópio."},{"w":"test tube","pos":"word","pt":"tubo de ensaio","ex":"Test tube.","expt":"Tubo de ensaio."},{"w":"centrifuge","pos":"word","pt":"centrífuga","ex":"Centrifuge.","expt":"Centrífuga."},{"w":"petri dish","pos":"word","pt":"placa de Petri","ex":"Petri dish.","expt":"Placa de Petri."},{"w":"lab coat","pos":"word","pt":"jaleco","ex":"Lab coat.","expt":"Jaleco."},{"w":"fu