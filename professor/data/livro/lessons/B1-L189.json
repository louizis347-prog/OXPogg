lerts. (check -ing)","a":"checking","why":"-ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["student time","tempo do estudante"],["phone hours","horas de celular"],["daily commute","deslocamento diário"],["bus ride","viagem de ônibus"],["time use","uso do tempo"]]},{"type":"order","title":"Put the words in order","items":[{"words":["commute","It","takes","me","an","hour","to"],"ans":"It takes me an hour to commute","pt":"Levo uma hora para me deslocar."},{"words":["spend","time","reading","Maybe","we","should"],"ans":"Maybe we should spend time reading","pt":"Talvez devêssemos passar tempo lendo."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"student time","pos":"word","pt":"tempo do estudante","ex":"Student time.","expt":"Tempo do estudante."},{"w":"phone hours","pos":"word","pt":"horas de celular","ex":"Phone hours.","expt":"Horas de celular."},{"w":"daily commute","pos":"word","pt":"deslocamento diário","ex":"Daily commute.","expt":"Deslocamento diário."},{"w":"time use","pos":"word","pt":"uso do tempo","ex":"Time use.","expt":"Uso do tempo."},{"w":"study hours","pos":"word","pt":"horas de estudo","ex":"Study hours.","expt":"Horas de estudo."},{"w":"scroll habit","pos":"word","pt":"hábito de rolar","ex":"Scroll habit.","expt":"Hábito de rolar."},{"w":"alert check","pos":"word","pt":"checagem de alertas","ex":"Alert check.","expt":"Checagem de alertas."},{"w":"time study","pos":"word","pt":"estudo sobre o tempo","ex":"Time study.","expt":"Estudo sobre o tempo."},{"w":"time chart","pos":"word","pt":"gráfico de tempo","ex":"Time chart.","expt":"Gráfico de tempo."},{"w":"class hours","pos":"word","pt":"carga horária","ex":"Class hours.","expt":"Carga horária."},{"w":"free hours","pos":"word","pt":"horas livres","ex":"Free hours.","expt":"Horas livres."},{"w":"waste of time","pos":"word","pt":"perda de tempo","ex":"Waste of time.","expt":"Perda de tempo."},{"w":"student schedule","pos":"wo