itle":"Final check","items":[{"q":"What does “lunch” mean?","opts":["iogurte","almoço","aquele"],"ans":1,"why":"**lunch** = almoço."},{"q":"What does “yogurt” mean?","opts":["armário","portanto","iogurte"],"ans":2,"why":"**yogurt** = iogurte."},{"q":"What does “cupboard” mean?","opts":["armário","aquele","almoço"],"ans":0,"why":"**cupboard** = armário."},{"q":"What does “that” mean?","opts":["portanto","aquele","iogurte"],"ans":1,"why":"**that** = aquele."},{"q":"What does “therefore” mean?","opts":["almoço","armário","portanto"],"ans":2,"why":"**therefore** = portanto."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","Na prova, não deixe questões em branco: arrisque a melhor opção."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique **sem consulta** e com tempo.","Grave a parte oral.","Use a lista para **autoavaliação**."]}]}]}