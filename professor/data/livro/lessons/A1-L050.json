ialog","title":"Signing up","lines":[["Ana","Is there a class on Saturday?","Tem aula no sábado?"],["Clerk","Yes, there is.","Tem."],["Ana","Can I join?","Posso participar?"],["Clerk","Yes, you can.","Pode."],["Ana","How much is it?","Quanto custa?"],["Clerk","It’s twenty dollars.","Vinte dólares."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"do you (fala rápida)","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"sílaba tônica em palavras comuns","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"ship/sheep","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"bed/bad","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"think/this","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Ask about a class.","pt":"Pergunte.","model":"Is there a class on Saturday?"},{"q":"Say what you can do in the kitchen.","pt":"Diga.","model":"I can make soup."},{"q":"Give two rules.","pt":"Diga.","model":"Wash your hands. Don’t be late."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a short notice for a class (5 sentences).","model":"There is a class on Saturday. There are ten places. You can learn to make soup. Wash your hands. Come and have fun!","checklist":["Usei **there is/are**","Usei **can**","Usei **imperativo**"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Assessment · Score and next steps","blocks":[{"type":"table","head":["Parte","O que avaliar","Pontos"],"rows":[["Leitura","Quadros 3–4: ideias principais e vocabulário","/ 10"],["Escuta","Quadro 9: entender o diálogo e repetir","/ 10"],["Fala","Quadro 10: frases completas sem pausas longas","/ 10"],["Escrita","Quadro 11: frases corretas com a lista de verificação","/ 10"]],"cap":"Autoavaliação (40 pontos)"},{"type":"box","kind":"look","t":"Critério de conclusão","body":