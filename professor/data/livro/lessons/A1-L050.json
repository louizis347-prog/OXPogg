ion","tradition"],["festival","festival"],["dialect","dialect"],["heritage","heritage"],["custom","custom"],["landmark","landmark"],["population","population"]]},{"type":"vocab","items":[{"w":"website","pos":"word","pt":"site","ex":"Visit our website.","expt":"Visite nosso site."},{"w":"video","pos":"word","pt":"vídeo","ex":"A short video.","expt":"Um vídeo curto."},{"w":"beef","pos":"word","pt":"carne bovina","ex":"I like beef.","expt":"Gosto de carne bovina."},{"w":"pork","pos":"word","pt":"carne de porco","ex":"Pork and rice.","expt":"Carne de porco e arroz."}]},{"type":"box","kind":"culture","t":"Novas expressões da revisão","body":["**I’m looking forward to it.** — Estou ansioso por isso.","**What do you recommend?** — O que você recomenda?"]},{"type":"box","kind":"tip","t":"Estratégia","body":"Escolha **5 palavras** que ainda travam. Escreva uma frase **sua** com cada uma e diga em voz alta."}]},{"tag":"Verbos","title":"Verbs of the unit","blocks":[{"type":"table","head":["Verbo","Significado"],"rows":[["**have**","ter, tomar, comer"],["**wake**","acordar"],["**think**","pensar"],["**rent**","alugar"],["**sleep**","dormir"],["**crack**","quebrar"],["**enjoy**","curtir"],["**wash**","lavar"],["**go**","ir"],["**clean**","limpar"],["**apply**","candidatar-se"],["**cook**","cozinhar"],["**review**","revisar"],["**return**","devolver"],["**come**","vir"],["**buy**","comprar"]],"cap":"Verbos vistos nesta unidade"},{"type":"box","kind":"look","t":"Revisão","body":"Diga uma frase com cada verbo. Atenção a **he / she / it**: o verbo muda (**has, does, goes**)."}]},{"tag":"Escuta e diálogo","title":"Signing up","blocks":[{"type":"dialog","title":"Signing up","lines":[["Ana","Is there a class on Saturday?","Tem aula no sábado?"],["Clerk","Yes, there is.","Tem."],["Ana","Can I join?","Posso participar?"],["Clerk","Yes, you can.","Pode."],["Ana","How much is it?","Quanto custa?"],["Clerk","It’s twenty dollars.","Vinte dólares."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"do you (fala rápida)","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"sílaba tônica em palavras comuns","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"ship/sheep","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"bed/bad","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"think/this","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Ask about a class.","pt":"Pergunte.","model":"Is there a class on Saturday?"},{"q":"Say what you can do in the kitchen.","pt":"Diga.","model":"I can make soup."},{"q":"Give two rules.","pt":"Diga.","model":"Wash your hands. Don’t be late."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a short notice for a class (5 sentences).","model":"There is a class on Saturday. There are ten places. You can learn to make soup. Wash your hands. Come and have fun!","checklist":["Usei **there is/are**","Usei **can**","Usei **imperativo**"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Assessment · Score and next steps","blocks":[{"type":"table","head":["Parte","O que avaliar","Pontos"],"rows":[["Leitura","Quadros 3–4: ideias principais e vocabulário","/ 10"],["Escuta","Quadro 9: entender o diálogo e repetir","/ 10"],["Fala","Quadro 10: frases completas sem pausas longas","/ 10"],["Escrita","Quadro 11: frases corretas com a lista de verificação","/ 10"]],"cap":"Autoavaliação (40 pontos)"},{"type":"box","kind":"look","t":"Critério de conclusão","body":"**28 a 40 pontos:** siga para a próxima unidade. **20 a 27:** repita as aulas em que errou mais. **Menos de 20:** volte à Unidade e refaça os exercícios dos quadros 5 e 6."},{"type":"mcq","title":"Final check","items":[{"q":"What does “lunch” mean?","opts":["yogurt","almoço","aquele"],"ans":1,"why":"**lunch** = almoço."},{"q":"What does “yogurt” mean?","opts":["cupboard","therefore","yogurt"],"ans":2,"why":"**yogurt** = yogurt."},{"q":"What does “cupboard” mean?","opts":["cupboard","aquele","almoço"],"ans":0,"why":"**cupboard** = cupboard."},{"q":"What does “that” mean?","opts":["therefore","aquele","yogurt"],"ans":1,"why":"**that** = aquele."},{"q":"What does “therefore” mean?","opts":["almoço","cupboard","therefore"],"ans":2,"why":"**therefore** = therefore."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","Na prova, não deixe questões em branco: arrisque a melhor opção."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique **sem consulta** e com tempo.","Grave a parte oral.","Use a lista para **autoavaliação**."]}]}]}