,["firm insistence","insistência firme"],["quiet queue","fila silenciosa"],["locked doors","portas trancadas"],["buttoned coat","casaco abotoado"],["patient wait","espera paciente"],["child’s question","pergunta de criança"],["counted bags","sacolas contadas"],["lit shelf","prateleira iluminada"],["bare shelf","prateleira vazia"],["silent hunger","fome silenciosa"],["winter rain","chuva de inverno"],["poem tone","tom do poema"],["sombre mood","clima sombrio"],["extended metaphor","metáfora estendida"],["sensory image","imagem sensorial"],["symbolic object","objeto simbólico"],["rhyme pattern","padrão de rimas"],["enjambment","encadeamento de versos"],["speaker’s attitude","atitude do eu lírico"],["poet’s purpose","propósito do poeta"],["literal meaning","sentido literal"],["figurative reading","leitura figurada"],["emotional effect","efeito emocional"]]},{"type":"vocab","items":[]},{"type":"box","kind":"culture","t":"Novas expressões da revisão","body":["**It’s up to you.** — Você decide.","**No problem.** — Sem problema."]},{"type":"box","kind":"tip","t":"Estratégia","body":"Escolha **5 palavras** que ainda travam. Escreva uma frase **sua** com cada uma e diga em voz alta."}]},{"tag":"Verbos","title":"Verbs of the unit","blocks":[{"type":"table","head":["Verbo","Significado"],"rows":[["**correlate**","correlacionar(-se)"],["**keep**","manter; guardar; continuar"],["**rely**","depender; contar com"],["**shelter**","abrigar"],["**donate**","doar"],["**submit**","enviar; submeter"],["**realise**","perceber; dar-se conta"],["**assess**","avaliar"],["**attribute**","atribuir"],["**redesign**","reformular; redesenhar"],["**match**","associar; combinar"],["**evaluate**","avaliar"],["**depend**","depender"],["**recruit**","recrutar"],["**link**","ligar; conectar"],["**insist**","insistir"],["**convey**","transmitir"]],"cap":"Verbos vistos nesta unidade"},{"type":"box","kind":"look","t":"Revisão","body":"Diga uma frase com cada verbo. Atenção a **he / she / it**: o verbo muda (**has, does, goes**)."}]},{"tag":"Escuta e diálogo","title":"Review chat","blocks":[{"type":"dialog","title":"Review chat","lines":[["Ana","What is said to have grown fast?","O que se diz que cresceu rápido?"],["Leo","The food bank service.","O serviço de bancos de alimentos."],["Ana","What should governments take into consideration?","O que os governos devem levar em consideração?"],["Leo","Low wages and living costs.","Salários baixos e custo de vida."]]},{"type":"pron","title":"Pronúncia da unidade","items":[{"label":"Pausas e ritmo","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"Expressividade","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"Organização da informação pela entonação","note":"Revise com o áudio das aulas anteriores.","words":[]},{"label":"Ênfase intencional","note":"Revise com o áudio das aulas anteriores.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Use a reporting passive.","pt":"Use.","model":"The shelter is expected to open soon."},{"q":"Use the more…, the more…","pt":"Use.","model":"The more we talk, the more we understand."},{"q":"Give a balanced verdict.","pt":"Opine.","model":"On balance, it is persuasive, although limited."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-sentence critical review of a short article, using two structures from the unit.","model":"The article is said to be the first of its kind. It is estimated that thousands read it. A strength is its clear data. However, it fails to take rural areas into consideration. The more I read, the more questions I had. On balance, it is useful, although incomplete.","checklist":["Usei **passiva de relato**","Usei **take into consideration**","Dei um **veredito**"],"words":"6 frases"}]},{"tag":"Revisão e exame","title":"Review · Spaced practice · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “poverty rate” mean?","opts":["atualização semanal","equipe de abordagem","taxa de pobreza"],"ans":2,"why":"**poverty rate** = taxa de pobreza."},{"q":"What does “weekly update” mean?","opts":["atualização semanal","empréstimo consignado de curto prazo","refeição quente"],"ans":0,"why":"**weekly update** = atualização semanal."},{"q":"What does “payday loan” mean?","opts":["equipe de abordagem","empréstimo consignado de curto prazo","taxa de pobreza"],"ans":1,"why":"**payday loan** = empréstimo consignado de curto prazo."},{"q":"What does “outreach team” mean?","opts":["refeição quente","atualização semanal","equipe de abordagem"],"ans":2,"why":"**outreach team** = equipe de abordagem."},{"q":"What does “hot meal” mean?","opts":["refeição quente","taxa de pobreza","empréstimo consignado de curto prazo"],"ans":0,"why":"**hot meal** = refeição quente."}]},{"type":"box","kind":"exam","t":"Plano de revisão espaçada","body":["**Hoje:** refaça os quadros 6 e 7.","**Em 3 dias:** diga as frases do quadro 10 sem olhar.","**Em 7 dias:** escreva de memória o texto do quadro 11.","No IELTS e TOEFL, resenhas e resumos exigem verbos de relato variados."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Reveja os verbos de relato (say, believe, report, expect).","Peça resenhas curtas em pares.","Pratique o subjuntivo com situações de reunião."]}]}]}