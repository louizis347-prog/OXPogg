y council","conselho municipal"],["traffic volume","volume de tráfego"],["urban area","área urbana"],["housing demand","demanda por moradia"],["cycling lane","ciclovia"],["parking fee","taxa de estacionamento"],["city bus","ônibus urbano"],["metro line","linha de metrô"],["population density","densidade populacional"],["infrastructure","infraestrutura"],["toll road","estrada com pedágio"]]}]},{"tag":"Leitura","title":"Reading · A lecture transcript","blocks":[{"type":"text","title":"Lecture: Cities Under Pressure","paras":["Good afternoon. Cities **have been growing** rapidly for decades. In 2000, 47% of people **lived** in cities; today it’s over 55%. Governments **have been investing** in transport, but traffic **hasn’t been improving**.","Last year, the city **introduced** a congestion charge. Since then, emissions **have been falling**. **How long have planners been discussing** this? For nearly ten years."],"kicker":"LECTURE","by":"Prof. Almeida","gloss":[]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"Cities have been growing for decades.","ans":"T","why":"for decades."},{"q":"The congestion charge was introduced last year.","ans":"T","why":"Last year."},{"q":"Traffic has been improving a lot.","ans":"F","why":"hasn’t been improving."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“congestion charge” = ?","opts":["taxa de congestionamento","carga de congestão","custo de trânsito só"],"ans":0,"why":"congestion charge."},{"q":"“emissions” = ?","opts":["emissões","emoções","empresas"],"ans":0,"why":"emissions."}]}]},{"tag":"Gramática","title":"Contínuo × Past Simple","blocks":[{"type":"table","head":["Forma","Foco","Exemplo"],"rows":[["Present Perfect Cont.","processo até agora","**Emissions have been falling.**"],["Past Simple","fato concluído com data","**The city introduced a charge last year.**"],["How long…?","duração","**How long have planners been discussing it?**"],["since / for","ligação com hoje","**since then / for ten years**"]],"cap":"Contínuo × Past Simple"},{"type":"box","kind":"look","t":"Regra","body":"Se há **hora definida** (last year, in 2000), use **Past Simple**. Se o foco é **duração até agora**, use o contínuo."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Cities have been ___ rapidly. (grow -ing)","a":"growing","why":"-ing."},{"s":"The city ___ a charge last year. (introduce, past)","a":"introduced","why":"Past Simple."},{"s":"How long have planners been ___ it? (discuss -ing)","a":"discussing","why":"-ing."},{"s":"Emissions have been ___ since then. (fall -ing)","a":"falling","why":"-ing."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["urban growth","crescimento urbano"],["city population","população da cidade"],["public transport","transporte público"],["traffic jam","engarrafamento"],["congestion charge","taxa de congestionamento"]]},{"type":"order","title":"Put the words in order","items":[{"words":["worked","Has","it"],"ans":"Has it worked","pt":"Funcionou?"},{"words":["been","growing","How","long","has","the","city"],"ans":"How long has the city been growing","pt":"Há quanto tempo a cidade cresce?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"urban growth","pos":"word","pt":"crescimento urbano","ex":"Urban growth.","expt":"Crescimento urbano."},{"w":"city population","pos":"word","pt":"população da cidade","ex":"City population.","expt":"População da cidade."},{"w":"congestion charge","pos":"word","pt":"taxa de congestionamento","ex":"Congestion charge.","expt":"Taxa de congestionamento."},{"w":"carbon emission","pos":"word","pt":"emissão de carbono","ex":"Carbon emission.","expt":"Emissão de carbono."},{"w":"air pollution","pos":"word","pt":"poluição do ar","ex":"Air pollution.","expt":"Poluição do ar."},{"w":"city planner","pos":"word","pt":"urbanista","ex":"City planner.","expt":"Urbanista."},{"w":"transport policy","pos":"word","pt":"política de transporte","ex":"Transport policy.","expt":"Política de transporte."},{"w":"commuter train","pos":"word","pt":"trem de subúrbio","ex":"Commuter train.","expt":"Trem de subúrbio."},{"w":"road network","pos":"word","pt":"malha viária","ex":"Road network.","expt":"Malha viária."},{"w":"city council","pos":"word","pt":"conselho municipal","ex":"City council.","expt":"Conselho municipal."},{"w":"traffic volume","pos":"word","pt":"volume de tráfego","ex":"Traffic volume.","expt":"Volume de tráfego."},{"w":"urban area","pos":"word","pt":"área urbana","ex":"Urban area.","expt":"Área urbana."},{"w":"housing demand","pos":"word","pt":"demanda por moradia","ex":"Housing demand.","expt":"Demanda por moradia."},{"w":"cycling lane","pos":"word","pt":"ciclovia","ex":"Cycling lane.","expt":"Ciclovia."},{"w":"parking fee","pos":"word","pt":"taxa de estacionamento","ex":"Parking fee.","expt":"Taxa de estacionamento."},{"w":"city bus","pos":"word","pt":"ônibus urbano","ex":"City bus.","expt":"Ônibus urbano."},{"w":"metro line","pos":"word","pt":"linha de metrô","ex":"Metro line.","expt":"Linha de metrô."},{"w":"population density","pos":"word","pt":"densidade populacional","ex":"Population density.","expt":"Densidade populacional."},{"w":"infrastructure","pos":"word","pt":"infraestrutura","ex":"Infrastructure.","expt":"Infraestrutura."},{"w":"toll road","pos":"word","pt":"estrada com pedágio","ex":"Toll road.","expt":"Estrada com pedágio."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**On the rise.** — Em alta.","**Gain ground.** — Ganhar terreno.","**Hit the headlines.** — Virar manchete.","**Under pressure.** — Sob pressão.","**Grind to a halt.** — Parar completamente.","**How long has the city been growing?** — Há quanto tempo a cidade cresce?","**Has it worked?** — Funcionou?","**Emissions have been falling since then.** — As emissões têm caído desde então.","**A tough nut to crack.** — Um osso duro de roer."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"introduce","pt":"introduzir","forms":[["I / you / we / they introduce","They introduce a rule."],["he / she / it introduces","Eles introduzem uma regra."]]}]}]},{"tag":"Escuta e diálogo","title":"Q&A","blocks":[{"type":"dialog","title":"Q&A","lines":[["Student","How long has the city been growing?","Há quanto tempo a cidade cresce?"],["Prof.","For decades. Last year it introduced a congestion charge.","Há décadas. Ano passado introduziu uma taxa de congestionamento."],["Student","Has it worked?","Funcionou?"],["Prof.","Emissions have been falling since then.","As emissões têm caído desde então."]]},{"type":"pron","title":"Pronúncia: Ligações e assimilação","items":[{"label":"Ligações e assimilação","note":"Pratique em voz alta.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Ask How long…?","pt":"Pergunte.","model":"How long have you been living here?"},{"q":"Mix both tenses.","pt":"Misture.","model":"I moved in 2020 and have been working since."},{"q":"Describe a trend.","pt":"Descreva.","model":"Prices have been rising."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 6 sentences mixing Present Perfect Continuous and Past Simple about a city.","model":"Cities have been growing for decades. In 2000, 47% of people lived in cities. The city introduced a congestion charge last year. Since then, emissions have been falling. Planners have been discussing the policy for ten years. Traffic hasn’t been improving much.","checklist":["Usei **have been + -ing**","Usei **Past Simple com data**","6 frases"],"words":"6 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “urban growth” mean?","opts":["crescimento urbano","população da cidade","engarrafamen