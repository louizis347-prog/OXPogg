ds":"6 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “first-term councillor” mean?","opts":["eleição distrital","vereadora de primeiro mandato","cartaz de campanha"],"ans":1,"why":"**first-term councillor** = vereadora de primeiro mandato."},{"q":"What does “ward election” mean?","opts":["batida de porta em porta","slogan de campanha","eleição distrital"],"ans":2,"why":"**ward election** = eleição distrital."},{"q":"What does “door-knocking” mean?","opts":["batida de porta em porta","cartaz de campanha","candidata jovem"],"ans":0,"why":"**door-knocking** = batida de porta em porta."},{"q":"What does “campaign poster” mean?","opts":["slogan de campanha","cartaz de campanha","cerimônia de posse"],"ans":1,"why":"**campaign poster** = cartaz de campanha."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}