ng · A hotel review","blocks":[{"type":"text","title":"Review: Hotel Mar Azul ★★★★☆","paras":["We **stayed** three nights. The receptionist **welcomed** us warmly, and the bellboy **carried** our bags. We **loved** the breakfast, but the Wi-Fi **failed** twice.","On the last day we **asked** for a late checkout, and the manager **agreed**. We **recommend** it."],"kicker":"HOTEL REVIEW","by":"Lena & Tom","gloss":[["bellboy","carregador de malas"],["fail","falhar"],["checkout","saída"],["recommend","recomendar"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"They stayed three nights.","ans":"T","why":"“three nights.”"},{"q":"The Wi-Fi worked perfectly.","ans":"F","why":"“failed twice.”"},{"q":"The manager refused a late checkout.","ans":"F","why":"“agreed.”"}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“recommend” means…","opts":["recomendar","recusar","relembrar"],"ans":0,"why":"recommend."},{"q":"“fail” means…","opts":["falhar","passar","ganhar"],"ans":0,"why":"fail."}]}]},{"tag":"Gramática","title":"Past Simple: review","blocks":[{"type":"table","head":["Verbo","Passado","Pronúncia"],"rows":[["work","**worked**","/t/"],["play","**played**","/d/"],["want","**wanted**","/ɪd/"]],"cap":"Past Simple: review"},{"type":"box","kind":"look","t":"Regra","body":"Em avaliações, conte uma sequência: **first, then, after that, finally**."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"The bellboy ___ our bags. (carry)","a":"carried","why":"-ied."},{"s":"We ___ three nights. (stay)","a":"stayed","why":"+ed."},{"s":"The Wi-Fi ___ twice. (fail)","a":"failed","why":"+ed."},{"s":"The manager ___ . (agree)","a":"agreed","why":"+d."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["receptionist","recepcionista"],["bellboy","carregador de malas"],["checkout","saída (hotel)"],["warmly","calorosamente"],["recently","recentemente"]]},{"type":"order","title":"Put the words in order","items":[{"words":["stay","We","loved","our"],"ans":"We loved our stay","pt":"Adoramos a estadia."},{"words":["fixed","it","today","I'm","sorry","We"],"ans":"I'm sorry We fixed it today","pt":"Sinto muito. Consertamos hoje."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"receptionist","pos":"word","pt":"recepcionista","ex":"The receptionist smiled.","expt":"A recepcionista sorriu."},{"w":"bellboy","pos":"word","pt":"carregador de malas","ex":"The bellboy helped.","expt":"O carregador ajudou."},{"w":"checkout","pos":"word","pt":"saída (hotel)","ex":"A late checkout.","expt":"Uma saída tardia."},{"w":"warmly","pos":"word","pt":"calorosamente","ex":"She welcomed us warmly.","expt":"Ela nos recebeu calorosamente."},{"w":"recently","pos":"word","pt":"recentemente","ex":"We stayed there recently.","expt":"Ficamos lá recentemente."},{"w":"complaint","pos":"word","pt":"reclamação","ex":"We made a complaint.","expt":"Fizemos uma reclamação."},{"w":"amenities","pos":"word","pt":"comodidades","ex":"Good amenities.","expt":"Boas comodidades."},{"w":"noisy","pos":"word","pt":"barulhento","ex":"A noisy street.","expt":"Uma rua barulhenta."},{"w":"spotless","pos":"word","pt":"impecável","ex":"A spotless room.","expt":"Um quarto impecável."},{"w":"hotel review","pos":"word","pt":"resenha de hotel","ex":"A hotel review.","expt":"Uma resenha de hotel."},{"w":"front desk","pos":"word","pt":"recepção","ex":"At the front desk.","expt":"Na recepção."},{"w":"sea view","pos":"word","pt":"vista para o mar","ex":"A sea view.","expt":"Uma vista para o mar."},{"w":"room service","pos":"word","pt":"serviço de quarto","ex":"Room service.","expt":"Serviço de quarto."},{"w":"breakfast buffet","pos":"word","pt":"buffet de café","ex":"A breakfast buffet.","expt":"Um buffet de café."},{"w":"check-out time","pos":"word","pt":"hora de saída","ex":"Check-out time.","expt":"Hora de saída."