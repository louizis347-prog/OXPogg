{"id":"A1-L017","title":"Unit 1 assessment","cefr":"A1","level":"A1","unit":"A1-U01","focus":"Avaliação da unidade 1 (leitura, escuta, fala e escrita)","targets":{"grammar":"Avaliação da unidade 1 (leitura, escuta, fala e escrita)","pron":"","verbs":[],"pv":[],"expr":[],"words":["early","late","tired","fine","crazy","teacher","friend","year","boss","office","shop","far","near","free","strict","today","coffee","team","noon","ready","busy","message","minute","think","town","warm","kind","hot","every","street","event","join","tomato","onion","salt","pot","soup","cut","add","eat","routine","breakfast","bread","live","drink","relax","work","brother","ship","sheep","seat","sit","fish","waiter","window","smile","rest","call","always","usually","sometimes","never","Monday","same","sleep","grade","improve","later","start","doctor","teenager","idea","adult","habit","exercise","hour","study","answer","daily","person","shower","break","photo","taxi","test","minute","bus","long","call","family","advice","research","closer","replace","week","miss","library","manager","offer","open","close","reader","class","night","university","gym","restroom","music","news","city","dog","desk","sun","tea","rise","walk","read","write","hard","night"],"field":"Vida pessoal","genre":"Revisão","skill":"Integrada","words_min":1},"frames":[{"tag":"Abertura","title":"Lesson 17 · Unit 1 assessment","blocks":[{"type":"box","kind":"look","t":"Nesta avaliação","body":["**Aulas da unidade:** 15 aulas anteriores.","**Verb to be — revisão e ampliação — introdução**","**Verb to be — revisão e ampliação — prática e contraste**","**Verbo-chave: get**","**Verb to be — revisão e ampliação — produção e revisão**","**Subject + verb — forma**","**Present Simple — introdução**","**ship/sheep**","**Present Simple — prática e contraste**","**120 palavras** da unidade voltam em contextos novos."]},{"type":"p","t":"**Objetivo de comunicação (A1):** eu consigo mostrar, em leitura, escuta, fala e escrita, que domino a Unida