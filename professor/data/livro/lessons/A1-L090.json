:[{"type":"verbs","items":[{"v":"put","pt":"pôr","forms":[["I / you / we / they put","I put the pan on the stove."],["he / she / it puts","She puts the bowl on the table."]]}]}]},{"tag":"Escuta e diálogo","title":"Cooking","blocks":[{"type":"dialog","title":"Cooking","lines":[["Mom","Put your flour in the bowl.","Ponha sua farinha na tigela."],["Kid","Where is my spoon?","Cadê minha colher?"],["Mom","It’s yours, on the table.","É sua, na mesa."],["Kid","Thanks!","Obrigado!"]]},{"type":"pron","title":"Pronúncia: sílaba tônica em palavras comuns","items":[{"label":"sílaba tônica em palavras comuns","note":"Em muitas palavras de duas sílabas a primeira é a forte: TAble, WAter, DOCtor.","words":["table","water","doctor","window"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Give a recipe step with possessive.","pt":"Diga.","model":"Put your flour in our bowl."},{"q":"Say what is yours.","pt":"Diga.","model":"The spoon is mine."},{"q":"Ask: Where is my…?","pt":"Pergunte.","model":"Where is my spoon?"}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 5-step recipe with possessives.","model":"Put your flour in our bowl. Put their eggs next to my milk. Mix with his spoon. Put her pan on the stove. Enjoy our pancakes!","checklist":["Usei **5 possessivos**","Usei **put**","Usei **imperativo**"],"words":"5 passos"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “spoon” mean?","opts":["farinha","fogão","colher"],"ans":2,"why":"**spoon** = colher."},{"q":"What does “flour” mean?","opts":["farinha","misturar","tigela"],"ans":0,"why":"**flour** = farinha."},{"q":"What does “mix” mean?","opts":["fogão","misturar","frigideira"],"ans":1,"why":"**mix** = misturar."},{"q":"What does “stove” mean?","opts":["tigela","tudo","fogão"],"ans":2,"why":"**stove** = fogão."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Use exemplos reais da vida dos alunos e peça frases próprias.","Corrija o erro mais frequente da aula em grupo, sem expor o aluno.","Retome o conteúdo na aula seguinte com um exercício curto."]}]}]}