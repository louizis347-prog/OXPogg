ong have you been ___ ? (listen -ing)","a":"listening","why":"-ing."},{"s":"She has ___ three problems. (solve)","a":"solved","why":"resultado."},{"s":"How many bills ___ you paid? (have)","a":"have","why":"resultado."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["money argument","briga por dinheiro"],["monthly bill","conta mensal"],["family budget","orçamento familiar"],["couple therapy","terapia de casal"],["angry voice","voz zangada"]]},{"type":"order","title":"Put the words in order","items":[{"words":["first","Let's","listen"],"ans":"Let's listen first","pt":"Vamos ouvir primeiro."},{"words":["have","been","arguing","about","money","We"],"ans":"We have been arguing about money","pt":"Estamos brigando por dinheiro."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"money argument","pos":"word","pt":"briga por dinheiro","ex":"Money argument.","expt":"Briga por dinheiro."},{"w":"monthly bill","pos":"word","pt":"conta mensal","ex":"Monthly bill.","expt":"Conta mensal."},{"w":"family budget","pos":"word","pt":"orçamento familiar","ex":"Family budget.","expt":"Orçamento familiar."},{"w":"couple therapy","pos":"word","pt":"terapia de casal","ex":"Couple therapy.","expt":"Terapia de casal."},{"w":"angry voice","pos":"word","pt":"voz zangada","ex":"Angry voice.","expt":"Voz zangada."},{"w":"heated debate","pos":"word","pt":"debate acalorado","ex":"Heated debate.","expt":"Debate acalorado."},{"w":"loud quarrel","pos":"word","pt":"briga barulhenta","ex":"Loud quarrel.","expt":"Briga barulhenta."},{"w":"calm talk","pos":"word","pt":"conversa calma","ex":"Calm talk.","expt":"Conversa calma."},{"w":"shared expense","pos":"word","pt":"despesa compartilhada","ex":"Shared expense.","expt":"Despesa compartilhada."},{"w":"household chore","pos":"word","pt":"tarefa doméstica","ex":"Household chore.","expt":"Tarefa doméstica."},{"w":"marriage advice","pos":"word","pt":"conselho de casamento","ex":"Marriage adv