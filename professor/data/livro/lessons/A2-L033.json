":"box","kind":"look","t":"Critério de conclusão","body":"**28 a 40 pontos:** siga para a próxima unidade. **20 a 27:** repita as aulas em que errou mais. **Menos de 20:** volte à Unidade e refaça os exercícios dos quadros 5 e 6."},{"type":"mcq","title":"Final check","items":[{"q":"What does “marketplace” mean?","opts":["price drop","feira","correria"],"ans":1,"why":"**marketplace** = feira."},{"q":"What does “price drop” mean?","opts":["rolling pin","limonada","price drop"],"ans":2,"why":"**price drop** = price drop."},{"q":"What does “rolling pin” mean?","opts":["rolling pin","correria","feira"],"ans":0,"why":"**rolling pin** = rolling pin."},{"q":"What does “rush” mean?","opts":["limonada","correria","price drop"],"ans":1,"why":"**rush** = correria."},{"q":"What does “lemonade” mean?","opts":["feira","rolling pin","limonada"],"ans":2,"why":"**lemonade** = limonada."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","Administre o tempo: 1 minuto por questão de múltipla escolha."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique sem consulta e com tempo.","Grave a parte oral.","Use a lista para autoavaliação."]}]}]}