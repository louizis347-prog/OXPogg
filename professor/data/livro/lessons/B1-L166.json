 events","atualidades"],["group email","e-mail do grupo"],["club photo","foto do clube"],["club badge","distintivo do clube"],["friendly group","grupo amigável"]]}]},{"tag":"Leitura","title":"Reading · A notice","blocks":[{"type":"ad","title":"Join Our News Club","lines":["Do you love reading the news, **don’t you**? Join our weekly club! We discuss the headlines, **check** the facts and **keep in touch** by chat during the week. All ages welcome. Free coffee!","**Where:** City Library. **When:** Thursdays at 6 p.m. **Contact:** newsclub@mail.com"],"gloss":[["headline","manchete"],["weekly","semanal"],["contact","contato"],["welcome","bem-vindo"]]}]},{"tag":"Compreensão","title":"Did you understand?","blocks":[{"type":"tfng","title":"","items":[{"q":"The club meets weekly.","ans":"T","why":"Thursdays."},{"q":"The club is only for adults.","ans":"F","why":"All ages welcome."},{"q":"Members chat during the week.","ans":"T","why":"keep in touch."}]},{"type":"mcq","title":"Vocabulary in context","items":[{"q":"“keep in touch” = ?","opts":["manter contato","guardar o toque","tocar"],"ans":0,"why":"keep in touch."},{"q":"“headline” = ?","opts":["manchete","cabeça","cabelo"],"ans":0,"why":"headline."}]}]},{"tag":"Gramática","title":"Convidar para um clube","blocks":[{"type":"table","head":["Elemento","Exemplo"],"rows":[["gancho","**Do you love the news, don’t you?**"],["atividades","**We discuss, check, keep in touch**"],["detalhes","**Where / When / Contact**"],["convite","**All ages welcome!**"]],"cap":"Convidar para um clube"},{"type":"box","kind":"look","t":"Regra","body":"Avisos usam **question tags** para engajar e **imperativo** para chamar à ação."}]},{"tag":"Prática","title":"Practice","blocks":[{"type":"gap","title":"Complete the sentences","bank":null,"items":[{"s":"Do you love the news, ___ you? (don’t)","a":"don’t","why":"tag."},{"s":"We ___ the facts. (check)","a":"check","why":"verbo."},{"s":"We keep in ___ by chat. (touch)","a":"touch","why":"keep in touch.