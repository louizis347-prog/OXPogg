n out."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["life turn","virada de vida"],["big birthday","aniversário importante"],["job refusal","recusa de emprego"],["new plan","plano novo"],["friend’s help","ajuda de amigo"]]},{"type":"order","title":"Put the words in order","items":[{"words":["it","down","No","I","turned"],"ans":"No I turned it down","pt":"Não, recusei."},{"words":["expected","Better","than"],"ans":"Better than expected","pt":"Melhor do que o esperado."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"life turn","pos":"word","pt":"virada de vida","ex":"Life turn.","expt":"Virada de vida."},{"w":"big birthday","pos":"word","pt":"aniversário importante","ex":"Big birthday.","expt":"Aniversário importante."},{"w":"job refusal","pos":"word","pt":"recusa de emprego","ex":"Job refusal.","expt":"Recusa de emprego."},{"w":"friend’s help","pos":"word","pt":"ajuda de amigo","ex":"Friend’s help.","expt":"Ajuda de amigo."},{"w":"upside down","pos":"word","pt":"de cabeça para baixo","ex":"Upside down.","expt":"De cabeça para baixo."},{"w":"hard year","pos":"word","pt":"ano difícil","ex":"Hard year.","expt":"Ano difícil."},{"w":"phone-off night","pos":"word","pt":"noite sem celular","ex":"Phone-off night.","expt":"Noite sem celular."},{"w":"honest blog","pos":"word","pt":"blog sincero","ex":"Honest blog.","expt":"Blog sincero."},{"w":"good change","pos":"word","pt":"boa mudança","ex":"Good change.","expt":"Boa mudança."},{"w":"slow progress","pos":"word","pt":"progresso lento","ex":"Slow progress.","expt":"Progresso lento."},{"w":"dark period","pos":"word","pt":"período sombrio","ex":"Dark period.","expt":"Período sombrio."},{"w":"bright side","pos":"word","pt":"lado bom","ex":"Bright side.","expt":"Lado bom."},{"w":"weak moment","pos":"word","pt":"momento fraco","ex":"Weak moment.","expt":"Momento fraco."},{"w":"reaching out","pos":"word","pt":"pedir ajuda","ex":"Reaching out.","expt":"Pedir