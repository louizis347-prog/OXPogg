ão."},{"s":"What ___ you doing tonight? (be)","a":"are","why":"pergunta."}]},{"type":"match","title":"Match the word to its meaning","pairs":[["dentist","dentista"],["checkup","consulta de rotina"],["drill","broca"],["filling","obturação"],["nervous","nervoso"]]},{"type":"order","title":"Put the words in order","items":[{"words":["seeing","the","dentist","I'm"],"ans":"I'm seeing the dentist","pt":"Vou ao dentista."},{"words":["you","going","to","be","nervous","Are"],"ans":"Are you going to be nervous","pt":"Vai ficar nervoso?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"checkup","pos":"word","pt":"consulta de rotina","ex":"A dental checkup.","expt":"Uma consulta de rotina."},{"w":"drill","pos":"word","pt":"broca","ex":"The loud drill.","expt":"A broca barulhenta."},{"w":"showtime","pos":"word","pt":"horário da sessão","ex":"Showtime is eight.","expt":"A sessão é às oito."},{"w":"dumbbell","pos":"word","pt":"dumbbell","ex":"halter","expt":"A heavy dumbbell."},{"w":"gym membership","pos":"word","pt":"gym membership","ex":"mensalidade da academia","expt":"Cancel the gym membership."},{"w":"personal trainer","pos":"word","pt":"personal trainer","ex":"personal trainer","expt":"Hire a personal trainer."},{"w":"carbohydrate","pos":"word","pt":"carbohydrate","ex":"carboidrato","expt":"Slow carbohydrates."},{"w":"mineral","pos":"word","pt":"mineral","ex":"mineral","expt":"A daily mineral."},{"w":"supplement","pos":"word","pt":"supplement","ex":"suplemento","expt":"Take a supplement."},{"w":"hydration","pos":"word","pt":"hydration","ex":"hidratação","expt":"Good hydration."},{"w":"balanced diet","pos":"word","pt":"balanced diet","ex":"dieta equilibrada","expt":"Eat a balanced diet."},{"w":"junk food","pos":"word","pt":"junk food","ex":"comida lixo","expt":"Avoid junk food."},{"w":"portion size","pos":"word","pt":"portion size","ex":"tamanho da porção","expt":"Watch the portion size."},{"w":"overweight","pos":"word","pt":"