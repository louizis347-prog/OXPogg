","doação"]]},{"type":"order","title":"Put the words in order","items":[{"words":["over","2000","A","lot"],"ans":"A lot over 2000","pt":"Muitos: mais de 2.000."},{"words":["books","did","you","receive","How","many"],"ans":"How many books did you receive","pt":"Quantos livros receberam?"}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"plenty","pos":"word","pt":"bastante","ex":"Plenty of room.","expt":"Bastante espaço."},{"w":"cosmetics","pos":"word","pt":"cosmetics","ex":"cosméticos","expt":"A cosmetics store."},{"w":"perfume","pos":"word","pt":"perfume","ex":"perfume","expt":"A strong perfume."},{"w":"sunglasses","pos":"word","pt":"sunglasses","ex":"óculos de sol","expt":"New sunglasses."},{"w":"sandals","pos":"word","pt":"sandals","ex":"sandálias","expt":"Summer sandals."},{"w":"boots","pos":"word","pt":"boots","ex":"botas","expt":"Leather boots."},{"w":"tie","pos":"word","pt":"tie","ex":"gravata","expt":"A silk tie."},{"w":"suit","pos":"word","pt":"suit","ex":"terno","expt":"A grey suit."},{"w":"swimsuit","pos":"word","pt":"swimsuit","ex":"roupa de banho","expt":"A new swimsuit."},{"w":"underwear","pos":"word","pt":"underwear","ex":"roupa íntima","expt":"Cotton underwear."},{"w":"toy","pos":"word","pt":"toy","ex":"brinquedo","expt":"A wooden toy."},{"w":"electronics","pos":"word","pt":"electronics","ex":"eletrônicos","expt":"An electronics store."},{"w":"printer ink","pos":"word","pt":"printer ink","ex":"tinta de impressora","expt":"Buy printer ink."},{"w":"stationery","pos":"word","pt":"stationery","ex":"papelaria","expt":"A stationery shop."},{"w":"furniture store","pos":"word","pt":"furniture store","ex":"loja de móveis","expt":"A furniture store."},{"w":"auction","pos":"word","pt":"auction","ex":"leilão","expt":"An online auction."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**How many books did you receive?** — Quantos livros receberam?","**A lot: over 2,000.** — Muitos: mais de 2.000.","**And how much money do you have?** — E quanto dinheiro vocês têm?","**Speak up, please.** — Fale mais alto, por favor.","**You’re breaking up.** — Está cortando.","**The line is bad.** — A linha está ruim.","**I’ll text you.** — Mando uma mensagem."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"allow","pt":"permitir","forms":[["I / you / we / they allow","I allow it."],["he / she / it allows","She allows it."]]}]}]},{"tag":"Escuta e diálogo","title":"Library news","blocks":[{"type":"dialog","title":"Library news","lines":[["Reporter","How many books did you receive?","Quantos livros receberam?"],["Director","A lot: over 2,000.","Muitos: mais de 2.000."],["Reporter","And how much money do you have?","E quanto dinheiro vocês têm?"],["Director","Very little.","Muito pouco."]]},{"type":"pron","title":"Pronúncia: Entonação de perguntas e pedidos educados","items":[{"label":"Entonação de perguntas e pedidos educados","note":"Pratique em voz alta.","words":[]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Report quantities in a news style.","pt":"Relate.","model":"The library received a lot of books."},{"q":"Say what you have plenty of.","pt":"Diga.","model":"I have plenty of time."},{"q":"Say what you have little of.","pt":"Diga.","model":"I have little money."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write a 6-line news report with quantifiers.","model":"The city library received a lot of new books last month. It got many novels and a few dictionaries. Over 500 readers visited. The library has plenty of space. It has little money. A lot of people helped.","checklist":["Usei **quantificadores**","Usei **plenty of**","Notícia clara"],"words":"6 linhas"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “novel” mean?","opts":["dicionário","roma