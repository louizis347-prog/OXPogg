":"order","pos":"word","pt":"ordem","ex":"Word order.","expt":"Ordem das palavras."},{"w":"size","pos":"word","pt":"tamanho","ex":"Its size.","expt":"O tamanho."},{"w":"nice","pos":"word","pt":"legal","ex":"A nice car.","expt":"Um carro legal."},{"w":"big","pos":"word","pt":"grande","ex":"A big house.","expt":"Uma casa grande."},{"w":"small","pos":"word","pt":"pequeno","ex":"A small box.","expt":"Uma caixa pequena."},{"w":"color","pos":"word","pt":"cor","ex":"What color?","expt":"Qual cor?"}]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"box","kind":"tip","t":"Verbos desta aula","body":"Esta aula revisa verbos já vistos dentro das frases do diálogo e dos exercícios. Observe: **be, have, do**."}]},{"tag":"Escuta e diálogo","title":"Describing","blocks":[{"type":"dialog","title":"Describing","lines":[["Ana","What kind of car do you have?","Que tipo de carro?"],["Leo","A small red car.","Um carro pequeno e vermelho."],["Ana","Is it new?","É novo?"],["Leo","Yes, it’s a nice new car.","Sim, é um carro novo e legal."]]},{"type":"pron","title":"Pronúncia: r americano","items":[{"label":"r americano","note":"O r americano: língua curvada para trás, sem tocar o céu da boca.","words":["red","right","run","read","road","rice"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Describe an object.","pt":"Descreva.","model":"I have a small red car."},{"q":"Use be + adjective.","pt":"Diga.","model":"My car is red."},{"q":"Use two adjectives.","pt":"Diga.","model":"It’s a nice big house."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences with adjectives.","model":"I have a small red car. My house is big. She has a nice new phone. The cars are red. It’s a great old book.","checklist":["Usei **adjetivo antes**","Usei **be + adjetivo**","Ordem correta"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","titl