lue","pt":"Pintaram de azul."}]}]},{"tag":"Vocabulário","title":"Words and expressions","blocks":[{"type":"vocab","items":[{"w":"volunteer","pos":"word","pt":"voluntário","ex":"A volunteer.","expt":"Um voluntário."},{"w":"painter","pos":"word","pt":"pintor","ex":"The painter.","expt":"O pintor."},{"w":"last","pos":"word","pt":"durar","ex":"It lasts.","expt":"Dura."},{"w":"brick","pos":"word","pt":"brick","ex":"tijolo","expt":"A red brick."},{"w":"shade","pos":"word","pt":"shade","ex":"tom","expt":"A darker shade."},{"w":"roller","pos":"word","pt":"roller","ex":"rolo de pintura","expt":"A paint roller."},{"w":"mural","pos":"word","pt":"mural","ex":"mural","expt":"A big mural."},{"w":"neat","pos":"word","pt":"neat","ex":"caprichado","expt":"A neat job."},{"w":"fresh coat","pos":"word","pt":"fresh coat","ex":"nova demão","expt":"A fresh coat of paint."},{"w":"bucket","pos":"word","pt":"bucket","ex":"balde","expt":"A paint bucket."},{"w":"wall paint","pos":"word","pt":"wall paint","ex":"tinta de parede","expt":"Wall paint."},{"w":"paint roller","pos":"word","pt":"paint roller","ex":"rolo de pintura","expt":"A paint roller."},{"w":"safe bridge","pos":"word","pt":"safe bridge","ex":"ponte segura","expt":"A safe bridge."},{"w":"blue bridge","pos":"word","pt":"blue bridge","ex":"ponte azul","expt":"A blue bridge."}]},{"type":"box","kind":"culture","t":"Expressões desta aula","body":["**What color is the bridge?** — De que cor é a ponte?","**They painted it blue.** — Pintaram de azul.","**It makes me happy.** — Isso me deixa feliz.","**Do you mind if I…?** — Você se importa se eu…?","**Would it be possible to…?** — Seria possível…?","**I’m afraid I can’t.** — Receio que não possa."]}]},{"tag":"Verbos","title":"Verbs in focus","blocks":[{"type":"verbs","items":[{"v":"shout","pt":"gritar","forms":[["I / you / we / they shout","Don’t shout."],["he / she / it shouts","He shouts loudly."]]}]}]},{"tag":"Escuta e diálogo","title":"Painting day","blocks":[{"type":"dialog","title":"Painting day","lines":[["Ana","What color is the bridge?","De que cor é a ponte?"],["Leo","They painted it blue.","Pintaram de azul."],["Ana","It makes me happy.","Isso me deixa feliz."],["Leo","Me too.","Eu também."]]},{"type":"pron","title":"Pronúncia: sílaba tônica em palavras comuns","items":[{"label":"sílaba tônica em palavras comuns","note":"Em muitas palavras de duas sílabas a primeira é a forte: TAble, WAter, DOCtor.","words":["table","water","doctor","window"]}]}]},{"tag":"Fala","title":"Speaking","blocks":[{"type":"speak","title":"Speaking","prompts":[{"q":"Say: paint it blue.","pt":"Diga.","model":"Paint the door blue."},{"q":"Say what makes you happy.","pt":"Diga.","model":"Music makes me happy."},{"q":"Say what you keep clean.","pt":"Diga.","model":"I keep my room clean."}]}]},{"tag":"Escrita","title":"Writing","blocks":[{"type":"write","task":"Write 5 sentences with object + complement.","model":"They painted the bridge blue. Music makes me happy. I keep my room clean. We call it a happy place. They want it safe.","checklist":["Usei **O + complemento**","Usei **make/keep/call**","Frases claras"],"words":"5 frases"}]},{"tag":"Revisão e exame","title":"Review · Exam strategy · Teacher’s note","blocks":[{"type":"mcq","title":"Check yourself","items":[{"q":"What does “volunteer” mean?","opts":["voluntário","ponte","seguro"],"ans":0,"why":"**volunteer** = voluntário."},{"q":"What does “bridge” mean?","opts":["pintar","ponte","brilhante"],"ans":1,"why":"**bridge** = ponte."},{"q":"What does “paint” mean?","opts":["seguro","pintor","pintar"],"ans":2,"why":"**paint** = pintar."},{"q":"What does “safe” mean?","opts":["seguro","brilhante","lugar"],"ans":0,"why":"**safe** = seguro."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Treine esta habilidade com o formato de tarefas curtas das provas (TOEFL/IELTS).","Leia o enunciado primeiro e procure as palavras-chave."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["