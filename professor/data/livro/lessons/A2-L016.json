te","O que avaliar","Pontos"],"rows":[["Leitura","Quadros 3–4: ideias principais e vocabulário","/ 10"],["Escuta","Quadro 9: entender o diálogo e repetir","/ 10"],["Fala","Quadro 10: frases completas sem pausas longas","/ 10"],["Escrita","Quadro 11: frases corretas com a lista de verificação","/ 10"]],"cap":"Autoavaliação (40 pontos)"},{"type":"box","kind":"look","t":"Critério de conclusão","body":"**28 a 40 pontos:** siga para a próxima unidade. **20 a 27:** repita as aulas em que errou mais. **Menos de 20:** volte à Unidade e refaça os exercícios dos quadros 5 e 6."},{"type":"mcq","title":"Final check","items":[{"q":"What does “traveler” mean?","opts":["partida","terminal","viajante"],"ans":2,"why":"**traveler** = viajante."},{"q":"What does “departure” mean?","opts":["partida","acampamento","reserva"],"ans":0,"why":"**departure** = partida."},{"q":"What does “campsite” mean?","opts":["terminal","acampamento","viajante"],"ans":1,"why":"**campsite** = acampamento."},{"q":"What does “terminal” mean?","opts":["reserva","partida","terminal"],"ans":2,"why":"**terminal** = terminal."},{"q":"What does “reservation” mean?","opts":["reserva","viajante","acampamento"],"ans":0,"why":"**reservation** = reserva."}]},{"type":"box","kind":"exam","t":"Estratégia para as provas","body":["Controle o tempo: 1 minuto por pergunta de múltipla escolha.","Releia as respostas se sobrar tempo: -ed e didn’t são erros comuns."]},{"type":"box","kind":"teach","t":"Nota para o futuro professor","body":["Aplique sem consulta e com tempo.","Grave a parte oral.","Use a lista para autoavaliação."]}]}]}