ad"},{"t":"dict","min":2,"items":["Who do you train with?","Does he work on Sunday?","Yes, he does.","I get up at five thirty."]},{"t":"write","min":3,"prompt":"Escreva 8 perguntas para entrevistar alguém sobre a rotina.","frame":"What time do you ...? Where do you ...? Does your ...?","words":["when","where","why","who","how","what","usually","breakfast"]},{"t":"speak","min":3,"task":"Entrevista: um aluno é jornalista e entrevista outro sobre rotina; depois troquem.","hints":["What time do you get up?","Where do you have lunch?","Who do you train with?","Does he work on Sunday?"]},{"t":"game","min":2,"title":"Jogo rápido","items":[{"q":"where","opts":["por que","café da manhã","Não, não trabalha.","onde"],"ans":3,"say":"where"},{"q":"como","opts":["how","No, he doesn't.","why","usually"],"ans":0},{"q":"breakfast","opts":["Com quem você treina?","o que","café da manhã","como"],"ans":2,"say":"breakfast"},{"q":"A que horas você acorda?","opts":["What time do you get up?","Does he work on Sunday?","No, he doesn't.","Where do you have lunch?"],"ans":0},{"q":"Does he work on Sunday?","opts":["Ele trabalha no domingo?","Não, não trabalha.","quem","onde"],"ans":0,"say":"Does he work on Sunday?"},{"q":"Como você relaxa?","opts":["No, he doesn't.","why","usually","How do you relax?"],"ans":3},{"q":"where","opts":["como","geralmente","onde","Como você relaxa?"],"ans":2,"say":"where"},{"q":"como","opts":["Where do you have lunch?","how","How do you relax?","breakfast"],"ans":1}]},{"t":"culture","min":1,"title":"Do vs. does","text":"Use 'do' com I, you, we, they e 'does' com he, she, it. Depois de does, o verbo volta para a forma base: 'Does he work?', e não 'Does he works?'."},{"t":"recap","min":1,"canDo":["Usar do/does em perguntas","Responder com Yes, I do","Perguntar sobre quando e onde"],"homework":"Entreviste um familiar e escreva as respostas."}]}