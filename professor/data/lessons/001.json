bre a janela?","opts":["Omar","Mia","The boy"],"ans":1},{"q":"O que as pessoas dizem à noite?","opts":["Good night!","Good morning!","Goodbye!"],"ans":0}]},{"t":"vocab","min":2,"words":[{"en":"hello","pt":"olá"},{"en":"hi","pt":"oi"},{"en":"goodbye","pt":"tchau"},{"en":"bye","pt":"tchau (informal)"},{"en":"morning","pt":"manhã"},{"en":"afternoon","pt":"tarde"},{"en":"evening","pt":"noite (início)"},{"en":"night","pt":"noite (dormir)"},{"en":"friend","pt":"amigo(a)"},{"en":"neighbor","pt":"vizinho(a)"}]},{"t":"mcq","min":2,"title":"Escute e escolha","items":[{"q":"Ouça e escolha o significado","say":"hello","opts":["noite (dormir)","amigo(a)","noite (início)","olá"],"ans":3},{"q":"Ouça e escolha o significado","say":"hi","opts":["amigo(a)","noite (início)","tchau (informal)","oi"],"ans":3},{"q":"Ouça e escolha o significado","say":"goodbye","opts":["noite (dormir)","tchau","manhã","tchau (informal)"],"ans":1},{"q":"Ouça e escolha o significado","say":"bye","opts":["oi","tchau (informal)","tchau","noite (dormir)"],"ans":1},{"q":"Ouça e escolha o significado","say":"morning","opts":["tchau","noite (início)","manhã","amigo(a)"],"ans":2},{"q":"Ouça e escolha o significado","say":"afternoon","opts":["manhã","olá","tarde","noite (dormir)"],"ans":2}],"mode":"listen"},{"t":"match","min":2,"pairs":[{"en":"hello","pt":"olá"},{"en":"hi","pt":"oi"},{"en":"goodbye","pt":"tchau"},{"en":"bye","pt":"tchau (informal)"},{"en":"morning","pt":"manhã"},{"en":"afternoon","pt":"tarde"}]},{"t":"dialog","min":2,"lines":[{"who":"Mia","en":"Good morning!","pt":"Bom dia!"},{"who":"Ken","en":"Good morning! Hello!","pt":"Bom dia! Olá!"},{"who":"Mia","en":"How are you?","pt":"Como você está?"},{"who":"Ken","en":"I'm fine, thanks. And you?","pt":"Estou bem, obrigado. E você?"},{"who":"Mia","en":"I'm great! Welcome to Maple Street.","pt":"Estou ótima! Bem-vindo à Maple Street."},{"who":"Ken","en":"Thank you, neighbor!","pt":"Obrigado, vizinha!"},{"who":"Mia","en":"See you later, Ken!","pt":"Até logo