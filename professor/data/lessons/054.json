s.","pt":"Kofi e Mei têm hábitos diferentes, mas concordam que os pequenos contam.","qs":[{"q":"O que Kofi sempre faz?","opts":["Eats chocolate","Skips breakfast","Drinks water"],"ans":2},{"q":"Como Mei vai ao trabalho?","opts":["By bus","Walks","By car"],"ans":1}]},{"t":"vocab","min":2,"words":[{"en":"always","pt":"sempre"},{"en":"usually","pt":"geralmente"},{"en":"often","pt":"frequentemente"},{"en":"sometimes","pt":"às vezes"},{"en":"rarely","pt":"raramente"},{"en":"never","pt":"nunca"},{"en":"every day","pt":"todo dia"},{"en":"once a week","pt":"uma vez por semana"},{"en":"twice","pt":"duas vezes"},{"en":"exercise","pt":"exercício"}]},{"t":"mcq","min":2,"title":"Escute e escolha","items":[{"q":"Ouça e escolha o significado","say":"always","opts":["todo dia","frequentemente","sempre","geralmente"],"ans":2},{"q":"Ouça e escolha o significado","say":"usually","opts":["às vezes","geralmente","uma vez por semana","sempre"],"ans":1},{"q":"Ouça e escolha o significado","say":"often","opts":["todo dia","geralmente","às vezes","frequentemente"],"ans":3},{"q":"Ouça e escolha o significado","say":"sometimes","opts":["às vezes","todo dia","sempre","uma vez por semana"],"ans":0},{"q":"Ouça e escolha o significado","say":"rarely","opts":["raramente","uma vez por semana","geralmente","frequentemente"],"ans":0},{"q":"Ouça e escolha o significado","say":"never","opts":["frequentemente","duas vezes","uma vez por semana","nunca"],"ans":3}],"mode":"listen"},{"t":"match","min":2,"pairs":[{"en":"always","pt":"sempre"},{"en":"usually","pt":"geralmente"},{"en":"often","pt":"frequentemente"},{"en":"sometimes","pt":"às vezes"},{"en":"rarely","pt":"raramente"},{"en":"never","pt":"nunca"}]},{"t":"dialog","min":2,"lines":[{"who":"Mei","en":"How often do you exercise, Kofi?","pt":"Com que frequência você se exercita, Kofi?"},{"who":"Kofi","en":"I usually exercise three times a week.","pt":"Geralmente me exercito três vezes por semana."},{"who":"Mei","en":"I rarely exercise. I'm always busy."