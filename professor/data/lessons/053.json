 e a internet.","qs":[{"q":"Onde Max ensina?","opts":["At the library","At home","At school"],"ans":0},{"q":"O que Jin mostra?","opts":["A game","A photo","A song"],"ans":1}]},{"t":"vocab","min":2,"words":[{"en":"app","pt":"aplicativo"},{"en":"website","pt":"site"},{"en":"search","pt":"pesquisar"},{"en":"click","pt":"clicar"},{"en":"download","pt":"baixar"},{"en":"password","pt":"senha"},{"en":"screen","pt":"tela"},{"en":"online","pt":"online"},{"en":"link","pt":"link"},{"en":"connect","pt":"conectar"}]},{"t":"mcq","min":2,"title":"Escute e escolha","items":[{"q":"Ouça e escolha o significado","say":"app","opts":["aplicativo","site","online","pesquisar"],"ans":0},{"q":"Ouça e escolha o significado","say":"website","opts":["senha","site","link","baixar"],"ans":1},{"q":"Ouça e escolha o significado","say":"search","opts":["pesquisar","senha","link","online"],"ans":0},{"q":"Ouça e escolha o significado","say":"click","opts":["clicar","site","online","aplicativo"],"ans":0},{"q":"Ouça e escolha o significado","say":"download","opts":["baixar","link","online","site"],"ans":0},{"q":"Ouça e escolha o significado","say":"password","opts":["tela","site","link","senha"],"ans":3}],"mode":"listen"},{"t":"match","min":2,"pairs":[{"en":"app","pt":"aplicativo"},{"en":"website","pt":"site"},{"en":"search","pt":"pesquisar"},{"en":"click","pt":"clicar"},{"en":"download","pt":"baixar"},{"en":"password","pt":"senha"}]},{"t":"dialog","min":2,"lines":[{"who":"Jin","en":"Max, can you help me with this app?","pt":"Max, pode me ajudar com este app?"},{"who":"Max","en":"Sure. First, open the app.","pt":"Claro. Primeiro, abra o app."},{"who":"Jin","en":"OK. It's loading.","pt":"Ok. Está carregando."},{"who":"Max","en":"Now click here and search for your name.","pt":"Agora clique aqui e procure seu nome."},{"who":"Jin","en":"I forgot my password!","pt":"Esqueci a senha!"},{"who":"Max","en":"Don't worry. Click 'Forgot password'.","pt":"Sem problemas. Clique em 'Esqueci a senha'."},{"who":"Jin","