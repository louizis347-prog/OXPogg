 of Friday.","pt":"A pizza chega no horário combinado e Pablo dá gorjeta.","qs":[{"q":"Que horas a pizza chega?","opts":["Seven","Seven thirty","Eight"],"ans":1},{"q":"O que Pablo dá ao entregador?","opts":["A coffee","A tip","A pizza"],"ans":1}]},{"t":"vocab","min":2,"words":[{"en":"order","pt":"pedido"},{"en":"delivery","pt":"entrega"},{"en":"address","pt":"endereço"},{"en":"pizza","pt":"pizza"},{"en":"topping","pt":"cobertura"},{"en":"extra","pt":"extra"},{"en":"minute","pt":"minuto"},{"en":"cash","pt":"dinheiro"},{"en":"card","pt":"cartão"},{"en":"receipt","pt":"recibo"}]},{"t":"mcq","min":2,"title":"Escute e escolha","items":[{"q":"Ouça e escolha o significado","say":"order","opts":["cartão","pedido","endereço","dinheiro"],"ans":1},{"q":"Ouça e escolha o significado","say":"delivery","opts":["minuto","entrega","extra","pedido"],"ans":1},{"q":"Ouça e escolha o significado","say":"address","opts":["cartão","pizza","endereço","extra"],"ans":2},{"q":"Ouça e escolha o significado","say":"pizza","opts":["pizza","dinheiro","entrega","pedido"],"ans":0},{"q":"Ouça e escolha o significado","say":"topping","opts":["minuto","entrega","cobertura","cartão"],"ans":2},{"q":"Ouça e escolha o significado","say":"extra","opts":["recibo","extra","pedido","pizza"],"ans":1}],"mode":"listen"},{"t":"match","min":2,"pairs":[{"en":"order","pt":"pedido"},{"en":"delivery","pt":"entrega"},{"en":"address","pt":"endereço"},{"en":"pizza","pt":"pizza"},{"en":"topping","pt":"cobertura"},{"en":"extra","pt":"extra"}]},{"t":"dialog","min":2,"lines":[{"who":"Suri","en":"Maple Pizza, how can I help?","pt":"Maple Pizza, em que posso ajudar?"},{"who":"Pablo","en":"I'd like to order a large pizza.","pt":"Gostaria de pedir uma pizza grande."},{"who":"Suri","en":"What toppings?","pt":"Que coberturas?"},{"who":"Pablo","en":"Mushrooms and extra cheese, please.","pt":"Cogumelos e queijo extra, por favor."},{"who":"Suri","en":"What's your address?","pt":"Qual é seu endereço?"},{"who":"Pablo","en":"12 Maple S